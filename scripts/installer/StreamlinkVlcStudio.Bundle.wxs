<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
    Name="Streamlink VLC Studio"
    Manufacturer="Streamlink VLC Studio"
    Version="$(var.BundleVersion)"
    UpgradeCode="B1A4CC92-5E23-4F5E-9D67-1A4EE6F57C18"
    IconSourceFile="$(var.AppIcon)"
    AboutUrl="https://github.com/CorontoSiete/streamlink-vlc-studio"
    Compressed="yes"
    Condition="VersionNT64 &gt;= v10.0">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        LicenseUrl=""
        ShowVersion="yes"
        SuppressOptionsUI="yes"
        LaunchTarget="[ProgramFiles64Folder]Streamlink VLC Studio\StreamlinkVlcStudio.exe"
        LaunchArguments="--setup"
        LaunchWorkingFolder="[ProgramFiles64Folder]Streamlink VLC Studio" />
    </BootstrapperApplication>

    <util:RegistrySearch
      Id="StreamlinkMachine64VersionSearch"
      Variable="StreamlinkMachine64Version"
      Root="HKLM"
      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Streamlink"
      Value="DisplayVersion"
      Result="value"
      Bitness="always64" />
    <util:RegistrySearch
      Id="StreamlinkMachine32VersionSearch"
      Variable="StreamlinkMachine32Version"
      Root="HKLM"
      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Streamlink"
      Value="DisplayVersion"
      Result="value"
      Bitness="always32" />
    <util:RegistrySearch
      Id="StreamlinkUserVersionSearch"
      Variable="StreamlinkUserVersion"
      Root="HKCU"
      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Streamlink"
      Value="DisplayVersion"
      Result="value" />

    <Chain>
      <ExePackage
        Id="Streamlink"
        DisplayName="Streamlink (x64)"
        SourceFile="$(var.StreamlinkInstaller)"
        InstallArguments="/S"
        PerMachine="yes"
        Permanent="yes"
        DetectCondition="(StreamlinkMachine64Version AND StreamlinkMachine64Version &gt;= v$(var.StreamlinkMinimumVersion)) OR (StreamlinkMachine32Version AND StreamlinkMachine32Version &gt;= v$(var.StreamlinkMinimumVersion)) OR (StreamlinkUserVersion AND StreamlinkUserVersion &gt;= v$(var.StreamlinkMinimumVersion))" />
      <MsiPackage
        Id="Vlc"
        DisplayName="VLC media player (64-bit)"
        SourceFile="$(var.VlcMsi)"
        ForcePerMachine="yes"
        Permanent="yes" />
      <MsiPackage
        Id="StreamlinkVlcStudio"
        DisplayName="Streamlink VLC Studio"
        SourceFile="$(var.AppMsi)"
        ForcePerMachine="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[ProgramFiles64Folder]Streamlink VLC Studio" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>

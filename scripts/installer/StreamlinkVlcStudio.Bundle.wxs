<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
    Name="Stream Studio"
    Manufacturer="Stream Studio"
    Version="$(var.BundleVersion)"
    UpgradeCode="B1A4CC92-5E23-4F5E-9D67-1A4EE6F57C18"
    IconSourceFile="$(var.AppIcon)"
    AboutUrl="https://github.com/CorontoSiete/streamlink-vlc-studio"
    Compressed="yes"
    DisableModify="no"
    bal:CommandLineVariables="caseInsensitive"
    Condition="VersionNT64 &gt;= v10.0">
    <Variable
      Name="StreamlinkDependencyVersion"
      Type="string"
      Value="$(var.StreamlinkMinimumVersion)" />
    <Variable
      Name="VlcDependencyVersion"
      Type="string"
      Value="$(var.VlcVersion)" />
    <Variable
      Name="InstalledApplicationPath"
      Type="formatted"
      Value="[ProgramFiles64Folder]Streamlink VLC Studio\StreamlinkVlcStudio.exe" />
    <Variable
      Name="StreamlinkMachineExecutable"
      Type="formatted"
      Value="[ProgramFiles64Folder]Streamlink\bin\streamlink.exe" />
    <Variable
      Name="StreamlinkMachineVersion"
      Type="version"
      Value="0.0.0.0" />
    <Variable
      Name="VlcInstallDirectory"
      Type="formatted"
      Value="[ProgramFiles64Folder]VideoLAN\VLC" />
    <Variable
      Name="VlcInstalledVersion"
      Type="version"
      Value="0.0.0.0" />
    <Variable
      Name="PurgeUserData"
      Type="numeric"
      Value="1"
      bal:Overridable="yes" />

    <BootstrapperApplication
      SourceFile="$(var.BootstrapperApplicationDir)\StreamStudio.Bootstrapper.exe">
      <PayloadGroupRef Id="ManagedBootstrapperApplicationPayloads" />
    </BootstrapperApplication>

    <util:RegistrySearch
      Id="VlcInstallDirectorySearch"
      Variable="VlcInstallDirectory"
      Root="HKLM"
      Key="SOFTWARE\VideoLAN\VLC"
      Value="InstallDir"
      Result="value"
      Bitness="always64" />
    <!-- Some VLC installers register InstallDir without a Version value. Read
         the actual playback runtime, with Program Files as the default location. -->
    <util:FileSearch
      Id="VlcInstalledVersionSearch"
      Variable="VlcInstalledVersion"
      Path="[VlcInstallDirectory]\libvlc.dll"
      Result="version"
      After="VlcInstallDirectorySearch" />

    <Chain>
      <ExePackage
        Id="Streamlink"
        DisplayName="Streamlink (x64)"
        SourceFile="$(var.StreamlinkInstaller)"
        InstallArguments="/AllUsers /S"
        PerMachine="yes"
        Permanent="yes"
        DetectCondition="StreamlinkMachineVersion &gt;= v$(var.StreamlinkMinimumVersion)" />
      <ExePackage
        Id="Vlc"
        DisplayName="VLC media player (64-bit)"
        SourceFile="$(var.VlcInstaller)"
        InstallArguments="/L=1033 /S"
        PerMachine="yes"
        Permanent="yes"
        DetectCondition="VlcInstalledVersion &gt;= v$(var.VlcVersion)"
        InstallCondition="VlcInstalledVersion &lt; v$(var.VlcVersion)" />
      <MsiPackage
        Id="StreamStudio"
        DisplayName="Stream Studio"
        SourceFile="$(var.AppMsi)"
        ForcePerMachine="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[ProgramFiles64Folder]Streamlink VLC Studio" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>

<Window x:Class="StreamlinkVlcStudio.Bootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Studio Setup"
        Width="720"
        Height="590"
        MinWidth="680"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#111318"
        Foreground="#F7F7FA"
        Icon="Assets/Twitch.ico"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#313640" />
            <Setter Property="BorderBrush" Value="#515966" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7354D8" />
            <Setter Property="BorderBrush" Value="#9478F0" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#6E2830" />
            <Setter Property="BorderBrush" Value="#A84854" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="#BFAEFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1E25" />
            <Setter Property="BorderBrush" Value="#303641" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B4BBC7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#181B21" BorderBrush="#303641" BorderThickness="0,0,0,1" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="38" Height="38" Source="Assets/Twitch.ico" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Stream Studio" />
                    <TextBlock Foreground="#A9B0BC" Text="Per-machine setup" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#A9B0BC">
                    <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,18">
            <Grid Visibility="{Binding IsLoadingPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <ProgressBar Height="5" IsIndeterminate="True" Foreground="#8B6DE9" />
                    <TextBlock Margin="0,22,0,0" FontSize="18" TextAlignment="Center" Text="{Binding StatusText}" />
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsInstallPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Install Stream Studio" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Setup installs the application for everyone on this PC under Program Files. Compatible VLC and Streamlink installations are kept and never downgraded." />
                </StackPanel>
                <Border Grid.Row="1" Margin="0,22,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Components" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"><Run Text="Streamlink "/><Run Text="{Binding StreamlinkVersion, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedText}" Text="Command-line streaming runtime" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="18,0,0,0" Foreground="#BFAEFF" Text="{Binding StreamlinkStatus}" />
                        </Grid>
                        <Separator Margin="0,13" Background="#303641" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"><Run Text="VLC media player "/><Run Text="{Binding VlcVersion, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedText}" Text="64-bit media playback runtime" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="18,0,0,0" Foreground="#BFAEFF" Text="{Binding VlcStatus}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Top" Style="{StaticResource MutedText}"
                           Text="Windows may display an Unknown publisher warning until an Authenticode certificate is configured for releases." />
            </Grid>

            <Grid Visibility="{Binding IsMaintenancePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Modify or repair" />
                    <TextBlock Style="{StaticResource MutedText}" Text="Stream Studio is installed for everyone on this PC." />
                </StackPanel>
                <Border Grid.Row="1" Margin="0,22,0,0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Repair installation" />
                            <TextBlock Margin="0,5,20,0" Style="{StaticResource MutedText}" Text="Verify and restore the installed application files." />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RepairCommand}" Content="Repair" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}" BorderBrush="#5A343A">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Uninstall application" />
                                <TextBlock Margin="0,5,20,0" Style="{StaticResource MutedText}"
                                           Text="VLC and Streamlink are always retained." />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Command="{Binding UninstallCommand}" Content="Uninstall" />
                        </Grid>
                        <CheckBox Grid.Row="1" Margin="0,18,0,0" IsChecked="{Binding PurgeUserData}"
                                  Foreground="#F7F7FA" VerticalContentAlignment="Center"
                                  Content="Remove my Stream Studio settings, cache, and temporary data" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsProgressPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" TextAlignment="Center" Text="{Binding OperationTitle}" />
                    <TextBlock Margin="0,2,0,25" Foreground="#B4BBC7" TextAlignment="Center" Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <ProgressBar Height="12" Minimum="0" Maximum="100" Value="{Binding Progress}" Foreground="#8B6DE9" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Right" Foreground="#B4BBC7">
                        <Run Text="{Binding Progress}" /><Run Text="%" />
                    </TextBlock>
                    <TextBlock Margin="0,26,0,0" Foreground="#A9B0BC" TextAlignment="Center"
                               Text="Please keep this window open while setup is working." />
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsResultPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="540">
                    <Border Width="62" Height="62" CornerRadius="31" Background="#74303A" Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#74303A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultSucceeded}" Value="True">
                                        <Setter Property="Background" Value="#2E684E" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultWarning}" Value="True">
                                        <Setter Property="Background" Value="#82652E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="!" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultSucceeded}" Value="True">
                                            <Setter Property="Text" Value="✓" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Style="{StaticResource PageTitle}" TextAlignment="Center" Text="{Binding ResultTitle}" />
                    <TextBlock Margin="0,4,0,18" Foreground="#B4BBC7" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding ResultMessage}" />
                    <Button Style="{StaticResource LinkButton}" Command="{Binding OpenLogCommand}" Content="Open setup log" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#181B21" BorderBrush="#303641" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Visibility="{Binding IsInstallPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" Content="Install" />
                    <Button Visibility="{Binding IsProgressPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding CancelCommand}" Content="Cancel" />
                    <Button Visibility="{Binding CanLaunch, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" Content="Launch application" />
                    <Button Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}" Content="Try again" />
                    <Button Visibility="{Binding IsResultPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding CloseCommand}" Content="Close" />
                    <Button Visibility="{Binding IsMaintenancePage, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding CloseCommand}" Content="Close" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

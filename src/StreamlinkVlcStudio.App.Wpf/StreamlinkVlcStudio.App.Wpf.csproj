<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StreamlinkVlcStudio.Core\StreamlinkVlcStudio.Core.csproj" />
    <ProjectReference Include="..\StreamlinkVlcStudio.Infrastructure\StreamlinkVlcStudio.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- global.json pins the servicing SDK whose latest runtime pack is verified as 10.0.10 in CI. -->
    <TargetLatestRuntimePatch Condition="'$(SelfContained)' == 'true'">true</TargetLatestRuntimePatch>
    <SupportedOSPlatformVersion>10.0.10240.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Keep the SDK's ILLink tool dependency identical for builds and single-file publishes. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\Twitch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StreamStudio</AssemblyName>
    <AssemblyTitle>Stream Studio</AssemblyTitle>
    <Product>Stream Studio</Product>
    <Description>Stream Studio desktop app</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Twitch\ClaimChannelPoints.js" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Twitch.ico" />
    <None Remove="Assets\TwitchBadges\**\*.*" />
    <None Remove="Assets\KickBadges\**\*.*" />
    <Resource Include="Assets\Twitch.ico" />
    <Resource Include="Assets\TwitchBadges\**\*.*" />
    <Resource Include="Assets\KickBadges\**\*.*" />
  </ItemGroup>

  <Target Name="RemovePublishSymbolsForSingleFile" BeforeTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>

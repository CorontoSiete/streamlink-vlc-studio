<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shell primitives use the active palette, including when it changes at runtime. -->
    <Style x:Key="StudioEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="StudioPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StudioLibraryTitle" TargetType="TextBlock" BasedOn="{StaticResource StudioPageTitle}">
        <Setter Property="FontSize" Value="28" />
    </Style>
    <Style x:Key="StudioPageSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StudioStatusPill" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="StudioBrandMarkStyle" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource StudioAccentBrush}" />
        <Setter Property="Data">
            <Setter.Value>
                <GeometryGroup>
                    <RectangleGeometry Rect="0,6,4,12" RadiusX="1.5" RadiusY="1.5" />
                    <RectangleGeometry Rect="7,0,4,24" RadiusX="1.5" RadiusY="1.5" />
                    <RectangleGeometry Rect="14,4,4,16" RadiusX="1.5" RadiusY="1.5" />
                </GeometryGroup>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StudioEmptyStateGlyph" TargetType="Border">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
    </Style>
    <Style x:Key="StudioCardPlayAffordance" TargetType="Border">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Background" Value="#E5171B20" />
        <Setter Property="BorderBrush" Value="#50FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                    <Condition Binding="{Binding DataContext.Settings.EnableStreamHoverPreviews, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Opacity" Value="1" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StudioQuietIconButton" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="StudioRailButton" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisualStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RailChrome" Background="{TemplateBinding Background}" CornerRadius="9">
                        <Grid>
                            <Border x:Name="RailHover" Background="{DynamicResource StudioTextBrush}" CornerRadius="9" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="RailIndicator" Width="2" Height="18" CornerRadius="1" HorizontalAlignment="Left"
                                    Background="{TemplateBinding BorderBrush}" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource StudioLineIcon}" Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <Border x:Name="RailBadge" Grid.Column="2" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" MinWidth="22"
                                        Background="{DynamicResource StudioSurface0Brush}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="RailBadgeText" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Following" />
                                <Condition Binding="{Binding HasLiveFollowedChannels}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RailBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RailBadgeText" Property="Text" Value="{Binding LiveFollowedChannels.Count}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Downloads" />
                                <Condition Binding="{Binding HasVodDownloads}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RailBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RailBadgeText" Property="Text" Value="{Binding VodDownloads.Count}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RailHover" Property="Opacity" Value="0.05" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RailHover" Property="Opacity" Value="0.09" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StudioRailLive" TargetType="Button" BasedOn="{StaticResource StudioRailButton}">
        <Setter Property="Tag" Value="{StaticResource StudioIconLive}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFollowedHomePageSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StudioRailBrowse" TargetType="Button" BasedOn="{StaticResource StudioRailButton}">
        <Setter Property="Tag" Value="{StaticResource StudioIconDiscover}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBrowseHomePageSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StudioRailVods" TargetType="Button" BasedOn="{StaticResource StudioRailButton}">
        <Setter Property="Tag" Value="{StaticResource StudioIconBroadcasts}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsTwitchVodsHomePageSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StudioRailDownloads" TargetType="Button" BasedOn="{StaticResource StudioRailButton}">
        <Setter Property="Tag" Value="{StaticResource StudioIconDownload}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDownloadsHomePageSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StudioRailRecent" TargetType="Button" BasedOn="{StaticResource StudioRailButton}">
        <Setter Property="Tag" Value="{StaticResource StudioIconRecent}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRecentHomePageSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StudioSettingsNavigation" TargetType="Button" BasedOn="{StaticResource StudioRailButton}">
        <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
        <Setter Property="Height" Value="44" />
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nord Theme Colors -->

    <!-- Surfaces -->
    <Color x:Key="StudioBaseColor">#242933</Color>
    <Color x:Key="StudioSurface0Color">#2E3440</Color>
    <Color x:Key="StudioSurface1Color">#3B4252</Color>
    <Color x:Key="StudioSurface2Color">#434C5E</Color>
    <Color x:Key="StudioSurface3Color">#4C566A</Color>
    <Color x:Key="StudioSurfaceCardColor">#2A3040</Color>
    <Color x:Key="StudioSurfaceHoverColor">#3E4860</Color>

    <!-- Borders -->
    <Color x:Key="StudioBorderColor">#4C566A</Color>
    <Color x:Key="StudioBorderStrongColor">#5E6B82</Color>

    <!-- Accent (Frost Blue) -->
    <Color x:Key="StudioAccentColor">#88C0D0</Color>
    <Color x:Key="StudioAccentHoverColor">#8FBCBB</Color>
    <Color x:Key="StudioAccentPressedColor">#5E81AC</Color>
    <Color x:Key="StudioFocusColor">#88C0D0</Color>
    <Color x:Key="StudioAccentTextColor">#A3D5E0</Color>

    <!-- Text -->
    <Color x:Key="StudioTextColor">#ECEFF4</Color>
    <Color x:Key="StudioTextSecondaryColor">#D8DEE9</Color>
    <Color x:Key="StudioTextMutedColor">#7B88A1</Color>
    <Color x:Key="StudioTextPlaceholderColor">#6B7890</Color>
    <Color x:Key="StudioTextDimColor">#5B6880</Color>

    <!-- UI Elements -->
    <Color x:Key="StudioScrollbarColor">#5E6B82</Color>
    <Color x:Key="StudioDisabledColor">#2E3440</Color>
    <Color x:Key="StudioDisabledBorderColor">#3B4252</Color>

    <!-- Semantic: Success / Live -->
    <Color x:Key="StudioSuccessColor">#A3BE8C</Color>
    <Color x:Key="StudioSuccessSubtleColor">#222E1E</Color>
    <Color x:Key="StudioSuccessBorderColor">#A3BE8C</Color>
    <Color x:Key="StudioSuccessTextColor">#D8EACC</Color>

    <!-- Semantic: Danger -->
    <Color x:Key="StudioDangerColor">#BF616A</Color>
    <Color x:Key="StudioDangerSubtleColor">#2E1E20</Color>

    <!-- Semantic: Warning -->
    <Color x:Key="StudioWarningColor">#EBCB8B</Color>

    <!-- Semantic: Info -->
    <Color x:Key="StudioInfoColor">#81A1C1</Color>
    <Color x:Key="StudioInfoSubtleColor">#1E2836</Color>

    <!-- Platform: Twitch -->
    <Color x:Key="StudioTwitchColor">#9146FF</Color>
    <Color x:Key="StudioTwitchSubtleColor">#2A1E45</Color>
    <Color x:Key="StudioTwitchTextColor">#E0D0FF</Color>

    <!-- Platform: Kick -->
    <Color x:Key="StudioKickColor">#53FC18</Color>
    <Color x:Key="StudioKickSubtleColor">#152A10</Color>
    <Color x:Key="StudioKickTextColor">#CCFFC0</Color>

    <!-- Category Badge -->
    <Color x:Key="StudioCategoryBgColor">#2A2820</Color>
    <Color x:Key="StudioCategoryBorderColor">#8A7B5A</Color>
    <Color x:Key="StudioCategoryTextColor">#EBCB8B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="StudioBaseBrush" Color="{StaticResource StudioBaseColor}" />
    <SolidColorBrush x:Key="StudioSurface0Brush" Color="{StaticResource StudioSurface0Color}" />
    <SolidColorBrush x:Key="StudioSurface1Brush" Color="{StaticResource StudioSurface1Color}" />
    <SolidColorBrush x:Key="StudioSurface2Brush" Color="{StaticResource StudioSurface2Color}" />
    <SolidColorBrush x:Key="StudioSurface3Brush" Color="{StaticResource StudioSurface3Color}" />
    <SolidColorBrush x:Key="StudioSurfaceCardBrush" Color="{StaticResource StudioSurfaceCardColor}" />
    <SolidColorBrush x:Key="StudioSurfaceHoverBrush" Color="{StaticResource StudioSurfaceHoverColor}" />
    <SolidColorBrush x:Key="StudioBorderBrush" Color="{StaticResource StudioBorderColor}" />
    <SolidColorBrush x:Key="StudioBorderStrongBrush" Color="{StaticResource StudioBorderStrongColor}" />
    <SolidColorBrush x:Key="StudioAccentBrush" Color="{StaticResource StudioAccentColor}" />
    <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="{StaticResource StudioAccentHoverColor}" />
    <SolidColorBrush x:Key="StudioAccentPressedBrush" Color="{StaticResource StudioAccentPressedColor}" />
    <SolidColorBrush x:Key="StudioFocusBrush" Color="{StaticResource StudioFocusColor}" />
    <SolidColorBrush x:Key="StudioAccentTextBrush" Color="{StaticResource StudioAccentTextColor}" />
    <SolidColorBrush x:Key="StudioTextBrush" Color="{StaticResource StudioTextColor}" />
    <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="{StaticResource StudioTextSecondaryColor}" />
    <SolidColorBrush x:Key="StudioTextMutedBrush" Color="{StaticResource StudioTextMutedColor}" />
    <SolidColorBrush x:Key="StudioTextPlaceholderBrush" Color="{StaticResource StudioTextPlaceholderColor}" />
    <SolidColorBrush x:Key="StudioTextDimBrush" Color="{StaticResource StudioTextDimColor}" />
    <SolidColorBrush x:Key="StudioScrollbarBrush" Color="{StaticResource StudioScrollbarColor}" />
    <SolidColorBrush x:Key="StudioDisabledBrush" Color="{StaticResource StudioDisabledColor}" />
    <SolidColorBrush x:Key="StudioDisabledBorderBrush" Color="{StaticResource StudioDisabledBorderColor}" />
    <SolidColorBrush x:Key="StudioSuccessBrush" Color="{StaticResource StudioSuccessColor}" />
    <SolidColorBrush x:Key="StudioSuccessSubtleBrush" Color="{StaticResource StudioSuccessSubtleColor}" />
    <SolidColorBrush x:Key="StudioSuccessBorderBrush" Color="{StaticResource StudioSuccessBorderColor}" />
    <SolidColorBrush x:Key="StudioSuccessTextBrush" Color="{StaticResource StudioSuccessTextColor}" />
    <SolidColorBrush x:Key="StudioDangerBrush" Color="{StaticResource StudioDangerColor}" />
    <SolidColorBrush x:Key="StudioDangerSubtleBrush" Color="{StaticResource StudioDangerSubtleColor}" />
    <SolidColorBrush x:Key="StudioWarningBrush" Color="{StaticResource StudioWarningColor}" />
    <SolidColorBrush x:Key="StudioInfoBrush" Color="{StaticResource StudioInfoColor}" />
    <SolidColorBrush x:Key="StudioInfoSubtleBrush" Color="{StaticResource StudioInfoSubtleColor}" />
    <SolidColorBrush x:Key="StudioTwitchBrush" Color="{StaticResource StudioTwitchColor}" />
    <SolidColorBrush x:Key="StudioTwitchSubtleBrush" Color="{StaticResource StudioTwitchSubtleColor}" />
    <SolidColorBrush x:Key="StudioTwitchTextBrush" Color="{StaticResource StudioTwitchTextColor}" />
    <SolidColorBrush x:Key="StudioKickBrush" Color="{StaticResource StudioKickColor}" />
    <SolidColorBrush x:Key="StudioKickSubtleBrush" Color="{StaticResource StudioKickSubtleColor}" />
    <SolidColorBrush x:Key="StudioKickTextBrush" Color="{StaticResource StudioKickTextColor}" />
    <SolidColorBrush x:Key="StudioCategoryBgBrush" Color="{StaticResource StudioCategoryBgColor}" />
    <SolidColorBrush x:Key="StudioCategoryBorderBrush" Color="{StaticResource StudioCategoryBorderColor}" />
    <SolidColorBrush x:Key="StudioCategoryTextBrush" Color="{StaticResource StudioCategoryTextColor}" />
</ResourceDictionary>

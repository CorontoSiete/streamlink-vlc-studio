<Window x:Class="StreamlinkVlcStudio.App.Wpf.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Studio setup"
        Width="980"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource StudioBaseBrush}"
        Foreground="{DynamicResource StudioTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="SetupWizardWindowLoaded"
        Closing="SetupWizardWindowClosing"
        Closed="SetupWizardWindowClosed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/StudioTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource StudioBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource StudioSurface0Brush}" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,1,0" Padding="20,32,20,24">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Public streams work without an account. You can connect later in Settings."
                           Foreground="{DynamicResource StudioTextMutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="8,24,8,0" />
                <StackPanel>
                    <TextBlock Text="Stream Studio" FontSize="19" FontWeight="SemiBold" Margin="8,0,0,7" />
                    <TextBlock Text="LET'S GET YOU SET UP" Foreground="{DynamicResource StudioTextMutedBrush}" FontSize="9" FontWeight="SemiBold" Margin="8,0,0,32" />
                    <Border Padding="12,15" Margin="0,0,0,8" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWelcomeVisible}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="01" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Welcome" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,15" Margin="0,0,0,8" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTwitchVisible}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="02" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Connect Twitch" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,15" Margin="0,0,0,8" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKickVisible}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="03" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Connect Kick" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,15" Margin="0,0,0,8" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleteVisible}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioAccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="04" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ready to watch" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Make yourself at home."
                           Style="{StaticResource StudioSectionTitleStyle}"
                           FontSize="30" />
                <TextBlock Text="Connect your platforms. Bring your favorite streams together."
                           Foreground="{DynamicResource StudioTextMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1"
                    Margin="18,0,0,0"
                    Padding="12,8"
                    Background="{DynamicResource StudioSurface1Brush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding ProgressText}"
                           Foreground="{DynamicResource StudioAccentTextBrush}"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource StudioCardStyle}"
                Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Your studio starts here"
                                   Style="{StaticResource StudioSectionTitleStyle}" />
                        <TextBlock Text="The full installer installs the app, Streamlink, and VLC. This last screen connects the accounts you want to use in the app. Public stream playback does not require an account, and either platform can be skipped."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                   Margin="0,0,0,20" />

                        <Border Style="{StaticResource StudioEmptyStateStyle}"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="What you will do"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <TextBlock Text="1. Create or choose a Twitch/Kick developer app." Margin="0,0,0,8" />
                                <TextBlock Text="2. Enter the required app credentials here and use the platform's browser authorization." Margin="0,0,0,8" />
                                <TextBlock Text="3. The app validates and saves the resulting account connection locally." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="You will never enter your platform password in this window. The browser handles sign-in and consent."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioSuccessTextBrush}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsTwitchVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Connect Twitch"
                                   Style="{StaticResource StudioSectionTitleStyle}" />
                        <TextBlock Text="Twitch requires a Client ID for this desktop OAuth flow. Create the app once, then the Connect button opens Twitch and saves the validated user token for chat, follows, VODs, and predictions."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                   Margin="0,0,0,16" />

                        <Border Background="{DynamicResource StudioTwitchSubtleBrush}"
                                BorderBrush="{DynamicResource StudioTwitchBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Before connecting"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StudioTwitchTextBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Open the Twitch Developer Console, create an application, and set its OAuth Redirect URL to exactly:"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource StudioTwitchTextBrush}" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Content="Copy"
                                            Tag="http://localhost:39178"
                                            Click="CopyRedirectButtonClick"
                                            MinWidth="72"
                                            Margin="8,0,0,0" />
                                    <TextBox Text="http://localhost:39178"
                                             IsReadOnly="True"
                                             ToolTip="This value must match the Twitch developer app exactly." />
                                </DockPanel>
                                <Button Content="Open Twitch Developer Console"
                                        Tag="https://dev.twitch.tv/console/apps"
                                        Click="OpenUrlButtonClick"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Client ID" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding Settings.Chat.TwitchClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"
                                 ToolTip="Paste the Client ID from your Twitch developer app." />
                        <TextBlock Text="The app requests these scopes: chat:read, chat:edit, user:read:follows, channel:manage:predictions, clips:edit."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{Binding TwitchAccountStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioSuccessTextBrush}"
                                   Margin="0,0,0,12" />
                        <Button Content="Connect Twitch"
                                Click="ConnectTwitchButtonClick"
                                IsEnabled="{Binding CanConnectTwitch}"
                                Style="{StaticResource StudioPrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                MinWidth="140" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsKickVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Connect Kick"
                                   Style="{StaticResource StudioSectionTitleStyle}" />
                        <TextBlock Text="Kick uses OAuth 2.1 with PKCE. Create a Kick developer app, enter its Client ID and Client Secret, then authorize in the browser. The refresh token is saved so the app can refresh access when needed."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                   Margin="0,0,0,16" />

                        <Border Background="{DynamicResource StudioKickSubtleBrush}"
                                BorderBrush="{DynamicResource StudioKickBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Before connecting"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StudioKickTextBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Open Kick Account Settings &gt; Developer, create an app, and set its redirect URL to exactly:"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource StudioKickTextBrush}" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Content="Copy"
                                            Tag="http://localhost:39177"
                                            Click="CopyRedirectButtonClick"
                                            MinWidth="72"
                                            Margin="8,0,0,0" />
                                    <TextBox Text="http://localhost:39177"
                                             IsReadOnly="True"
                                             ToolTip="This value must match the Kick developer app exactly." />
                                </DockPanel>
                                <Button Content="Open Kick Developer Settings"
                                        Tag="https://kick.com/settings/developer"
                                        Click="OpenUrlButtonClick"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Client ID" Style="{StaticResource StudioFieldLabelStyle}" />
                        <TextBox Text="{Binding Settings.Chat.KickClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />
                        <TextBlock Text="Client Secret" Style="{StaticResource StudioFieldLabelStyle}" />
                        <PasswordBox x:Name="KickClientSecretBox"
                                     PasswordChanged="KickClientSecretBoxPasswordChanged"
                                     Margin="0,0,0,12" />
                        <TextBlock Text="The app requests these scopes: user:read, channel:read, chat:write."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{Binding KickAccountStatus}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioSuccessTextBrush}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsCompleteVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="You are ready to watch"
                                   Style="{StaticResource StudioSectionTitleStyle}" />
                        <TextBlock Text="Your choices are saved in the app's local settings. Start with a Twitch or Kick URL or channel name in the home search bar, or open a stream from your followed channels."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                   Margin="0,0,0,18" />
                        <Border Style="{StaticResource StudioEmptyStateStyle}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Twitch" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TwitchAccountStatus}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource StudioTextMutedBrush}"
                                           Margin="0,4,0,14" />
                                <TextBlock Text="Kick" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding KickAccountStatus}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource StudioTextMutedBrush}"
                                           Margin="0,4,0,14" />
                                <TextBlock Text="{Binding DependencyStatus}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource StudioSuccessTextBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="If you skipped a platform, public playback still works. You can reconnect later from Settings &gt; Accounts, but you should not need to do that for the platform you connected here."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource StudioTextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource StudioTextMutedBrush}"
                       MaxWidth="470" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0"
                        HorizontalAlignment="Right">
                <Button Content="Back"
                        Click="BackButtonClick"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding IsNotBusy}"
                        MinWidth="82"
                        Margin="0,0,8,0" />
                <Button Content="Next"
                        Click="NextButtonClick"
                        Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource StudioPrimaryButtonStyle}"
                        MinWidth="96" />
                <Button Content="{Binding TwitchFooterActionText}"
                        Click="TwitchFooterActionButtonClick"
                        Visibility="{Binding IsTwitchVisible, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding IsNotBusy}"
                        MinWidth="124"
                        Margin="0,0,8,0" />
                <Button Content="{Binding KickFooterActionText}"
                        Click="KickFooterActionButtonClick"
                        Visibility="{Binding IsKickVisible, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding IsNotBusy}"
                        MinWidth="96"
                        Margin="0,0,8,0" />
                <Button Content="Finish setup"
                        Click="FinishButtonClick"
                        Visibility="{Binding IsCompleteVisible, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource StudioPrimaryButtonStyle}"
                        MinWidth="132" />
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>

<Window x:Class="StreamlinkVlcStudio.App.Wpf.LocalWebServerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LAN browser server"
        Icon="/StreamStudio;component/Assets/Studio.ico"
        Width="660" Height="790" MinWidth="520" MinHeight="520"
        Background="{DynamicResource StudioBaseBrush}"
        Foreground="{DynamicResource StudioTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource StudioSurface0Brush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#xE8BB;" Width="40" MinHeight="0" Padding="0"
                            FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Close"
                            AutomationProperties.Name="Close LAN browser server window"
                            Style="{DynamicResource StudioSubtleButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
                    <TextBlock Text="LAN browser server" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24">
                    <TextBlock Text="Watch Stream Studio in a browser" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,16" />
                    <TextBlock Text="Create a web account, then choose the Ethernet or Wi-Fi network shared with your other devices. Starting the server opens the sign-in page in your default browser. Keep the desktop app running."
                               TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                    <TextBlock Text="Web accounts" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="Each account has its own browser playback, chat, shortcut and volume preferences. Desktop accounts, follows, downloads and watch history remain shared. Passwords need at least 12 characters."
                               TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                    <ListBox x:Name="Users" Height="85" Margin="0,8,0,8" Padding="4" DisplayMemberPath="Username"
                             Background="{DynamicResource StudioSurface0Brush}"
                             Foreground="{DynamicResource StudioTextBrush}"
                             BorderBrush="{DynamicResource StudioBorderBrush}"
                             AutomationProperties.Name="Web accounts">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter ContentSource="Content"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="New username" Margin="0,0,0,4" />
                    <TextBox x:Name="Username" Margin="0,0,0,6" MaxLength="32" AutomationProperties.Name="New web username" />
                    <TextBlock Text="Password" Margin="0,0,0,4" />
                    <PasswordBox x:Name="Password" Margin="0,0,0,6" MaxLength="128" AutomationProperties.Name="Web account password" />
                    <TextBlock Text="Confirm password" Margin="0,0,0,4" />
                    <PasswordBox x:Name="ConfirmPassword" Margin="0,0,0,8" MaxLength="128" AutomationProperties.Name="Confirm web account password" />
                    <WrapPanel>
                        <Button x:Name="AddUser" Content="Add account" Margin="0,0,8,8" Padding="12,6" />
                        <Button x:Name="ChangePassword" Content="Change selected password" Margin="0,0,8,8" Padding="12,6" />
                        <Button x:Name="RemoveUser" Content="Remove selected account" Margin="0,0,8,8" Padding="12,6" />
                    </WrapPanel>
                    <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ComboBox x:Name="Networks" Margin="0,16,0,8" AutomationProperties.Name="LAN network" />
                    <TextBlock Text="HTTPS port (1024–65535)" />
                    <TextBox x:Name="Port" Text="18443" Margin="0,4,0,12" AutomationProperties.Name="HTTPS port" />
                    <TextBox x:Name="Status" IsReadOnly="True" TextWrapping="Wrap" MinHeight="116" Margin="0,0,0,12"
                             AutomationProperties.Name="Server connection details" />
                    <TextBlock Text="HTTPS uses a local CA and server certificate kept in your Windows user certificate store. Export the public CA certificate, then install and trust it on the other device. On iPhone, enable full trust in Settings > General > About > Certificate Trust Settings after installing it. Compare the CA SHA-256 fingerprint before trusting it, then open the HTTPS address and sign in. Some TV browsers cannot accept local certificates or decode HLS; those devices cannot use this secure player."
                               TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                    <TextBlock Text="The server accepts only private IPv4 clients in the selected interface’s subnet. If Windows Firewall blocks access, allow this port only on your Private network profile and local subnet. The app never opens firewall/router rules or enables port forwarding. Sessions expire after 30 minutes idle or 8 hours; Account sign-in and host executable/folder paths are managed on the desktop."
                               TextWrapping="Wrap" Foreground="{DynamicResource StudioTextSecondaryBrush}" Margin="0,12,0,16" />
                    <WrapPanel>
                        <Button x:Name="Start" Content="Start server" Style="{DynamicResource StudioPrimaryButtonStyle}" Margin="0,0,8,8" Padding="12,6" />
                        <Button x:Name="Stop" Content="Stop server" Margin="0,0,8,8" Padding="12,6" />
                        <Button x:Name="Rotate" Content="Disconnect all devices" Margin="0,0,8,8" Padding="12,6" />
                        <Button x:Name="Export" Content="Export public CA certificate" Margin="0,0,8,8" Padding="12,6" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

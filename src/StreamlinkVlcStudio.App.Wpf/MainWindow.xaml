                                         Height="16"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center">
                                    <Path Style="{StaticResource HomePlatformIconStyle}" />
                                </Viewbox>
                            </Border>
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="11"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    Background="#D4101012"
                                    BorderBrush="{DynamicResource StudioSuccessBrush}"
                                    BorderThickness="1">
                                <DockPanel LastChildFill="False">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="{DynamicResource StudioSuccessBrush}"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ViewerCountText}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </controls:RoundedClipBorder>

                    <Grid Grid.Row="1"
                          Margin="14,12,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="True">
                            <controls:RoundedClipBorder DockPanel.Dock="Left"
                                                        Style="{StaticResource HomeProfileAvatarStyle}"
                                                        DataContext="{Binding ProfileImageUrl}"

                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StudioDangerBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding LiveStatusKey}" Value="Checking">
                                                                                    <Setter Property="Background" Value="{DynamicResource StudioInfoSubtleBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StudioInfoBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="7"
                                                                                 Height="7"
                                                                                 Margin="0,0,6,0"
                                                                                 VerticalAlignment="Center">
                                                                            <Ellipse.Style>
                                                                                <Style TargetType="Ellipse">
                                                                                    <Setter Property="Fill" Value="#8A8A93" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding LiveStatusKey}" Value="Live">
                                                                                            <Setter Property="Fill" Value="{DynamicResource StudioSuccessBrush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding LiveStatusKey}" Value="Offline">
                                                                                            <Setter Property="Fill" Value="{DynamicResource StudioDangerBrush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding LiveStatusKey}" Value="Checking">
                                                                                            <Setter Property="Fill" Value="{DynamicResource StudioInfoBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Ellipse.Style>
                                                                        </Ellipse>
                                                                        <TextBlock Text="{Binding LiveStatusText}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource StudioTextBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Text="{Binding MetadataText}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource StudioTextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="240"
                                                                           HorizontalAlignment="Right"
                                                                           Margin="0,5,0,0" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Grid>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource RecentStreamDeleteButton}"
                                                            Content="&#xE74D;"
                                                            Command="{Binding DeleteCommand}"
                                                            ToolTip="{Binding DeleteToolTip}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsSelectedTabDetached, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="This tab is in picture-in-picture"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Use the dock button in the floating window to return it here."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

            </Grid>
                <Border Grid.Row="1"
                        Background="{DynamicResource StudioBaseBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8"
                        Visibility="{Binding IsReplaySeekBarVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid ToolTip="{Binding SelectedTab.ReplaySeekToolTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedTab.ReplayElapsedText}"
                                   Foreground="{DynamicResource StudioTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Margin="0,0,12,0" />
                        <Button Grid.Column="1"
                                Content="-30s"
                                Style="{StaticResource ReplayStepButton}"
                                Command="{Binding SelectedTab.RewindReplay30SecondsCommand}"
                                ToolTip="Rewind 30 seconds" />
                        <Slider x:Name="ReplaySeekSlider"
                                Grid.Column="2"
                                Style="{StaticResource ReplaySeekSliderStyle}"
                                Minimum="0"
                                Maximum="{Binding SelectedTab.ReplaySeekMaximum}"
                                Value="{Binding SelectedTab.ReplaySeekSliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding SelectedTab.CanSeekReplay}"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                PreviewMouseLeftButtonUp="ReplaySeekSlider_Commit"
                                KeyUp="ReplaySeekSlider_KeyUp"
                                ToolTip="{Binding SelectedTab.ReplaySeekToolTip}" />
                        <Button Grid.Column="3"
                                Content="+30s"
                                Style="{StaticResource ReplayStepButton}"
                                Command="{Binding SelectedTab.FastForwardReplay30SecondsCommand}"
                                ToolTip="Fast forward 30 seconds" />
                         <TextBlock Grid.Column="4"
                                    Text="{Binding SelectedTab.ReplayDurationText}"
                                    Visibility="{Binding SelectedTab.IsReplayMode, Converter={StaticResource BoolToVisibility}}"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                   TextAlignment="Left"
                                   Margin="12,0,0,0" />
                        <StackPanel Grid.Column="5"
                                     Orientation="Horizontal"
                                     VerticalAlignment="Center"
                                     Margin="12,0,0,0">
                            <Button Content="Live"
                                    Style="{StaticResource ReplayLiveButton}"
                                    Command="{Binding SelectedTab.ReturnToLiveCommand}"
                                    ToolTip="Return to live playback" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </DockPanel>

        <Border x:Name="TopControlsBar"
                Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&#xE80F;"
                        Style="{StaticResource TopHomeButton}"
                        Command="{Binding SelectHomeCommand}"
                        ToolTip="Home"
                         VerticalAlignment="Center"
                         Margin="10,0,4,0" />

                <StackPanel x:Name="HomeNavigation"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            Visibility="{Binding IsHomeSelected, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource FollowedHomeSegmentButton}"
                            Content="Live"
                            Command="{Binding ShowFollowedHomePageCommand}" />
                    <Button Style="{StaticResource TwitchVodsHomeSegmentButton}"
                            Content="VODs"
                            Command="{Binding ShowTwitchVodsHomePageCommand}" />
                    <Button Style="{StaticResource BrowseHomeSegmentButton}"
                            Content="Browse"
                            Command="{Binding ShowBrowseHomePageCommand}" />
                    <Button Style="{StaticResource RecentHomeSegmentButton}"
                            Content="Recent"
                            Command="{Binding ShowRecentHomePageCommand}" />
                </StackPanel>

                <ListBox x:Name="TabListBox"
                         Grid.Column="1"
                         ItemsSource="{Binding TabStripItems}"
                         SelectedItem="{Binding SelectedTabStripItem}"
                         PreviewMouseWheel="TabListBox_PreviewMouseWheel"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center"
                          Margin="8,0">
                    <ListBox.Style>
                        <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHomeSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Panel.ZIndex" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="1" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabChrome"
                                    Margin="2,0"
                                    Padding="7,3"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource StudioBorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource StudioSurface1Brush}"
                                    SnapsToDevicePixels="True"
                                    ToolTip="{Binding ToolTip}"
                                    PreviewMouseLeftButtonDown="TabContent_PreviewMouseLeftButtonDown">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource IconButton}"
                                            Content="&#xE711;"
                                            Width="20"
                                            MinHeight="20"
                                            FontSize="12"
                                            Margin="5,0,0,0"
                                            Tag="{Binding}"
                                            Click="CloseTabButton_Click"
                                            ToolTip="Close tab" />
                                    <controls:RoundedClipBorder DockPanel.Dock="Left"
                                                                Width="22"
                                                                Height="22"
                                                                CornerRadius="11"
                                                                ClipToBounds="True"
                                                                Background="{DynamicResource StudioSurface0Brush}"
                                                                BorderBrush="{DynamicResource StudioBorderBrush}"
                                                                BorderThickness="1"
                                                                Margin="0,0,8,0"
                                                                DataContext="{Binding ProfileImageUrl}"
                                                                VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="&#xE77B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource StudioTextDimBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <controls:AnimatedEmoteImage ImageUrl="{Binding}"
                                                                         MaxImageBytes="8388608"
                                                                         Stretch="UniformToFill" />
                                        </Grid>
                                    </controls:RoundedClipBorder>
                                    <StackPanel Width="122">
                                        <TextBlock x:Name="TabTitleTextBox"
                                                   Text="{Binding Title}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Width="122" />
                                        <DockPanel Margin="0,2,0,0" LastChildFill="True">
                                            <Border x:Name="TabViewerCountBox"
                                                    DockPanel.Dock="Right"
                                                    Width="60"
                                                    MinHeight="16"
                                                    Padding="3,1"
                                                    Margin="5,0,0,0"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                                                    Background="{DynamicResource StudioSurfaceCardBrush}"
                                                    ToolTip="{Binding ViewerCountToolTip}">
                                                <DockPanel HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           LastChildFill="False">
                                                    <TextBlock x:Name="TabViewerCountIcon"
                                                               DockPanel.Dock="Left"
                                                               Text="&#xE890;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="9"
                                                               Margin="0,0,3,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TabViewerCountTextBlock"
                                                               Text="{Binding ViewerCountText}"
                                                               DockPanel.Dock="Right"
                                                               VerticalAlignment="Center"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <TextBlock x:Name="TabStatusTextBlock"
                                                       Text="{Binding SubtitleText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource StudioSurface0Brush}" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                                    <Setter TargetName="TabViewerCountIcon" Property="Text" Value="&#xE8A9;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource StudioSurface2Brush}" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDetached}" Value="True">
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="TabStatusTextBlock" Property="Text" Value="Picture-in-picture" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SelectedTabBrush}" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource SelectedTabBorderBrush}" />
                                    <Setter TargetName="TabTitleTextBox" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="TabStatusTextBlock" Property="Foreground" Value="{StaticResource SelectedTabMutedTextBrush}" />
                                    <Setter TargetName="TabViewerCountBox" Property="Background" Value="#0D3B23" />
                                    <Setter TargetName="TabViewerCountBox" Property="BorderBrush" Value="{StaticResource SelectedTabBorderBrush}" />
                                    <Setter TargetName="TabViewerCountIcon" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="TabViewerCountTextBlock" Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,11,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                    </StackPanel.Style>
                        <Button x:Name="TopPlayPauseButton"
                                Style="{StaticResource PauseResumeIconButton}"
                                Command="{Binding PauseSelectedCommand}"
                                ToolTip="Pause or resume playback"
                                AutomationProperties.Name="Pause or resume playback" />
                        <Button Style="{StaticResource TopControlIconButton}"
                                Content="&#xE72C;"
                                Command="{Binding ReloadSelectedCommand}"
                                ToolTip="Reload stream" />
                        <Button Style="{StaticResource TopControlIconButton}"
                                Content="Clip"
                                FontFamily="Segoe UI"
                                FontSize="11"
                                Width="44"
                                Command="{Binding CreateClipCommand}"
                                ToolTip="{Binding ClipButtonToolTip}"
                                AutomationProperties.Name="Create Twitch clip" />
                        <Button x:Name="TopReplayToggleButton"
                                Style="{StaticResource ReplaySeekBarToggleIconButton}"
                                Content="&#xE121;"
                                Command="{Binding ToggleReplaySeekBarCommand}"
                                ToolTip="{Binding ReplaySeekBarToggleToolTip}"
                                AutomationProperties.Name="Toggle replay controls" />
                        <Button Style="{StaticResource ChatToggleIconButton}"
                                Content="&#xE8F2;"
                                Command="{Binding ToggleChatCommand}"
                                ToolTip="Show or hide chat" />
                        <Button Style="{StaticResource MultiStreamToggleIconButton}"
                                Content="&#xE8A9;"
                                Command="{Binding ToggleMultiStreamCommand}"
                                ToolTip="{Binding MultiStreamToggleToolTip}" />
                        <Button x:Name="TopFullscreenButton"
                                Style="{StaticResource TopControlIconButton}"
                                Content="&#xE740;"
                                Click="FullscreenButton_Click"
                                ToolTip="Fullscreen stream"
                                AutomationProperties.Name="Fullscreen stream" />
                        <Button x:Name="TopTheatreButton"
                                Style="{StaticResource TopControlIconButton}"
                                Content="&#xE7F4;"
                                Click="TheatreButton_Click"
                                ToolTip="Theatre mode"
                                AutomationProperties.Name="Theatre mode" />
                    </StackPanel>
                    <Button Style="{StaticResource SettingsToggleIconButton}"
                            Content="&#xE713;"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip="Open settings" />
                    <Button x:Name="TopMuteButton"
                            Content="&#xE74F;"
                            ToolTip="Mute or unmute"
                            Click="MuteButton_Click"
                            AutomationProperties.Name="Mute or unmute">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MuteToggleIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SettingsPanel"
                Grid.ColumnSpan="2"
                Grid.Row="2"
                Background="{DynamicResource StudioBaseBrush}"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource StudioSurface0Brush}"
                        BorderBrush="{DynamicResource StudioBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="14,22,14,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40"
                                    Height="40"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource StudioAccentPressedBrush}"
                                    BorderBrush="{DynamicResource StudioAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="{DynamicResource StudioAccentHoverBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Stream Studio"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Workspace preferences"
                                           Margin="0,3,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource StudioTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="PREFERENCES"
                                   Margin="12,0,0,10"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StudioTextMutedBrush}" />
                        <StackPanel Grid.Row="2">
                            <Button Style="{StaticResource GeneralSettingsCategoryButton}"
                                    Content="General"
                                    Command="{Binding ShowGeneralSettingsCommand}"
                                    AutomationProperties.Name="General settings" />
                            <Button Style="{StaticResource PlaybackSettingsCategoryButton}"
                                    Content="Playback"
                                    Command="{Binding ShowPlaybackSettingsCommand}"
                                    AutomationProperties.Name="Playback settings" />
                            <Button Style="{StaticResource AccountsSettingsCategoryButton}"
                                    Content="Accounts"
                                    Command="{Binding ShowAccountsSettingsCommand}"
                                    AutomationProperties.Name="Account settings" />
                            <Button Style="{StaticResource ChatSettingsCategoryButton}"
                                    Content="Chat"
                                    Command="{Binding ShowChatSettingsCommand}"
                                    AutomationProperties.Name="Chat settings" />
                            <Button Style="{StaticResource HotkeysSettingsCategoryButton}"
                                    Content="Hotkeys"
                                    Command="{Binding ShowHotkeysSettingsCommand}"
                                    AutomationProperties.Name="Hotkey settings" />
                            <Button Style="{StaticResource AdvancedSettingsCategoryButton}"
                                    Content="Advanced"
                                    Command="{Binding ShowAdvancedSettingsCommand}"
                                    AutomationProperties.Name="Advanced settings" />
                        </StackPanel>
                        <Button Grid.Row="3"
                                Style="{StaticResource SettingsBackButtonStyle}"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip="Close settings"
                                AutomationProperties.Name="Back to studio">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;"
                                           Margin="0,0,10,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Back to studio"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="76" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="SettingsContentScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Left">
                        <Grid Width="{Binding ElementName=SettingsContentScrollViewer, Path=ViewportWidth}">
                            <Grid MaxWidth="1040"
                                  Margin="28,24,28,32"
                                  HorizontalAlignment="Stretch">
                            <StackPanel x:Name="GeneralSettingsPage"
                                        Visibility="{Binding IsGeneralSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Application behavior" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <TextBlock Text="When closing the window" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding CloseBehaviorOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.CloseBehavior}"
                                                      Margin="0,0,0,16"
                                                      ToolTip="Choose whether closing exits the app or leaves it running in the tray." />
                                            <TextBlock Text="Theme" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.Theme}"
                                                      Margin="0,0,0,16"
                                                      ToolTip="Choose a color theme for the application." />
                                            <CheckBox Content="Keep home card right-side gap"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.KeepHomeCardRightGap}"
                                                      ToolTip="Leave unused space at the right edge of Live, VOD, and Browse card rows." />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Followed channels" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <CheckBox x:Name="WindowsToastNotificationsCheckBox"
                                                      Content="Windows toast notifications"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.FollowedChannels.NotifyWhenLive}"
                                                      Margin="0,0,0,16"
                                                      ToolTip="Show a Windows toast when a followed channel goes live. Checks every minute while the app is running, including when it is minimized to the tray." />
                                            <TextBlock Text="Kick channel slugs" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding KickFollowedChannelsText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     MinHeight="112"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     ToolTip="One Kick channel slug or URL per line. Twitch follows use Twitch authorization." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PlaybackSettingsPage"
                                        Visibility="{Binding IsPlaybackSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Stream defaults" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <TextBlock Text="Stream quality" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding QualityOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedQuality}"
                                                      Margin="0,0,0,16" />
                                            <TextBlock Text="Video renderer" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding VideoRendererOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.VideoRendererMode}"
                                                      Margin="0,0,0,16"
                                                      ToolTip="Automatic prefers Direct3D 11 for normal playback and uses GDI when native chat overlays need compatibility." />
                                            <CheckBox Content="Low latency options"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.LowLatency}"
                                                      Margin="0,0,0,8" />
                                            <CheckBox Content="Keep inactive tabs running"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.KeepInactiveTabsRunning}"
                                                      Margin="0,0,0,8"
                                                      ToolTip="When disabled, hidden live tabs close their player connection and reconnect at the live edge when shown again, while keeping Streamlink and chat ready. Replay/VOD and behind-live tabs preserve their position." />
                                            <CheckBox Content="Multi-stream grid"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding IsMultiStreamEnabled}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Replay" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <TextBlock Text="Use platform playback to revisit moments without leaving the studio."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}"
                                                       Margin="0,0,0,14" />
                                            <CheckBox Content="Enable platform replay seekbar"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.Replay.Enabled}"
                                                      Margin="0,0,0,8"
                                                      ToolTip="Use platform VOD/replay playback when a current replay is available." />
                                            <CheckBox Content="Try private Kick replay lookup"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.Replay.AttemptPrivateKickReplayResolution}"
                                                      ToolTip="Best-effort Kick website probing; private page data may change." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="AccountsSettingsPage"
                                        Visibility="{Binding IsAccountsSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,18">
                                                <Border DockPanel.Dock="Left"
                                                        Background="{DynamicResource StudioTwitchSubtleBrush}"
                                                        BorderBrush="{DynamicResource StudioTwitchBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="8,4"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="TWITCH"
                                                               Foreground="{DynamicResource StudioTwitchTextBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="Twitch account"
                                                           Style="{StaticResource SettingsCardHeaderStyle}"
                                                           Margin="0"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="Username" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.TwitchUsername, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />
                                            <TextBlock Text="Client ID" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.TwitchClientId, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" ToolTip="Redirect URL: http://localhost:39178" />
                                            <TextBlock Text="OAuth token" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.TwitchOAuthToken, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,16" ToolTip="The oauth: or Bearer prefix is optional." />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Connect Twitch"
                                                        Style="{StaticResource StudioPrimaryButtonStyle}"
                                                        Command="{Binding AuthorizeTwitchCommand}"
                                                        MinWidth="124" />
                                                <Button Content="Clear token" Command="{Binding ClearTwitchTokenCommand}" MinWidth="92" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,18">
                                                <Border DockPanel.Dock="Left"
                                                        Background="{DynamicResource StudioKickSubtleBrush}"
                                                        BorderBrush="{DynamicResource StudioKickBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="8,4"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="KICK"
                                                               Foreground="{DynamicResource StudioKickTextBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="Kick account"
                                                           Style="{StaticResource SettingsCardHeaderStyle}"
                                                           Margin="0"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="Username" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.KickUsername, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />
                                            <TextBlock Text="User access token" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.KickOAuthToken, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />
                                            <TextBlock Text="Client ID" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.KickClientId, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />
                                            <TextBlock Text="Client secret" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.KickClientSecret, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,16" ToolTip="Saved in settings; treat it as account-sensitive." />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Button Content="Connect Kick"
                                                        Style="{StaticResource StudioPrimaryButtonStyle}"
                                                        Command="{Binding AuthorizeKickCommand}"
                                                        MinWidth="116" />
                                                <Button Content="Clear token" Command="{Binding ClearKickTokenCommand}" MinWidth="92" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <CheckBox Content="Send Kick messages as bot"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.Chat.KickSendAsBot}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="ChatSettingsPage"
                                        Visibility="{Binding IsChatSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Chat behavior" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <TextBlock Text="Layout" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding ChatLayoutOptions}"
                                                      SelectedItem="{Binding Settings.Chat.Layout}"
                                                      Margin="0,0,0,12" />
                                            <CheckBox Content="Connect to chat automatically"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.Chat.ConnectAutomatically}"
                                                      Margin="0,0,0,16" />
                                            <DockPanel Margin="0,0,0,4">
                                                <Border DockPanel.Dock="Right"
                                                        Background="{DynamicResource StudioSurface2Brush}"
                                                        CornerRadius="6"
                                                        Padding="7,3">
                                                    <TextBlock Text="{Binding Settings.Chat.Opacity, StringFormat={}{0:P0}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource StudioAccentHoverBrush}" />
                                                </Border>
                                                <TextBlock Text="Chat opacity" Style="{StaticResource StudioFieldLabelStyle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding Settings.Chat.Opacity}" Margin="0,0,0,14" />
                                            <DockPanel Margin="0,0,0,4">
                                                <Border DockPanel.Dock="Right"
                                                        Background="{DynamicResource StudioSurface2Brush}"
                                                        CornerRadius="6"
                                                        Padding="7,3">
                                                    <TextBlock Text="{Binding Settings.Chat.FontSize, StringFormat={}{0:0} px}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource StudioAccentHoverBrush}" />
                                                </Border>
                                                <TextBlock Text="Docked chat text size" Style="{StaticResource StudioFieldLabelStyle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Slider Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Chat.FontSize}" Margin="0,0,0,14" />
                                            <DockPanel Margin="0,0,0,4">
                                                <Border DockPanel.Dock="Right"
                                                        Background="{DynamicResource StudioSurface2Brush}"
                                                        CornerRadius="6"
                                                        Padding="7,3">
                                                    <TextBlock Text="{Binding Settings.Chat.DockWidth, StringFormat={}{0:0} px}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource StudioAccentHoverBrush}" />
                                                </Border>
                                                <TextBlock Text="Docked chat width" Style="{StaticResource StudioFieldLabelStyle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Slider Minimum="220" Maximum="720" TickFrequency="10" Value="{Binding Settings.Chat.DockWidth}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Native VLC overlay" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <TextBlock Text="Plugin directory" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.VlcOverlayDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,16"
                                                     ToolTip="Leave blank to use the bundled overlay." />
                                            <DockPanel Margin="0,0,0,4">
                                                <Border DockPanel.Dock="Right"
                                                        Background="{DynamicResource StudioSurface2Brush}"
                                                        CornerRadius="6"
                                                        Padding="7,3">
                                                    <TextBlock Text="{Binding SelectedVlcOverlayFontSize, StringFormat={}{0:0} px}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource StudioAccentHoverBrush}" />
                                                </Border>
                                                <TextBlock Text="Selected stream overlay text size"
                                                           Style="{StaticResource StudioFieldLabelStyle}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Slider Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    IsEnabled="{Binding HasSelectedTab}"
                                                    Value="{Binding SelectedVlcOverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Select a stream tab to tune its native overlay size."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="HotkeysSettingsPage"
                                        Visibility="{Binding IsHotkeysSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource SettingsSectionCard}">
                                    <DockPanel>
                                        <Button x:Name="ResetHotkeysButton"
                                                DockPanel.Dock="Right"
                                                Content="Reset defaults"
                                                Click="ResetHotkeysButton_Click"
                                                MinWidth="116"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Reset all hotkeys to defaults" />
                                        <StackPanel>
                                            <TextBlock Text="Keyboard shortcuts"
                                                       Style="{StaticResource SettingsCardHeaderStyle}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="Click a binding, then press any non-modifier key or key combination. If a shortcut is already assigned, the two bindings swap. Typing and editing keys pause while a text field is active, and Windows-reserved combinations may be unavailable."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Tab navigation" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <Grid Margin="0,0,0,18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Previous tab" FontWeight="SemiBold" />
                                                    <TextBlock Text="Select the tab to the left."
                                                               Style="{StaticResource SettingsPageDescriptionStyle}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <controls:HotkeyRecorderButton x:Name="PreviousTabHotkeyRecorder"
                                                                               Grid.Column="1"
                                                                               Style="{StaticResource HotkeyRecorderButtonStyle}"
                                                                               Gesture="{Binding Settings.Hotkeys.PreviousTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               DefaultGesture="{x:Static settings:HotkeySettings.DefaultPreviousTab}"
                                                                               Tag="PreviousTab"
                                                                               GestureChanging="HotkeyRecorder_GestureChanging"
                                                                               ActionName="Previous tab hotkey" />
                                            </Grid>
                                            <Border Height="1"
                                                    Background="{DynamicResource StudioBorderBrush}"
                                                    Margin="0,0,0,18" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Next tab" FontWeight="SemiBold" />
                                                    <TextBlock Text="Select the tab to the right."
                                                               Style="{StaticResource SettingsPageDescriptionStyle}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <controls:HotkeyRecorderButton x:Name="NextTabHotkeyRecorder"
                                                                               Grid.Column="1"
                                                                               Style="{StaticResource HotkeyRecorderButtonStyle}"
                                                                               Gesture="{Binding Settings.Hotkeys.NextTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               DefaultGesture="{x:Static settings:HotkeySettings.DefaultNextTab}"
                                                                               Tag="NextTab"
                                                                               GestureChanging="HotkeyRecorder_GestureChanging"
                                                                               ActionName="Next tab hotkey" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Workspace" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <Grid Margin="0,0,0,18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Toggle replay seek bar"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="Show or hide replay controls."
                                                               Style="{StaticResource SettingsPageDescriptionStyle}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <controls:HotkeyRecorderButton x:Name="ToggleReplaySeekBarHotkeyRecorder"
                                                                               Grid.Column="1"
                                                                               Style="{StaticResource HotkeyRecorderButtonStyle}"
                                                                               Gesture="{Binding Settings.Hotkeys.ToggleReplaySeekBar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               DefaultGesture="{x:Static settings:HotkeySettings.DefaultToggleReplaySeekBar}"
                                                                               Tag="ToggleReplaySeekBar"
                                                                               GestureChanging="HotkeyRecorder_GestureChanging"
                                                                               ActionName="Toggle replay seek bar hotkey" />
                                            </Grid>
                                            <Border Height="1"
                                                    Background="{DynamicResource StudioBorderBrush}"
                                                    Margin="0,0,0,18" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Exit fullscreen / stop auto-scroll"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="Dismiss the active fullscreen or home scrolling mode."
                                                               Style="{StaticResource SettingsPageDescriptionStyle}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <controls:HotkeyRecorderButton x:Name="DismissFullscreenHotkeyRecorder"
                                                                               Grid.Column="1"
                                                                               Style="{StaticResource HotkeyRecorderButtonStyle}"
                                                                               Gesture="{Binding Settings.Hotkeys.DismissFullscreenOrAutoScroll, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               DefaultGesture="{x:Static settings:HotkeySettings.DefaultDismissFullscreenOrAutoScroll}"
                                                                               Tag="DismissFullscreenOrAutoScroll"
                                                                               GestureChanging="HotkeyRecorder_GestureChanging"
                                                                               ActionName="Exit fullscreen or stop auto-scroll hotkey" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="AdvancedSettingsPage"
                                        Visibility="{Binding IsAdvancedSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="Playback tools" Style="{StaticResource SettingsCardHeaderStyle}" />
                                            <TextBlock Text="Streamlink executable" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <DockPanel Margin="0,0,0,14">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Browse"
                                                        Click="BrowseStreamlinkButton_Click"
                                                        MinWidth="82"
                                                        Margin="8,0,0,0" />
                                                <TextBox Text="{Binding Settings.StreamlinkPath, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <TextBlock Text="VLC directory" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <DockPanel Margin="0,0,0,14">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Browse"
                                                        Click="BrowseVlcButton_Click"
                                                        MinWidth="82"
                                                        Margin="8,0,0,0" />
                                                <TextBox Text="{Binding Settings.VlcDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <TextBlock Text="Custom Streamlink arguments" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.CustomStreamlinkArguments, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     MinHeight="100"
                                                     TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource SettingsSectionCard}">
                                            <StackPanel>
                                                <TextBlock Text="Updates" Style="{StaticResource SettingsCardHeaderStyle}" />
                                                <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                                        Command="{Binding UpdateAppCommand}"
                                                        MinWidth="156"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,12"
                                                        AutomationProperties.Name="Update from GitHub">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE895;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="13"
                                                                   Margin="0,0,9,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="Update from GitHub" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="{Binding AppUpdateStatus}"
                                                           Style="{StaticResource SettingsPageDescriptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsSectionCard}">
                                            <StackPanel>
                                                <TextBlock Text="Kick webhooks" Style="{StaticResource SettingsCardHeaderStyle}" />
                                                <CheckBox Content="Listen for official Kick chat webhooks"
                                                          Style="{StaticResource SettingsToggleStyle}"
                                                          IsChecked="{Binding Settings.Chat.KickWebhookListenerEnabled}"
                                                          Margin="0,0,0,14" />
                                                <TextBlock Text="Local listener port" Style="{StaticResource StudioFieldLabelStyle}" />
                                                <TextBox Text="{Binding Settings.Chat.KickWebhookListenerPort, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,14" />
                                                <TextBlock Text="Local forwarding target" Style="{StaticResource StudioFieldLabelStyle}" />
                                                <TextBox Text="{Binding KickWebhookLocalUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding KickWebhookListenerStatus}"
                                                           Style="{StaticResource SettingsPageDescriptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsSectionCard}"
                                                Visibility="{Binding HasSelectedKickTab, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="Selected Kick stream" Style="{StaticResource SettingsCardHeaderStyle}" />
                                                <TextBlock Text="Chatroom ID" Style="{StaticResource StudioFieldLabelStyle}" />
                                                <TextBox Text="{Binding SelectedKickChatroomId, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />
                                                <TextBlock Text="Broadcaster user ID" Style="{StaticResource StudioFieldLabelStyle}" />
                                                <TextBox Text="{Binding SelectedKickBroadcasterUserId, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="SettingsStickyFooter"
                            Grid.Row="1"
                            Background="{DynamicResource StudioSurface0Brush}"
                            BorderBrush="{DynamicResource StudioBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <DockPanel Margin="28,0">
                            <Button x:Name="SettingsSaveButton"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource StudioPrimaryButtonStyle}"
                                    Command="{Binding SaveSettingsCommand}"
                                    MinWidth="148"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Save settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Save changes" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{DynamicResource StudioSuccessBrush}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Stored locally on this device"
                                               FontWeight="SemiBold"
                                               FontSize="12" />
                                    <TextBlock Text="Playback continues while you fine-tune your workspace."
                                               Foreground="{DynamicResource StudioTextMutedBrush}"
                                               FontSize="10"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>

        <DataTemplate x:Key="LiveStreamCardTemplate" DataType="{x:Type vm:LiveStreamCardViewModel}">
            <Button Style="{StaticResource HomeCardButton}" Command="{Binding OpenCommand}"
                    AutomationProperties.Name="{Binding DisplayName}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Open stream" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Open and keep browsing" Command="{Binding OpenAndStayOnHomeCommand}" InputGestureText="Ctrl+click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <controls:AspectRatioDecorator>
                    <controls:RoundedClipBorder CornerRadius="11,11,0,0" Background="{DynamicResource StudioSurface2Brush}">
                        <Grid>
                            <TextBlock x:Name="LiveCardPlaceholder" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       Foreground="{DynamicResource StudioTextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <controls:AnimatedEmoteImage ImageRequest="{Binding ThumbnailImageRequest}" MaxImageBytes="8388608" Stretch="UniformToFill" />
                            <controls:StreamHoverPreview Style="{StaticResource StreamHoverPreviewStyle}" />
                            <Border x:Name="LiveCardPlayAffordance" Style="{StaticResource StudioCardPlayAffordance}">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </Border>
                            <Border Background="#D12F50" CornerRadius="5" Padding="8,4" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Fill="White" Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="LIVE" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Background="#E514171C" CornerRadius="5" Padding="8,4" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" Foreground="#F2F5F3" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ViewerCountText}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HomePlatformBadgeStyle}" Width="26" Height="26" Padding="6" BorderThickness="0"
                                    Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{Binding PlatformText}">
                                <Viewbox><Path Style="{StaticResource HomePlatformIconStyle}" /></Viewbox>
                            </Border>
                        </Grid>
                    </controls:RoundedClipBorder>
                    </controls:AspectRatioDecorator>
                    <StackPanel Grid.Row="1" Margin="14,12,14,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:RoundedClipBorder Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Background="{DynamicResource StudioSurface3Brush}">
                                <Grid>
                                    <Path x:Name="ProfileAvatarPlaceholder" Style="{StaticResource StudioLineIcon}" Data="{StaticResource StudioIconAccount}"
                                          Width="14" Height="14" HorizontalAlignment="Center" Stroke="{DynamicResource StudioTextMutedBrush}" Visibility="Collapsed" />
                                    <controls:AnimatedEmoteImage x:Name="ProfileAvatarImage" ImageUrl="{Binding ProfileImageUrl}" MaxImageBytes="8388608" Stretch="UniformToFill" />
                                </Grid>
                            </controls:RoundedClipBorder>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                        <controls:EmojiTextBlock SourceText="{Binding Title}" FontSize="13" Foreground="{DynamicResource StudioTextSecondaryBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="36" MaxHeight="36" LineHeight="18"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="{Binding MetadataText, Converter={StaticResource StudioMetadata}}" FontSize="12" Foreground="{DynamicResource StudioTextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding MetadataText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <!-- A decoded avatar can be transparent; only show the fallback when no Source is available. -->
                <DataTrigger Binding="{Binding Source, ElementName=ProfileAvatarImage}" Value="{x:Null}">
                    <Setter TargetName="ProfileAvatarPlaceholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Opacity, ElementName=LiveCardPlayAffordance}" Value="1">
                    <Setter TargetName="LiveCardPlaceholder" Property="Opacity" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="BorderBrush" Value="#303846" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ToggleBorder"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                <TextBlock Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           Foreground="#9AA4B2"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#48C7B5" />
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#111823" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#48C7B5" />
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#111823" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="#11161E"
                                        BorderBrush="#303846"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E8EAED" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="Auto" />
            <RowDefinition x:Name="TopControlsRow" Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Height="36"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,9,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StreamInactiveBrush}" />
                                <Setter Property="ToolTip" Value="No stream playing" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnyStreamPlaying}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="ToolTip" Value="Stream playing" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE922;"
                            Click="MaximizeRestoreButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Maximize" />
                    <Button Style="{StaticResource TitleBarButton}"
                            Content="&#xE8BB;"
                            Click="CloseWindowButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close to tray" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel x:Name="PlaybackHost"
                   Grid.Row="2"
                   Background="{StaticResource VideoBlackBrush}">
            <Border x:Name="DockedChatPanel"
                    DockPanel.Dock="Right"
                    Width="{Binding Settings.Chat.DockWidth}"
                    Background="#11161E"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0"
                    Opacity="{Binding Settings.Chat.Opacity}"
                    PreviewMouseWheel="DockedChatPanel_PreviewMouseWheel"
                    Visibility="{Binding IsDockedChatVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="10,0"
                               Text="{Binding SelectedTab.DockedChatHeaderText}"
                               ToolTip="{Binding SelectedTab.DockedChatHeaderText}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <ListBox x:Name="DockedChatListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding SelectedTab.DockedChatFeedItems}"
                             Tag="{Binding IsMouseOver, ElementName=DockedChatPanel}"
                             PreviewMouseWheel="ChatListBox_PreviewMouseWheel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             HorizontalContentAlignment="Stretch"
                             Padding="8">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DockedChatScrollBarStyle}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <DockPanel Grid.Row="2" Margin="8,0,8,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="Send"
                                Command="{Binding SelectedTab.SendChatMessageCommand}"
                                MinWidth="62"
                                Margin="8,0,0,0" />
                        <TextBox Text="{Binding SelectedTab.OutgoingChatText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ChatInputTextBox_KeyDown"
                                 ToolTip="Chat message" />
                    </DockPanel>
                </Grid>
            </Border>

            <Grid x:Name="VideoAndReplayHost">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <Grid x:Name="VideoViewport"
                  Grid.Row="0"
                  Background="{StaticResource VideoBlackBrush}"
                  ClipToBounds="True"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  PreviewMouseLeftButtonDown="VideoViewport_PreviewMouseLeftButtonDown">
                <ItemsControl ItemsSource="{Binding VideoTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VideoSurfaceGridPanel Rows="{Binding DataContext.VideoGridRows, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            Columns="{Binding DataContext.VideoGridColumns, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                            <Setter Property="Grid.Row" Value="{Binding VideoGridRow}" />
                            <Setter Property="Grid.Column" Value="{Binding VideoGridColumn}" />
                            <Setter Property="Grid.RowSpan" Value="{Binding VideoGridRowSpan}" />
                            <Setter Property="Grid.ColumnSpan" Value="{Binding VideoGridColumnSpan}" />
                            <Setter Property="controls:VideoSurfaceGridPanel.AspectRatio" Value="{Binding VideoAspectRatio}" />
                            <Setter Property="Panel.ZIndex" Value="0" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVideoVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Panel.ZIndex" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:VideoSurface Loaded="VideoSurface_Loaded"
                                                   Unloaded="VideoSurface_Unloaded"
                                                   SurfaceMouseLeftButtonPressed="VideoSurface_MouseLeftButtonPressed"
                                                   MouseWheelScrolled="VideoSurface_MouseWheelScrolled"
                                                   MouseLeftButtonDoubleClicked="VideoSurface_MouseLeftButtonDoubleClicked"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   Tag="{Binding}">
                                <controls:VideoSurface.Style>
                                    <Style TargetType="{x:Type controls:VideoSurface}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVideoVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:VideoSurface.Style>
                            </controls:VideoSurface>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Background="#080B0F"
                      Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#0D131A"
                            BorderBrush="#1B2734"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="16,10,16,0"
                            Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="268"
                                  MinWidth="0"
                                  Margin="0,0,18,0"
                                  VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Twitch &amp; Kick player"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0" />
                                    <Border Grid.Column="1"
                                            Background="#191510"
                                            BorderBrush="#7B623C"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E5D6BD"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding BrowserClickStatus}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </Grid>

                            <Grid x:Name="HomeSearchAnchor"
                                  Grid.Column="1"
                                  MaxWidth="560"
                                  MinWidth="360"
                                  Height="36"
                                  Margin="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  PreviewMouseDown="HomeSearchAnchor_PreviewMouseDown">
                                <TextBox x:Name="HomeStreamSearchTextBox"
                                         Style="{StaticResource HomeSearchTextBoxStyle}"
                                         Text="{Binding NewStreamText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="StreamSearchTextBox_KeyDown"
                                         GotKeyboardFocus="HomeStreamSearchTextBox_GotKeyboardFocus"
                                         AutomationProperties.Name="Streamer search"
                                         ToolTip="Twitch or Kick channel name or URL" />
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           IsHitTestVisible="False"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="Search Twitch or Kick streamer"
                                           Foreground="#677384"
                                           IsHitTestVisible="False"
                                           Margin="38,0,12,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsNewStreamSearchPlaceholderVisible, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <Border Grid.Column="2"
                                    Background="#0A1017"
                                    BorderBrush="#223146"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,3"
                                    Margin="18,0,0,0"
                                    Visibility="{Binding IsFollowedHomePageSelected, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding FollowedChannelsLastUpdatedText}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10"
                                               MaxWidth="140"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <Button Style="{StaticResource HomeRefreshButton}"
                                            Content="&#xE72C;"
                                            Command="{Binding RefreshFollowedChannelsCommand}"
                                            ToolTip="Refresh followed channels" />
                                </DockPanel>
                            </Border>
                            <Popup x:Name="HomeStreamSearchPopup"
                                       Grid.ColumnSpan="3"
                                       PlacementTarget="{Binding ElementName=HomeSearchAnchor}"
                                       Placement="Bottom"
                                       VerticalOffset="8"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       StaysOpen="True"
                                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                       IsOpen="{Binding IsStreamSearchPanelVisible, Mode=OneWay}">
                                    <Border Width="{Binding ActualWidth, ElementName=HomeSearchAnchor}"
                                            MinWidth="360"
                                            MaxWidth="560"
                                            MaxHeight="360"
                                            Background="#F20C1118"
                                            BorderBrush="#364557"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24"
                                                              ShadowDepth="8"
                                                              Opacity="0.42"
                                                              Color="#000000" />
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0"
                                                       LastChildFill="True"
                                                       Margin="4,2,4,8">
                                                <Border DockPanel.Dock="Right"
                                                        Background="#122018"
                                                        BorderBrush="#2D8D65"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsStreamSearchResultsVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <DockPanel LastChildFill="False">
                                                        <Ellipse Width="6"
                                                                 Height="6"
                                                                 Fill="#43E486"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="Verified"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#CFFFE2" />
                                                    </DockPanel>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StreamSearchResultsTitle}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#EEF3F8" />
                                                    <TextBlock Text="{Binding StreamSearchStatus}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>

                                            <ProgressBar Grid.Row="1"
                                                         Height="3"
                                                         IsIndeterminate="True"
                                                         Margin="4,0,4,8"
                                                         Visibility="{Binding IsStreamSearchRunning, Converter={StaticResource BoolToVisibility}}" />

                                            <Border Grid.Row="2"
                                                    Background="#0A0E14"
                                                    BorderBrush="#202A36"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12"
                                                    Margin="0,0,0,2"
                                                    Visibility="{Binding IsStreamSearchEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel LastChildFill="True">
                                                    <Border Width="34"
                                                            Height="34"
                                                            Background="#101720"
                                                            BorderBrush="#2A3646"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE721;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="15"
                                                                   Foreground="#738094"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="No playable streams found"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#EEF3F8" />
                                                        <TextBlock Text="{Binding StreamSearchStatus}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <ScrollViewer Grid.Row="2"
                                                          MaxHeight="272"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding IsStreamSearchResultsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource HomeScrollBarStyle}" />
                                                </ScrollViewer.Resources>
                                                <ItemsControl ItemsSource="{Binding StreamSearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding OpenCommand}"
                                                                    Margin="0,0,0,6"
                                                                    Padding="0"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Background="#0F1620"
                                                                    BorderBrush="#263545"
                                                                    BorderThickness="1">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="ResultChrome"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="7"
                                                                                SnapsToDevicePixels="True">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="ResultChrome" Property="Background" Value="#172330" />
                                                                                <Setter TargetName="ResultChrome" Property="BorderBrush" Value="#48C7B5" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="ResultChrome" Property="Background" Value="#0E5F57" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid Margin="12,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0"
                                                                            Width="96"
                                                                            Height="54"
                                                                            Background="#070A0F"
                                                                            BorderBrush="#2A3646"
                                                                            BorderThickness="1"
                                                                            CornerRadius="7"
                                                                            ClipToBounds="True"
                                                                            VerticalAlignment="Center">
                                                                        <Grid>
                                                                            <TextBlock Text="&#xE7F4;"
                                                                                       FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="22"
                                                                                       Foreground="#526071"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                            <controls:AnimatedEmoteImage ImageUrl="{Binding ThumbnailUrl}"
                                                                                                         MaxImageBytes="8388608"
                                                                                                         Stretch="UniformToFill" />
                                                                        </Grid>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="12,0"
                                                                                VerticalAlignment="Center">
                                                                        <DockPanel LastChildFill="True">
                                                                            <Border DockPanel.Dock="Left"
                                                                                    Style="{StaticResource HomePlatformBadgeStyle}"
                                                                                    Margin="0,0,8,0"
                                                                                    VerticalAlignment="Center">
                                                                                <Viewbox Width="16"
                                                                                         Height="16"
                                                                                         VerticalAlignment="Center"
                                                                                         HorizontalAlignment="Center">
                                                                                    <Path Style="{StaticResource HomePlatformIconStyle}" />
                                                                                </Viewbox>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                                       FontSize="14"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="#F2F6FA"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center" />
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding CategoryName}"
                                                                                   FontSize="11"
                                                                                   Foreground="#7FE8D9"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,2,0,0"
                                                                                   Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibility}}" />
                                                                        <TextBlock Text="{Binding Url}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,2,0,0" />
                                                                        <TextBlock Text="{Binding StatusText}"
                                                                                   FontSize="11"
                                                                                   Foreground="#C9D5DE"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,2,0,0" />
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="&#xE768;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Popup>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="HomeContentScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="{Binding Settings.KeepHomeCardRightGap, Converter={StaticResource HomeContentPadding}}"
                                  PreviewMouseDown="HomeContentScrollViewer_PreviewMouseDown"
                                  PreviewMouseMove="HomeContentScrollViewer_PreviewMouseMove"
                                  PreviewMouseUp="HomeContentScrollViewer_PreviewMouseUp"
                                  LostMouseCapture="HomeContentScrollViewer_LostMouseCapture"
                                  ScrollChanged="HomeContentScrollViewer_ScrollChanged">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource HomeScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,18">
                                <Button Style="{StaticResource FollowedHomeSegmentButton}"
                                        Content="Live"
                                        Command="{Binding ShowFollowedHomePageCommand}" />
                                <Button Style="{StaticResource TwitchVodsHomeSegmentButton}"
                                        Content="VODs"
                                        Command="{Binding ShowTwitchVodsHomePageCommand}" />
                                <Button Style="{StaticResource BrowseHomeSegmentButton}"
                                        Content="Browse"
                                        Command="{Binding ShowBrowseHomePageCommand}" />
                                <Button Style="{StaticResource RecentHomeSegmentButton}"
                                        Content="Recent"
                                        Command="{Binding ShowRecentHomePageCommand}" />
                            </StackPanel>

                            <Grid Visibility="{Binding IsFollowedHomePageVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                            <DockPanel LastChildFill="True"
                                       Margin="0,0,0,14">
                                <Border DockPanel.Dock="Right"
                                        Background="#131A23"
                                        BorderBrush="#2A3646"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="9,5"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Top">
                                    <DockPanel LastChildFill="False">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="#3DE47B"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FollowedChannelsStatus}"
                                                   MaxWidth="520"
                                                   FontSize="12"
                                                   Foreground="#DDE3EA"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Live followed channels"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Twitch and Kick"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <ProgressBar Height="4"
                                         IsIndeterminate="True"
                                         Margin="0,0,0,18"
                                         Visibility="{Binding IsFollowedChannelsRefreshing, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel HorizontalAlignment="Center"
                                        MaxWidth="560"
                                        Margin="0,74,0,0"
                                        Visibility="{Binding IsFollowedChannelsEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                <Border Width="58"
                                        Height="58"
                                        Background="#101720"
                                        BorderBrush="#2A3646"
                                        BorderThickness="1"

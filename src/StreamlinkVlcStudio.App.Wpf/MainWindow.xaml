                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TitleBrand" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0" ClipToBounds="True">
                    <Border Width="26"
                            Height="26"
                            Margin="0,0,10,0"
                            Background="{DynamicResource StudioAccentPressedBrush}"
                            CornerRadius="8">
                        <Path Style="{StaticResource StudioBrandMarkStyle}" Width="14" Height="17"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Stream Studio"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StudioTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Width="1"
                            Height="16"
                            Background="{DynamicResource StudioBorderStrongBrush}"
                            Margin="12,0" />
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StudioTextDimBrush}" />
                                <Setter Property="ToolTip" Value="No stream playing" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnyStreamPlaying}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource StudioSuccessBrush}" />
                                        <Setter Property="ToolTip" Value="Stream playing" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Twitch + Kick"
                               FontSize="11"
                               Foreground="{DynamicResource StudioTextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <UniformGrid x:Name="WindowButtons" Grid.Column="1" Rows="1" Width="138"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button Style="{StaticResource TitleBarButton}" Width="Auto"
                            Content="&#xE921;"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeRestoreButton"
                            Width="Auto"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE922;"
                            Click="MaximizeRestoreButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Maximize" />
                    <Button x:Name="CloseWindowButton" Style="{StaticResource TitleBarButton}" Width="Auto"
                            Content="&#xE8BB;"
                            Click="CloseWindowButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close" />
                </UniformGrid>
            </Grid>
        </Border>

        <ScrollViewer x:Name="UpdateBannerViewport"
                      Grid.Row="2" Grid.ColumnSpan="2" Panel.ZIndex="100"
                      VerticalAlignment="Top" Margin="12,8"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Width="{Binding ViewportWidth, ElementName=UpdateBannerViewport}" MinWidth="200"
                    Padding="14,10" CornerRadius="8"
                    Background="{DynamicResource StudioSurfaceCardBrush}"
                    BorderBrush="{DynamicResource StudioAccentBrush}" BorderThickness="1">
                <controls:ResponsiveDockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="{Binding AppUpdateActionText}"
                                Command="{Binding UpdateAppCommand}"
                                Style="{StaticResource StudioPrimaryButtonStyle}" Margin="0,4,8,0" />
                        <Button Content="Later"
                                Command="{Binding LaterUpdateCommand}"
                                Style="{StaticResource StudioButtonStyle}" Margin="0,4,0,0" />
                        <Button Content="Cancel download"
                                Command="{Binding CancelUpdateCommand}"
                                Visibility="{Binding CanCancelUpdate, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource StudioButtonStyle}" Margin="8,4,0,0" />
                    </WrapPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,4">
                        <TextBlock Text="Application update" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AppUpdateStatus}"
                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ResponsiveDockPanel>
            </Border>
        </ScrollViewer>

        <DockPanel x:Name="PlaybackHost"
                   Grid.Row="2"
                   Background="{StaticResource VideoBlackBrush}">
            <DockPanel.Style>
                <Style TargetType="{x:Type DockPanel}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <Border x:Name="DockedChatPanel"
                    DockPanel.Dock="Right"
                    Width="{Binding Settings.Chat.DockWidth}"
                    MinWidth="{x:Static settings:ChatSettings.MinimumDockWidth}"
                    MaxWidth="{x:Static settings:ChatSettings.MaximumDockWidth}"
                    Background="{DynamicResource StudioSurface0Brush}"
                    BorderBrush="{DynamicResource StudioBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Opacity="{Binding Settings.Chat.Opacity}"
                    PreviewMouseWheel="DockedChatPanel_PreviewMouseWheel"
                    Visibility="{Binding IsDockedChatVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer x:Name="DockedChatViewport" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <Grid Width="{Binding ViewportWidth, ElementName=DockedChatViewport}"
                      Height="{Binding ViewportHeight, ElementName=DockedChatViewport}"
                      MinWidth="180" MinHeight="138">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="58" />
                    </Grid.RowDefinitions>
                    <Thumb x:Name="DockedChatResizeThumb"
                           Grid.RowSpan="3"
                           Width="8"
                           HorizontalAlignment="Left"
                           Cursor="SizeWE"
                           DragDelta="DockedChatResizeThumb_DragDelta"
                           Panel.ZIndex="10"
                           AutomationProperties.Name="Resize docked chat">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Grid Background="Transparent">
                                    <Border x:Name="ResizeCue"
                                            Width="2"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource StudioTextMutedBrush}"
                                            Opacity="0" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ResizeCue" Property="Opacity" Value="0.55" />
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="ResizeCue" Property="Opacity" Value="0.9" />
                                        <Setter TargetName="ResizeCue" Property="Background" Value="{DynamicResource StudioAccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Border Grid.Row="0"
                            Margin="12,10,12,6"
                            Padding="10,0"
                            Background="{DynamicResource StudioSurface1Brush}"
                            BorderBrush="{DynamicResource StudioBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource StudioSuccessSubtleBrush}"
                                        BorderBrush="{DynamicResource StudioSuccessBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedTab.ChatModeText}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource StudioSuccessBrush}" />
                                </Border>
                                <TextBlock Text="{Binding SelectedTab.DockedChatHeaderText}"
                                           ToolTip="{Binding SelectedTab.DockedChatHeaderText}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="DockedReplayChatStatus"
                                       Text="{Binding SelectedTab.ReplayChatStatusText}"
                                       Visibility="{Binding SelectedTab.HasReplayChatStatus, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="{DynamicResource StudioTextMutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,6,0,6" />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="DockedChatListBox"
                             Grid.Row="1"
                             Tag="{Binding IsMouseOver, ElementName=DockedChatPanel}"
                             PreviewMouseWheel="ChatListBox_PreviewMouseWheel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             HorizontalContentAlignment="Stretch"
                             Padding="14,8">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Style.Triggers>
                                    <!-- Keep history in the tab, but create WPF rows and decode their
                                         emotes only while this panel is actually on screen. -->
                                    <Trigger Property="IsVisible" Value="True">
                                        <Setter Property="ItemsSource" Value="{Binding SelectedTab.DockedChatFeedItems}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DockedChatScrollBarStyle}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <DockPanel Grid.Row="2" Margin="12,6,12,12" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="Send" Style="{StaticResource StudioPrimaryButtonStyle}"
                                Command="{Binding SelectedTab.SendChatMessageCommand}"
                                Padding="12,6"
                                MinWidth="62"
                                Margin="8,0,0,0" />
                        <TextBox x:Name="ChatInputTextBox"
                                 Text="{Binding SelectedTab.OutgoingChatText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="ChatInputTextBox_KeyDown"
                                 AutomationProperties.Name="Chat message"
                                 ToolTip="Chat message" />
                    </DockPanel>
                </Grid>
                </ScrollViewer>
            </Border>

            <Grid x:Name="VideoAndReplayHost">

            <!-- Transient volume OSD shown on scroll-wheel volume changes (reusable control). -->
            <controls:VolumeOverlay x:Name="VolumeOsd" />

            <Grid x:Name="VideoViewport"
                  Grid.Row="0"
                  Background="{StaticResource VideoBlackBrush}"
                  ClipToBounds="True"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  PreviewMouseLeftButtonDown="VideoViewport_PreviewMouseLeftButtonDown">
                <ItemsControl ItemsSource="{Binding VideoTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VideoSurfaceGridPanel Rows="{Binding DataContext.VideoGridRows, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            Columns="{Binding DataContext.VideoGridColumns, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                            <Setter Property="Grid.Row" Value="{Binding VideoGridRow}" />
                            <Setter Property="Grid.Column" Value="{Binding VideoGridColumn}" />
                            <Setter Property="Grid.RowSpan" Value="{Binding VideoGridRowSpan}" />
                            <Setter Property="Grid.ColumnSpan" Value="{Binding VideoGridColumnSpan}" />
                            <Setter Property="controls:VideoSurfaceGridPanel.AspectRatio" Value="{Binding VideoAspectRatio}" />
                            <Setter Property="Panel.ZIndex" Value="0" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVideoVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Panel.ZIndex" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="SurfaceHost" Background="Black">
                                <TextBlock Text="VOD finished" Foreground="White" FontSize="30" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                                           Visibility="{Binding IsVodFinished, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="480" Margin="24">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecoveringLivePlayback}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <controls:VideoSurfacePresenter x:Name="PlayerSurface"
                                                                Tab="{Binding}"
                                                                SurfaceLoaded="VideoSurface_Loaded"
                                                                SurfaceUnloaded="VideoSurface_Unloaded"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                Tag="{Binding}">
                                    <controls:VideoSurfacePresenter.Style>
                                        <Style TargetType="{x:Type controls:VideoSurfacePresenter}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVideoVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRecoveringLivePlayback}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsVodFinished}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:VideoSurfacePresenter.Style>
                                </controls:VideoSurfacePresenter>
                                <controls:ReplaySeekOverlay>
                                    <controls:ReplaySeekOverlay.Style>
                                        <Style TargetType="controls:ReplaySeekOverlay">
                                            <Setter Property="PlacementTarget" Value="{Binding ElementName=PlayerSurface, Path=Surface}" />
                                            <Setter Property="IsOverlayEnabled" Value="{Binding DataContext.IsReplaySeekBarUiVisible, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVodFinished}" Value="True">
                                                    <Setter Property="PlacementTarget" Value="{Binding ElementName=SurfaceHost}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="IsOverlayEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:ReplaySeekOverlay.Style>
                                </controls:ReplaySeekOverlay>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer x:Name="HomeViewport"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVisibility}}">
                <controls:ResponsiveGrid x:Name="HomeShell" CompactWidth="1020" CompactHeight="440" Background="{DynamicResource StudioBaseBrush}"
                      Width="{Binding ViewportWidth, ElementName=HomeViewport}"
                      Height="{Binding ViewportHeight, ElementName=HomeViewport}"
                      MinWidth="180"
                      MinHeight="120">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="LibraryRail" Grid.RowSpan="2" Width="224" Padding="16,28,16,20"
                            Background="{DynamicResource StudioSurface0Brush}" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=HomeShell}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Bottom">
                                <Border Height="1" Background="{DynamicResource StudioBorderBrush}" Margin="8,0,8,16" />
                                <Button Style="{StaticResource StudioRailButton}" Content="Settings" Tag="{StaticResource StudioIconSettings}"
                                        Command="{Binding ToggleSettingsCommand}" AutomationProperties.Name="Open settings" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="YOUR LIBRARY" Style="{StaticResource StudioEyebrow}" FontSize="10" Margin="12,0,0,18" />
                                <Button Content="Following" Style="{StaticResource StudioRailLive}" Command="{Binding ShowFollowedHomePageCommand}" />
                                <Button Content="Discover" Style="{StaticResource StudioRailBrowse}" Command="{Binding ShowBrowseHomePageCommand}" />
                                <Button Content="Past broadcasts" Style="{StaticResource StudioRailVods}" Command="{Binding ShowTwitchVodsHomePageCommand}" />
                                <Button Content="Downloads" Style="{StaticResource StudioRailDownloads}" Command="{Binding ShowDownloadsHomePageCommand}"
                                        AutomationProperties.Name="Downloaded VOD library" />
                                <Button Content="Recently watched" Style="{StaticResource StudioRailRecent}" Command="{Binding ShowRecentHomePageCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="HomeHeader" Grid.Column="1" Grid.Row="0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource StudioBorderBrush}"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="24,20,24,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=HomeShell}" Value="True">
                                        <Setter Property="Margin" Value="12,16,12,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:ResponsiveGrid x:Name="HomeHeaderLayout" CompactWidth="700">
                            <controls:ResponsiveGrid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </controls:ResponsiveGrid.RowDefinitions>
                            <controls:ResponsiveGrid.ColumnDefinitions>
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </controls:ResponsiveGrid.ColumnDefinitions>

                            <Grid x:Name="HomeSearchAnchor"
                                  Grid.Row="1" Grid.Column="1"
                                  MinWidth="0"
                                  Height="44"
                                  Margin="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  PreviewMouseDown="HomeSearchAnchor_PreviewMouseDown">
                                <TextBox x:Name="HomeStreamSearchTextBox"
                                         Style="{StaticResource HomeSearchTextBoxStyle}"
                                         Height="44" MinHeight="44" Padding="42,0,44,0" FontSize="13"
                                         Text="{Binding NewStreamText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="StreamSearchTextBox_KeyDown"
                                         GotKeyboardFocus="HomeStreamSearchTextBox_GotKeyboardFocus"
                                         AutomationProperties.Name="Streamer search"
                                         AutomationProperties.HelpText="Search a channel or URL. Use the arrow keys to choose a result."
                                         ToolTip="Twitch or Kick channel name or URL" />
                                <Path Style="{StaticResource StudioLineIcon}" Data="{StaticResource StudioIconSearch}"
                                      Width="16" Height="16" Stroke="{DynamicResource StudioTextMutedBrush}"
                                      Margin="16,0,0,0" HorizontalAlignment="Left" />
                                <TextBlock Text="Search channels or paste a stream link"
                                           Foreground="{DynamicResource StudioTextPlaceholderBrush}"
                                           IsHitTestVisible="False"
                                           Margin="40,0,44,0" FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsNewStreamSearchPlaceholderVisible, Converter={StaticResource BoolToVisibility}}" />
                                <Button x:Name="ClearHomeSearchButton" Content="&#xE711;"
                                        Style="{StaticResource StudioQuietIconButton}"
                                        Click="ClearHomeSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,10,0" ToolTip="Clear search" AutomationProperties.Name="Clear search"
                                        Visibility="{Binding HasNewStreamSearchText, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <Border Grid.Row="1" Grid.Column="2"
                                    Background="Transparent"
                                    Padding="0"
                                    Margin="18,0,0,0"
                                    Visibility="{Binding IsFollowedHomePageSelected, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding FollowedChannelsLastUpdatedText}"
                                               Foreground="{DynamicResource StudioTextMutedBrush}"
                                               FontSize="10"
                                               MaxWidth="140"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompact, ElementName=HomeHeaderLayout}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Style="{StaticResource HomeRefreshButton}"
                                            Command="{Binding RefreshFollowedChannelsCommand}"
                                            AutomationProperties.Name="Refresh followed channels"
                                            ToolTip="Refresh followed channels">
                                        <Path Style="{StaticResource StudioLineIcon}" Data="{StaticResource StudioIconRefresh}" Width="15" Height="15"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </DockPanel>
                            </Border>
                            <Popup x:Name="HomeStreamSearchPopup"
                                       Grid.ColumnSpan="3"
                                       PlacementTarget="{Binding ElementName=HomeSearchAnchor}"
                                       Placement="Bottom"
                                       VerticalOffset="8"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       StaysOpen="True"
                                       PreviewKeyDown="HomeSearchPopup_PreviewKeyDown"
                                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                       IsOpen="{Binding IsStreamSearchPanelVisible, Mode=OneWay}">
                                    <Border Width="{Binding ActualWidth, ElementName=HomeSearchAnchor}"
                                            MinWidth="240"
                                            MaxWidth="560"
                                            MaxHeight="360"
                                            Background="{DynamicResource StudioSurface1Brush}"
                                            BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="8"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20"
                                                              ShadowDepth="4"
                                                              Opacity="0.25"
                                                              Color="#000000" />
                                        </Border.Effect>
                                        <Grid x:Name="HomeSearchPopupContent">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0"
                                                       LastChildFill="True"
                                                       Margin="4,2,4,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StreamSearchResultsTitle}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource StudioTextBrush}" />
                                                    <controls:EmojiTextBlock SourceText="{Binding StreamSearchStatus}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource StudioTextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>

                                            <ProgressBar Grid.Row="1"
                                                         Height="3"
                                                         IsIndeterminate="True"
                                                         Margin="4,0,4,8"
                                                         Visibility="{Binding IsStreamSearchRunning, Converter={StaticResource BoolToVisibility}}" />

                                            <Border Grid.Row="2"
                                                    Background="{DynamicResource StudioBaseBrush}"
                                                    BorderBrush="{DynamicResource StudioBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12"
                                                    Margin="0,0,0,2"
                                                    Visibility="{Binding IsStreamSearchEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel LastChildFill="True">
                                                    <Border Width="34"
                                                            Height="34"
                                                            Background="{DynamicResource StudioSurface1Brush}"
                                                            BorderBrush="{DynamicResource StudioBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE721;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="15"
                                                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="No playable streams found"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StudioTextBrush}" />
                                                        <TextBlock Text="{Binding StreamSearchStatus}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <ScrollViewer Grid.Row="2"
                                                          MaxHeight="272"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding IsStreamSearchResultsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource HomeScrollBarStyle}" />
                                                </ScrollViewer.Resources>
                                                <ItemsControl x:Name="HomeSearchResults" ItemsSource="{Binding StreamSearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding OpenCommand}"
                                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                                    PreviewMouseDown="HomeStreamItemButton_PreviewMouseDown"
                                                                    Margin="0,0,0,6"
                                                                    Padding="0"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Background="{DynamicResource StudioSurfaceCardBrush}"
                                                                    BorderBrush="{DynamicResource StudioBorderBrush}"
                                                                    BorderThickness="1">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">

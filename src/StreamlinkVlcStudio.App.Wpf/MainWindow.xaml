<Window x:Class="StreamlinkVlcStudio.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StreamlinkVlcStudio.App.Wpf.Controls"
        xmlns:converters="clr-namespace:StreamlinkVlcStudio.App.Wpf.Converters"
        xmlns:models="clr-namespace:StreamlinkVlcStudio.Core.Models;assembly=StreamlinkVlcStudio.Core"
        xmlns:settings="clr-namespace:StreamlinkVlcStudio.Core.Settings;assembly=StreamlinkVlcStudio.Core"
        xmlns:vm="clr-namespace:StreamlinkVlcStudio.App.Wpf.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Twitch &amp; Kick player"
        Icon="/StreamlinkVlcStudio.App.Wpf;component/Assets/Twitch.ico"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        Background="{DynamicResource StudioBaseBrush}"
        Foreground="{DynamicResource StudioTextBrush}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/StudioTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:HomeContentPaddingConverter x:Key="HomeContentPadding" />

        <DataTemplate DataType="{x:Type vm:DockedChatMessageFeedItem}">
            <controls:DockedChatMessageTextBlock Message="{Binding Message}"
                                                 ChatFontSize="{Binding DataContext.Settings.Chat.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Margin="0,0,0,8" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TwitchPredictionFeedItemViewModel}">
            <Border Margin="0,0,0,8"
                    Padding="10"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource StudioSurface2Brush}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding StatusText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,8" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding TotalText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding TimingText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Outcomes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,5"
                                        Padding="8,6"
                                        CornerRadius="5"
                                        Background="{DynamicResource StudioSurfaceCardBrush}"
                                        BorderBrush="{DynamicResource StudioBorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="4"
                                                CornerRadius="2"
                                                Background="{Binding ColorBrush}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding WinnerText}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding TopPredictorsText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasTopPredictors, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PointsText}"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding UsersText}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,5,0,0"
                          Visibility="{Binding IsResolveSelectorVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Outcomes}"
                                  SelectedItem="{Binding SelectedWinningOutcome, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  MinHeight="28" />
                        <Button Grid.Column="1"
                                Content="Resolve"
                                Command="{Binding ResolveCommand}"
                                MinWidth="72"
                                Margin="8,0,0,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Visibility="{Binding IsManageVisible, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Lock"
                                Command="{Binding LockCommand}"
                                MinWidth="58" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                MinWidth="64"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource StudioSurface1Color}" />
        <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource StudioBorderColor}" />
        <SolidColorBrush x:Key="VideoBlackBrush" Color="#000000" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource StudioAccentColor}" />
        <SolidColorBrush x:Key="TopControlSelectedBackgroundBrush" Color="{DynamicResource StudioAccentPressedColor}" />
        <SolidColorBrush x:Key="TopControlSelectedForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TopControlUnavailableBackgroundBrush" Color="{DynamicResource StudioDisabledColor}" />
        <SolidColorBrush x:Key="TopControlUnavailableBorderBrush" Color="{DynamicResource StudioDisabledBorderColor}" />
        <SolidColorBrush x:Key="SelectedTabBrush" Color="{DynamicResource StudioAccentPressedColor}" />
        <SolidColorBrush x:Key="SelectedTabBorderBrush" Color="{DynamicResource StudioFocusColor}" />
        <SolidColorBrush x:Key="SelectedTabMutedTextBrush" Color="{DynamicResource StudioTextMutedColor}" />
        <SolidColorBrush x:Key="StreamInactiveBrush" Color="{DynamicResource StudioDangerColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource StudioTextMutedColor}" />
        <Geometry x:Key="TwitchPlatformIconGeometry">M4 5v11a1 1 0 0 0 1 1h2v4l4 -4h5.584c.266 0 .52 -.105 .707 -.293l2.415 -2.414c.187 -.188 .293 -.442 .293 -.708v-8.585a1 1 0 0 0 -1 -1h-14a1 1 0 0 0 -1 1l.001 0 M16 8l0 4 M12 8l0 4</Geometry>
        <Geometry x:Key="KickPlatformIconGeometry">M4 4h5v4h3v-2h2v-2h6v4h-2v2h-2v4h2v2h2v4h-6v-2h-2v-2h-3v4h-5l0 -16</Geometry>
        <Style x:Key="HomePlatformBadgeStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource StudioTwitchSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioTwitchBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ToolTip" Value="{Binding PlatformText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding PlatformText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Platform}" Value="{x:Static models:PlatformKind.Kick}">
                    <Setter Property="Background" Value="{DynamicResource StudioKickSubtleBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StudioKickBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomePlatformIconStyle" TargetType="{x:Type Path}">
            <Setter Property="Data" Value="{StaticResource TwitchPlatformIconGeometry}" />
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="Stroke" Value="{DynamicResource StudioTwitchTextBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Platform}" Value="{x:Static models:PlatformKind.Kick}">
                    <Setter Property="Data" Value="{StaticResource KickPlatformIconGeometry}" />
                    <Setter Property="Stroke" Value="{DynamicResource StudioKickTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DockedChatScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockedChatScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <EventSetter Event="DragStarted" Handler="DockedChatScrollThumb_DragStarted" />
            <EventSetter Event="DragCompleted" Handler="DockedChatScrollThumb_DragCompleted" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{DynamicResource StudioScrollbarBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbPill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource StudioAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource StudioAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockedChatScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,4,3,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="TrackBackground"
                                    Margin="3,5"
                                    Background="{DynamicResource StudioSurface1Brush}"
                                    CornerRadius="3"
                                    Opacity="0" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False"
                                   Margin="3,5"
                                   Opacity="0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource DockedChatScrollBarPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb"
                                           Style="{StaticResource DockedChatScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource DockedChatScrollBarPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="TrackBackground" Property="Margin" Value="5,3" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PART_Track" Property="Margin" Value="5,3" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource StudioSurface3Brush}" />
                                <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                                <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger SourceName="ScrollThumb" Property="IsDragging" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource StudioSurface3Brush}" />
                                <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                                <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Background" Value="{DynamicResource StudioTextDimBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbPill"
                                Margin="2,0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbPill" Property="Background" Value="#6E7D90" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource StudioAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,6,4,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="TrackBackground"
                                    Margin="3,7"
                                    Background="{DynamicResource StudioSurface1Brush}"
                                    CornerRadius="4"
                                    Opacity="0.78" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False"
                                   Margin="2,7">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource DockedChatScrollBarPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource HomeScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource DockedChatScrollBarPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="14" />
                                <Setter Property="MinHeight" Value="14" />
                                <Setter TargetName="TrackBackground" Property="Margin" Value="7,3" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PART_Track" Property="Margin" Value="7,2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="#15202B" />
                                <Setter TargetName="TrackBackground" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource StudioButtonStyle}" />

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="TopHomeButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource StudioSurface1Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource StudioSurfaceHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHomeSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeProfileAvatarStyle" TargetType="{x:Type controls:RoundedClipBorder}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource StudioSurface0Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="HomeRefreshButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource StudioSurface1Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource StudioSurface3Brush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeSegmentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource StudioSurface0Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource StudioSurfaceHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FollowedHomeSegmentButton" TargetType="Button" BasedOn="{StaticResource HomeSegmentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFollowedHomePageSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TwitchVodsHomeSegmentButton" TargetType="Button" BasedOn="{StaticResource HomeSegmentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTwitchVodsHomePageSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecentHomeSegmentButton" TargetType="Button" BasedOn="{StaticResource HomeSegmentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecentHomePageSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrowseHomeSegmentButton" TargetType="Button" BasedOn="{StaticResource HomeSegmentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBrowseHomePageSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VodFilterButton" TargetType="Button" BasedOn="{StaticResource HomeSegmentButton}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PastBroadcastsVodFilterButton" TargetType="Button" BasedOn="{StaticResource VodFilterButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPastBroadcastsVodFilterSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />

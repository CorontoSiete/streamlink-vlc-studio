                                                Visibility="{Binding IsBrowseStreamsEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                        <Border Width="58"
                                                Height="58"
                                                Background="#101720"
                                                BorderBrush="#2A3646"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,16">
                                            <TextBlock Text="&#xE7F4;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="No live streams found"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding BrowseStatus}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding BrowseStreams}"
                                                  ItemsPanel="{StaticResource HomeCardItemsPanel}"
                                                  Visibility="{Binding HasBrowseStreams, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource HomeCardButton}"
                                                        Command="{Binding OpenCommand}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="174" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0"
                                                                Background="#07090D"
                                                                CornerRadius="8,8,0,0"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="&#xE7F4;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="30"
                                                                           Foreground="#526071"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <controls:AnimatedEmoteImage ImageUrl="{Binding ThumbnailUrl}"
                                                                                             MaxImageBytes="8388608"
                                                                                             Stretch="UniformToFill" />
                                                                <Border VerticalAlignment="Bottom"
                                                                        Height="72">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#00101419" Offset="0" />
                                                                            <GradientStop Color="#D0080B0F" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <Border HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Margin="11"
                                                                        Style="{StaticResource HomePlatformBadgeStyle}">
                                                                    <Viewbox Width="16"
                                                                             Height="16"
                                                                             VerticalAlignment="Center"
                                                                             HorizontalAlignment="Center">
                                                                        <Path Style="{StaticResource HomePlatformIconStyle}" />
                                                                    </Viewbox>
                                                                </Border>
                                                                <Border HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="11"
                                                                        Padding="8,4"
                                                                        CornerRadius="6"
                                                                        Background="#D40C2118"
                                                                        BorderBrush="#3DE47B"
                                                                        BorderThickness="1">
                                                                    <DockPanel LastChildFill="False">
                                                                        <Ellipse Width="6"
                                                                                 Height="6"
                                                                                 Fill="#3DE47B"
                                                                                 Margin="0,0,6,0"
                                                                                 VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding ViewerCountText}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold" />
                                                                    </DockPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <Grid Grid.Row="1"
                                                              Margin="14,12,14,14">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0"
                                                                       Text="{Binding DisplayName}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Title}"
                                                                       FontSize="12"
                                                                       Foreground="#DDE3EA"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="38"
                                                                       Margin="0,6,0,0" />
                                                            <DockPanel Grid.Row="2"
                                                                       LastChildFill="True"
                                                                       Margin="0,10,0,0">
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="&#xE768;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontSize="12"
                                                                           Margin="10,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding MetadataText}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Load More Streams"
                                            Command="{Binding LoadMoreBrowseStreamsCommand}"
                                            HorizontalAlignment="Center"
                                            MinWidth="164"
                                            Margin="0,6,0,18"
                                            Visibility="{Binding IsBrowseStreamLoadMoreVisible, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsRecentHomePageVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True"
                                               Margin="0,0,0,14">
                                        <Border DockPanel.Dock="Right"
                                                Background="#131A23"
                                                BorderBrush="#2A3646"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="9,5"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding RecentStreamsStatus}"
                                                       MaxWidth="260"
                                                       FontSize="12"
                                                       Foreground="#DDE3EA"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Recent streams"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Watched through Twitch &amp; Kick player"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <StackPanel HorizontalAlignment="Center"
                                                MaxWidth="560"
                                                Margin="0,74,0,0"
                                                Visibility="{Binding IsRecentStreamsEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                        <Border Width="58"
                                                Height="58"
                                                Background="#101720"
                                                BorderBrush="#2A3646"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,16">
                                            <TextBlock Text="&#xE823;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="No recent streams"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="No successful playback history in this settings file."
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding RecentStreams}"
                                                  Visibility="{Binding HasRecentStreams, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource RecentStreamButton}"
                                                            Command="{Binding OpenCommand}">
                                                    <Grid Margin="14,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="116"
                                                                Height="66"
                                                                Background="#07090D"
                                                                BorderBrush="#263241"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                ClipToBounds="True"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <Grid>
                                                                <TextBlock Text="&#xE7F4;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="20"
                                                                           Foreground="#526071"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <controls:AnimatedEmoteImage ImageUrl="{Binding ThumbnailUrl}"
                                                                                             MaxImageBytes="8388608"
                                                                                             Stretch="UniformToFill" />
                                                                <Border HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top"
                                                                        Margin="6"
                                                                        Style="{StaticResource HomePlatformBadgeStyle}">
                                                                    <Viewbox Width="16"
                                                                             Height="16"
                                                                             VerticalAlignment="Center"
                                                                             HorizontalAlignment="Center">
                                                                        <Path Style="{StaticResource HomePlatformIconStyle}" />
                                                                    </Viewbox>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="14,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Url}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <DockPanel Grid.Column="2"
                                                                   LastChildFill="False"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE768;"
                                                                       DockPanel.Dock="Right"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel DockPanel.Dock="Right"
                                                                        Margin="0,0,14,0"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Right">
                                                                <Border Padding="8,3"
                                                                        CornerRadius="7"
                                                                        HorizontalAlignment="Right"
                                                                        ToolTip="{Binding LiveStatusToolTip}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#151C25" />
                                                                            <Setter Property="BorderBrush" Value="#3A4655" />
                                                                            <Setter Property="BorderThickness" Value="1" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding LiveStatusKey}" Value="Live">
                                                                                    <Setter Property="Background" Value="#153A25" />
                                                                                    <Setter Property="BorderBrush" Value="#3DE47B" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding LiveStatusKey}" Value="Offline">
                                                                                    <Setter Property="Background" Value="#32181E" />
                                                                                    <Setter Property="BorderBrush" Value="#F45B69" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding LiveStatusKey}" Value="Checking">
                                                                                    <Setter Property="Background" Value="#182840" />
                                                                                    <Setter Property="BorderBrush" Value="#6AA7FF" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="7"
                                                                                 Height="7"
                                                                                 Margin="0,0,6,0"
                                                                                 VerticalAlignment="Center">
                                                                            <Ellipse.Style>
                                                                                <Style TargetType="Ellipse">
                                                                                    <Setter Property="Fill" Value="#8A94A6" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding LiveStatusKey}" Value="Live">
                                                                                            <Setter Property="Fill" Value="#4ADE80" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding LiveStatusKey}" Value="Offline">
                                                                                            <Setter Property="Fill" Value="#F45B69" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding LiveStatusKey}" Value="Checking">
                                                                                            <Setter Property="Fill" Value="#6AA7FF" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Ellipse.Style>
                                                                        </Ellipse>
                                                                        <TextBlock Text="{Binding LiveStatusText}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#F2F5F8" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Text="{Binding MetadataText}"
                                                                           FontSize="12"
                                                                           Foreground="#DDE3EA"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="240"
                                                                           HorizontalAlignment="Right"
                                                                           Margin="0,5,0,0" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Grid>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource RecentStreamDeleteButton}"
                                                            Content="&#xE74D;"
                                                            Command="{Binding DeleteCommand}"
                                                            ToolTip="{Binding DeleteToolTip}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsSelectedTabDetached, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="This tab is in picture-in-picture"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Use the dock button in the floating window to return it here."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border x:Name="VideoStatusOverlay"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16"
                        Padding="10,7"
                        CornerRadius="6"
                        Background="#AA000000">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.IsVideoVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SelectedTab.StatusText}" />
                        <TextBlock Text="  " />
                        <TextBlock Text="{Binding SelectedTab.Quality}" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

            </Grid>
                <Border Grid.Row="1"
                        Background="#080B0F"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8"
                        Visibility="{Binding IsReplaySeekBarVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid ToolTip="{Binding SelectedTab.ReplaySeekToolTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedTab.ReplayElapsedText}"
                                   Foreground="#F2F7FA"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Margin="0,0,12,0" />
                        <Button Grid.Column="1"
                                Content="-30s"
                                Style="{StaticResource ReplayStepButton}"
                                Command="{Binding SelectedTab.RewindReplay30SecondsCommand}"
                                ToolTip="Rewind 30 seconds" />
                        <Slider x:Name="ReplaySeekSlider"
                                Grid.Column="2"
                                Style="{StaticResource ReplaySeekSliderStyle}"
                                Minimum="0"
                                Maximum="{Binding SelectedTab.ReplaySeekMaximum}"
                                Value="{Binding SelectedTab.ReplaySeekSliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding SelectedTab.CanSeekReplay}"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                PreviewMouseLeftButtonDown="ReplaySeekSlider_BeginPreview"
                                PreviewMouseLeftButtonUp="ReplaySeekSlider_Commit"
                                KeyUp="ReplaySeekSlider_KeyUp"
                                ToolTip="{Binding SelectedTab.ReplaySeekToolTip}" />
                        <Button Grid.Column="3"
                                Content="+30s"
                                Style="{StaticResource ReplayStepButton}"
                                Command="{Binding SelectedTab.FastForwardReplay30SecondsCommand}"
                                ToolTip="Fast forward 30 seconds" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding SelectedTab.ReplayDurationText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextAlignment="Left"
                                   Margin="12,0,0,0" />
                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Border Height="28"
                                    MinWidth="82"
                                    Padding="10,0"
                                    Margin="0,0,8,0"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="#263241"
                                    Background="#111923"
                                    VerticalAlignment="Center">
                                <DockPanel LastChildFill="True">
                                    <Ellipse DockPanel.Dock="Left"
                                             Width="7"
                                             Height="7"
                                             Fill="{StaticResource AccentBrush}"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedTab.ReplayLiveStateText}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               MaxWidth="240"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <Button Content="Live"
                                    Style="{StaticResource ReplayLiveButton}"
                                    Command="{Binding SelectedTab.ReturnToLiveCommand}"
                                    ToolTip="Return to live playback" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <Border x:Name="TopControlsBar"
                Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&#xE80F;"
                        Style="{StaticResource TopHomeButton}"
                        Command="{Binding SelectHomeCommand}"
                        ToolTip="Home"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0" />

                <ListBox x:Name="TabListBox"
                         Grid.Column="1"
                         ItemsSource="{Binding TabStripItems}"
                         SelectedItem="{Binding SelectedTabStripItem}"
                         PreviewMouseWheel="TabListBox_PreviewMouseWheel"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VerticalAlignment="Center"
                         Margin="8,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Panel.ZIndex" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="1" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabChrome"
                                    Margin="2,0"
                                    Padding="7,3"
                                    CornerRadius="8"
                                    BorderBrush="#2A3340"
                                    BorderThickness="1"
                                    Background="#111823"
                                    SnapsToDevicePixels="True"
                                    ToolTip="{Binding ToolTip}"
                                    PreviewMouseLeftButtonDown="TabContent_PreviewMouseLeftButtonDown">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource IconButton}"
                                            Content="&#xE711;"
                                            Width="20"
                                            MinHeight="20"
                                            FontSize="12"
                                            Margin="5,0,0,0"
                                            Tag="{Binding}"
                                            Click="CloseTabButton_Click"
                                            ToolTip="Close tab" />
                                    <StackPanel Width="122">
                                        <TextBlock x:Name="TabTitleTextBox"
                                                   Text="{Binding Title}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Width="122" />
                                        <DockPanel Margin="0,2,0,0" LastChildFill="True">
                                            <Border x:Name="TabViewerCountBox"
                                                    DockPanel.Dock="Right"
                                                    Width="60"
                                                    MinHeight="16"
                                                    Padding="3,1"
                                                    Margin="5,0,0,0"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="#303A48"
                                                    Background="#0D141D"
                                                    ToolTip="{Binding ViewerCountToolTip}">
                                                <DockPanel HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           LastChildFill="False">
                                                    <TextBlock x:Name="TabViewerCountIcon"
                                                               DockPanel.Dock="Left"
                                                               Text="&#xE890;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="9"
                                                               Margin="0,0,3,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TabViewerCountTextBlock"
                                                               Text="{Binding ViewerCountText}"
                                                               DockPanel.Dock="Right"
                                                               VerticalAlignment="Center"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <TextBlock x:Name="TabStatusTextBlock"
                                                       Text="{Binding StatusText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="#101720" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="#3A4656" />
                                    <Setter TargetName="TabViewerCountIcon" Property="Text" Value="&#xE8A9;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="#182231" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="#3B4656" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDetached}" Value="True">
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="TabStatusTextBlock" Property="Text" Value="Picture-in-picture" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SelectedTabBrush}" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource SelectedTabBorderBrush}" />
                                    <Setter TargetName="TabTitleTextBox" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="TabStatusTextBlock" Property="Foreground" Value="{StaticResource SelectedTabMutedTextBrush}" />
                                    <Setter TargetName="TabViewerCountBox" Property="Background" Value="#0D3B23" />
                                    <Setter TargetName="TabViewerCountBox" Property="BorderBrush" Value="{StaticResource SelectedTabBorderBrush}" />
                                    <Setter TargetName="TabViewerCountIcon" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="TabViewerCountTextBlock" Property="Foreground" Value="#FFFFFF" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Column="2"
                           Width="360"
                           Margin="10,0,4,0"
                           LastChildFill="True"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsOverlayChatInputVisible, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right"
                            Content="Send"
                            Command="{Binding SelectedTab.SendChatMessageCommand}"
                            MinWidth="58"
                            Margin="8,0,0,0" />
                    <TextBox Text="{Binding SelectedTab.OutgoingChatText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="ChatInputTextBox_KeyDown"
                             ToolTip="Chat message" />
                </DockPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,14,0">
                    <Button Style="{StaticResource TopControlIconButtonFirst}" Content="&#xE769;" Command="{Binding PauseSelectedCommand}" ToolTip="Pause/resume" />
                    <Button Style="{StaticResource TopControlIconButton}" Content="&#xE72C;" Command="{Binding ReloadSelectedCommand}" ToolTip="Reload stream" />
                    <Button Style="{StaticResource ReplaySeekBarToggleIconButton}"
                            Content="&#xE121;"
                            Command="{Binding ToggleReplaySeekBarCommand}"
                            ToolTip="{Binding ReplaySeekBarToggleToolTip}" />
                    <Button Style="{StaticResource ChatToggleIconButton}"
                            Content="&#xE8F2;"
                            Command="{Binding ToggleChatCommand}"
                            ToolTip="Show/hide chat" />
                    <Button Style="{StaticResource MultiStreamToggleIconButton}"
                            Content="&#xE8A9;"
                            Command="{Binding ToggleMultiStreamCommand}"
                            ToolTip="{Binding MultiStreamToggleToolTip}" />
                    <Button Style="{StaticResource TopControlIconButton}" Content="&#xE740;" Click="FullscreenButton_Click" ToolTip="Fullscreen stream" />
                    <Button Style="{StaticResource TopControlIconButton}" Content="&#xE7F4;" Click="TheatreButton_Click" ToolTip="Theatre mode" />
                    <Button Style="{StaticResource SettingsToggleIconButton}" Content="&#xE713;" Command="{Binding ToggleSettingsCommand}" ToolTip="Settings" />
                    <Button Style="{StaticResource MuteToggleIconButton}" Content="&#xE74F;" ToolTip="Mute" Click="MuteButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SettingsPanel"
                Grid.Column="1"
                Grid.Row="1"
                Grid.RowSpan="2"
                Width="430"
                Background="#F00E1218"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding ToggleSettingsCommand}" ToolTip="Close settings" />
                    </DockPanel>

                    <TextBlock Text="Streamlink executable" Foreground="{StaticResource TextMutedBrush}" />
                    <DockPanel Margin="0,5,0,14">
                        <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseStreamlinkButton_Click" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Settings.StreamlinkPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="VLC directory" Foreground="{StaticResource TextMutedBrush}" />
                    <DockPanel Margin="0,5,0,14">
                        <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseVlcButton_Click" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Settings.VlcDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="Custom Streamlink arguments" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.CustomStreamlinkArguments, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,14"
                             AcceptsReturn="True"
                             MinHeight="68"
                             TextWrapping="Wrap" />

                    <TextBlock Text="Stream quality" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding QualityOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedQuality}"
                              Margin="0,5,0,14" />

                    <CheckBox Content="Low latency options"
                              IsChecked="{Binding Settings.LowLatency}"
                              Foreground="#E8EAED"
                              Margin="0,0,0,10" />
                    <CheckBox Content="Keep inactive tabs running muted"
                              IsChecked="{Binding Settings.KeepInactiveTabsRunning}"
                              Foreground="#E8EAED"
                              Margin="0,0,0,10" />
                    <CheckBox Content="Multi-stream grid"
                              IsChecked="{Binding IsMultiStreamEnabled}"
                              Foreground="#E8EAED"
                              Margin="0,0,0,10" />
                    <CheckBox Content="Keep home card right-side gap"
                              IsChecked="{Binding Settings.KeepHomeCardRightGap}"
                              Foreground="#E8EAED"
                              Margin="0,0,0,16"
                              ToolTip="Leave unused space at the right edge of Live, VOD, and Browse card rows." />

                    <TextBlock Text="Replay" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox Content="Enable platform replay seekbar"
                              IsChecked="{Binding Settings.Replay.Enabled}"
                              Foreground="#E8EAED"
                              Margin="0,0,0,10"
                              ToolTip="Use platform VOD/replay playback when Twitch or Kick exposes a usable current replay." />
                    <CheckBox Content="Try private Kick replay lookup"
                              IsChecked="{Binding Settings.Replay.AttemptPrivateKickReplayResolution}"
                              Foreground="#E8EAED"
                              Margin="0,0,0,16"
                              ToolTip="Best-effort Kick website probing. This can stop working if Kick changes private page data." />

                    <TextBlock Text="Followed channels" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Text="Kick channel slugs" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding KickFollowedChannelsText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,14"
                             AcceptsReturn="True"
                             MinHeight="92"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="One Kick channel slug or channel URL per line. Twitch followed channels use Twitch authorization." />

                    <TextBlock Text="Chat credentials" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Text="Twitch username" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.Chat.TwitchUsername, UpdateSourceTrigger=LostFocus}"
                             Margin="0,5,0,10"
                             ToolTip="Optional; if set, it must match the token login." />

                    <TextBlock Text="Twitch Client ID" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.Chat.TwitchClientId, UpdateSourceTrigger=LostFocus}"
                             Margin="0,5,0,10"
                             ToolTip="Required for Connect Twitch. Client IDs alone do not enable typing in chat. Redirect URL: http://localhost:39178" />

                    <TextBlock Text="Twitch OAuth token" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.Chat.TwitchOAuthToken, UpdateSourceTrigger=LostFocus}"
                             Margin="0,5,0,10"
                             ToolTip="Saved user access token. Connect Twitch requests chat:read, chat:edit, user:read:follows, and channel:manage:predictions. The oauth: or Bearer prefix is optional." />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Connect Twitch"
                                Command="{Binding AuthorizeTwitchCommand}"
                                MinWidth="120"
                                ToolTip="Open Twitch OAuth and save chat and prediction permissions. Redirect URL: http://localhost:39178" />
                        <Button Content="Clear token"
                                Command="{Binding ClearTwitchTokenCommand}"
                                MinWidth="90"
                                Margin="8,0,0,0"
                                ToolTip="Remove the saved Twitch OAuth token." />
                    </StackPanel>

                    <TextBlock Text="Kick username" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.Chat.KickUsername, UpdateSourceTrigger=LostFocus}"
                             Margin="0,5,0,10"
                             ToolTip="Used for local echo after sending." />

                    <TextBlock Text="Kick user access token" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.Chat.KickOAuthToken, UpdateSourceTrigger=LostFocus}"
                             Margin="0,5,0,10"
                             ToolTip="Optional. Only needed for typing in Kick chat; reading Kick chat works anonymously. The Bearer prefix is optional." />

                    <TextBlock Text="Kick Client ID" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.Chat.KickClientId, UpdateSourceTrigger=LostFocus}"
                             Margin="0,5,0,10"
                             ToolTip="Required for Connect Kick. Client credentials alone do not enable typing in chat." />

                    <TextBlock Text="Kick Client Secret" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.Chat.KickClientSecret, UpdateSourceTrigger=LostFocus}"
                             Margin="0,5,0,10"
                             ToolTip="Required for Connect Kick. Saved in settings; treat it as account-sensitive." />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Connect Kick"
                                Command="{Binding AuthorizeKickCommand}"
                                MinWidth="110"
                                ToolTip="Open Kick OAuth and save a chat:write user token. Redirect URL: http://localhost:39177" />
                        <Button Content="Clear token"
                                Command="{Binding ClearKickTokenCommand}"
                                MinWidth="90"
                                Margin="8,0,0,0"
                                ToolTip="Remove the saved Kick access and refresh tokens." />
                    </StackPanel>

                    <CheckBox Content="Send Kick messages as bot"
                              IsChecked="{Binding Settings.Chat.KickSendAsBot}"
                              Foreground="#E8EAED"
                              Margin="0,0,0,16" />

                    <TextBlock Text="Chat appearance" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Text="Chat layout" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding ChatLayoutOptions}"
                              SelectedItem="{Binding Settings.Chat.Layout}"
                              Margin="0,5,0,14" />

                    <TextBlock Text="VLC overlay plugin directory" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding Settings.Chat.VlcOverlayDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,14"
                             ToolTip="Optional custom overlay folder. Leave blank to use the bundled vlc-overlay beside the app." />

                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="Selected stream VLC overlay text size"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="VlcOverlayFontSizeValueText"
                                   DockPanel.Dock="Right"
                                   Text="{Binding SelectedVlcOverlayFontSize, StringFormat={}{0:0} px}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider x:Name="VlcOverlayFontSizeSlider"
                            Minimum="8"
                            Maximum="36"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            IsEnabled="{Binding HasSelectedTab}"
                            Value="{Binding SelectedVlcOverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,14"
                            ToolTip="Text size for the selected stream's native VLC plugin chat overlay." />

                    <StackPanel Visibility="{Binding HasSelectedKickTab, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Selected Kick chatroom ID" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedKickChatroomId, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,5,0,10"
                                 ToolTip="Used when Kick blocks public chatroom discovery." />

                        <TextBlock Text="Selected Kick broadcaster user ID" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedKickBroadcasterUserId, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,5,0,14"
                                 ToolTip="Required when sending Kick chat as a user and automatic lookup fails." />
                    </StackPanel>

                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

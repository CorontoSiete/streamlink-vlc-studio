                                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Exit fullscreen / stop auto-scroll"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="Dismiss the active fullscreen or home scrolling mode."
                                                               Style="{StaticResource SettingsPageDescriptionStyle}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <controls:HotkeyRecorderButton x:Name="DismissFullscreenHotkeyRecorder"
                                                                               Grid.Column="1"
                                                                               Style="{StaticResource HotkeyRecorderButtonStyle}"
                                                                               Gesture="{Binding Settings.Hotkeys.DismissFullscreenOrAutoScroll, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               DefaultGesture="{x:Static settings:HotkeySettings.DefaultDismissFullscreenOrAutoScroll}"
                                                                               Tag="DismissFullscreenOrAutoScroll"
                                                                               GestureChanging="HotkeyRecorder_GestureChanging"
                                                                               ActionName="Exit fullscreen or stop auto-scroll hotkey" />
                                            </controls:ResponsiveColumnsPanel>
                                        </StackPanel>
                                    </Border>
                                </controls:ResponsiveColumnsPanel>
                            </StackPanel>

                            <StackPanel x:Name="AdvancedSettingsPage"
                                        Visibility="{Binding IsAdvancedSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <controls:ResponsiveColumnsPanel>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <ContentControl Content="Playback tools" Tag="{StaticResource StudioIconTools}" Style="{StaticResource StudioSectionHeading}" />
                                            <TextBlock Text="Streamlink executable" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <DockPanel Margin="0,0,0,14">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Browse"
                                                        Click="BrowseStreamlinkButton_Click"
                                                        MinWidth="82"
                                                        Margin="8,0,0,0" />
                                                <TextBox Text="{Binding Settings.StreamlinkPath, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <TextBlock Text="VLC directory" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <DockPanel Margin="0,0,0,14">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Browse"
                                                        Click="BrowseVlcButton_Click"
                                                        MinWidth="82"
                                                        Margin="8,0,0,0" />
                                                <TextBox Text="{Binding Settings.VlcDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <TextBlock Text="Custom Streamlink arguments" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.CustomStreamlinkArguments, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     MinHeight="100"
                                                     TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource SettingsSectionCard}">
                                            <StackPanel>
                                                <ContentControl Content="Updates" Tag="{StaticResource StudioIconRefresh}" Style="{StaticResource StudioSectionHeading}" />
                                                <CheckBox
                                                          IsChecked="{Binding Settings.Updates.AutomaticChecksEnabled}"
                                                          Style="{StaticResource SettingsToggleStyle}"
                                                          Margin="0,0,0,12"
                                                          Content="Check automatically while Stream Studio is open"
                                                          ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                                <CheckBox IsChecked="{Binding Settings.Updates.AutomaticDownloadsEnabled}"
                                                          IsEnabled="{Binding Settings.Updates.AutomaticChecksEnabled}"
                                                          Style="{StaticResource SettingsToggleStyle}"
                                                          Margin="0,0,0,8"
                                                          Content="Download verified updates automatically"
                                                          ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                                <TextBlock Text="For Setup installations. Downloads can be canceled, and you choose when to restart and install."
                                                           Style="{StaticResource SettingsPageDescriptionStyle}"
                                                           Margin="0,0,0,12" />
                                                <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                                        Command="{Binding UpdateAppCommand}"
                                                        MinWidth="156"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,12"
                                                        AutomationProperties.Name="Update from GitHub">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE895;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="13"
                                                                   Margin="0,0,9,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AppUpdateActionText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource StudioButtonStyle}"
                                                        Command="{Binding CheckForUpdatesCommand}"
                                                        Content="Check for updates"
                                                        Visibility="{Binding IsUpdateRefreshVisible, Converter={StaticResource BoolToVisibility}}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,12" />
                                                <Button Style="{StaticResource StudioButtonStyle}"
                                                        Command="{Binding CancelUpdateCommand}"
                                                        Content="Cancel download"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,12"
                                                        Visibility="{Binding CanCancelUpdate, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding AppUpdateStatus}"
                                                           Style="{StaticResource SettingsPageDescriptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsSectionCard}"
                                                Visibility="{Binding HasSelectedKickTab, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <ContentControl Content="Selected Kick stream" Tag="{StaticResource StudioIconLive}" Style="{StaticResource StudioSectionHeading}" />
                                                <TextBlock Text="Chatroom ID" Style="{StaticResource StudioFieldLabelStyle}" />
                                                <TextBox Text="{Binding SelectedKickChatroomId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                                <TextBlock Text="Broadcaster user ID" Style="{StaticResource StudioFieldLabelStyle}" />
                                                <TextBox Text="{Binding SelectedKickBroadcasterUserId, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </controls:ResponsiveColumnsPanel>
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                </Grid>
            </Grid>
            </ScrollViewer>
            </controls:ResponsiveGrid>
        </Border>

    </Grid>
</Window>

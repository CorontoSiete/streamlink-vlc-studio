                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Text="{Binding MetadataText}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource StudioTextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="240"
                                                                           HorizontalAlignment="Right"
                                                                           Margin="0,5,0,0" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </controls:ResponsiveGrid>
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource RecentStreamDeleteButton}"
                                                            Content="&#xE74D;"
                                                            Command="{Binding DeleteCommand}"
                                                            ToolTip="{Binding DeleteToolTip}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </controls:ResponsiveGrid>
                </ScrollViewer>

                <Grid Visibility="{Binding IsSelectedTabDetached, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="This tab is in picture-in-picture"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Use the dock button in the floating window to return it here."
                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

            </Grid>

            </Grid>
        </DockPanel>

        <Border x:Name="TopControlsBar"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Grid.Row="1"
                Background="{DynamicResource StudioSurface0Brush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="0,0,0,1">
            <controls:ResponsiveGrid x:Name="TopControlLayout" CompactWidth="700">
                <Grid.RowDefinitions>
                    <RowDefinition Height="53" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="WorkspaceNavigation" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TabStripItems.Count}" Value="0" />
                                        <Condition Binding="{Binding IsHomeSelected}" Value="True" />
                                        <Condition Binding="{Binding IsCompact, ElementName=HomeShell}" Value="False" />
                                        <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Width" Value="208" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TabStripItems.Count}" Value="0" />
                                        <Condition Binding="{Binding IsSettingsOpen}" Value="True" />
                                        <Condition Binding="{Binding IsCompact, ElementName=SettingsLayout}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Width" Value="208" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button x:Name="WorkspaceBackButton" Style="{StaticResource StudioQuietIconButton}"
                            Width="30" Height="30" Margin="0,0,6,0" Command="{Binding GoBackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Back to previous page" AutomationProperties.Name="Back to previous page">
                        <Path Style="{StaticResource StudioLineIcon}" Data="{StaticResource StudioIconBack}" Width="15" Height="15"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource TopHomeButton}"
                            Command="{Binding SelectHomeCommand}"
                            ToolTip="Home"
                            AutomationProperties.Name="Home">
                        <Path Style="{StaticResource StudioLineIcon}" Data="{StaticResource StudioIconHome}" Width="15" Height="15"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="WorkspacePageContext" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,16,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TabStripItems.Count}" Value="0" />
                                        <Condition Binding="{Binding IsHomeSelected}" Value="True" />
                                        <Condition Binding="{Binding IsCompact, ElementName=HomeShell}" Value="False" />
                                        <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TabStripItems.Count}" Value="0" />
                                        <Condition Binding="{Binding IsSettingsOpen}" Value="True" />
                                        <Condition Binding="{Binding IsCompact, ElementName=SettingsLayout}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Following" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBrowseHomePageSelected}" Value="True"><Setter Property="Text" Value="Discover" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsTwitchVodsHomePageSelected}" Value="True"><Setter Property="Text" Value="Past broadcasts" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsDownloadsHomePageSelected}" Value="True"><Setter Property="Text" Value="Downloads" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsRecentHomePageSelected}" Value="True"><Setter Property="Text" Value="Recently watched" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="Text" Value="{Binding SelectedSettingsCategory}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ToolBar x:Name="HomeNavigation"
                            VerticalAlignment="Center"
                            Margin="10,0">
                    <ToolBar.Style>
                        <Style TargetType="ToolBar" BasedOn="{StaticResource ResponsiveToolBar}">
                            <Setter Property="Grid.Column" Value="2" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHomeSelected}" Value="True" />
                                        <Condition Binding="{Binding IsCompact, ElementName=HomeShell}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TabStripItems.Count}" Value="0">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToolBar.Style>
                    <Button Style="{StaticResource FollowedHomeSegmentButton}"
                            Content="Live"
                            Command="{Binding ShowFollowedHomePageCommand}" />
                    <Button Style="{StaticResource TwitchVodsHomeSegmentButton}"
                            Content="VODs"
                            Command="{Binding ShowTwitchVodsHomePageCommand}" />
                    <Button Content="Downloads" Command="{Binding ShowDownloadsHomePageCommand}"
                            AutomationProperties.Name="Open downloaded VODs">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HomeSegmentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloadsHomePageSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource BrowseHomeSegmentButton}"
                            Content="Browse"
                            Command="{Binding ShowBrowseHomePageCommand}" />
                    <Button Style="{StaticResource RecentHomeSegmentButton}"
                            Content="Recent"
                            Command="{Binding ShowRecentHomePageCommand}" />
                </ToolBar>

                <DockPanel Margin="8,0" VerticalAlignment="Center">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Grid.Column" Value="1" />
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=TopControlLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TabStripItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHomeSelected}" Value="True" />
                                        <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}"
                            Margin="4,0,0,0"
                            Tag="{Binding SelectedTabStripItem}" Click="CloseTabButton_Click"
                            ToolTip="Close selected tab" AutomationProperties.Name="Close selected tab" />
                    <ComboBox x:Name="CompactTabSelector" MinWidth="0" MinHeight="0" Height="34" Padding="4,0"
                              ItemsSource="{Binding TabStripItems}" SelectedItem="{Binding SelectedTabStripItem}"
                              FontSize="11"
                              AutomationProperties.Name="Stream tabs">
                        <ComboBox.ToolTip>
                            <ToolTip Content="{Binding PlacementTarget.DataContext.SelectedTabStripItem.ToolTip, RelativeSource={RelativeSource Self}}"
                                     ContentTemplate="{StaticResource StreamDetailsToolTipTemplate}" />
                        </ComboBox.ToolTip>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="TabNeverMuteIcon" DockPanel.Dock="Right"
                                               Style="{StaticResource NeverMuteTabIndicator}" />
                                    <controls:EmojiTextBlock SourceText="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}" Value="True">
                                        <Setter TargetName="TabNeverMuteIcon" Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>

                <ListBox x:Name="TabListBox"
                         ItemsSource="{Binding TabStripItems}"
                         SelectedItem="{Binding SelectedTabStripItem}"
                         PreviewMouseWheel="TabListBox_PreviewMouseWheel"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center"
                          Margin="8,0">
                    <ListBox.Style>
                        <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Grid.Column" Value="1" />
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHomeSelected}" Value="True" />
                                        <Condition Binding="{Binding IsCompact, ElementName=HomeShell}" Value="True" />
                                        <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=TopControlLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHomeSelected}" Value="True" />
                                        <Condition Binding="{Binding TabStripItems.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Panel.ZIndex" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="1" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabChrome"
                                    Margin="2,0"
                                    Padding="7,3"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource StudioBorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource StudioSurface1Brush}"
                                    SnapsToDevicePixels="True"
                                    PreviewMouseLeftButtonDown="TabContent_PreviewMouseLeftButtonDown">
                                <Border.ToolTip>
                                    <ToolTip Content="{Binding PlacementTarget.DataContext.ToolTip, RelativeSource={RelativeSource Self}}"
                                             ContentTemplate="{StaticResource StreamDetailsToolTipTemplate}" />
                                </Border.ToolTip>
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="TabCloseControl"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource TabCloseButton}"
                                            Margin="5,0,0,0"
                                            Tag="{Binding}"
                                            Click="CloseTabButton_Click"
                                            ToolTip="Close tab" />
                                    <controls:RoundedClipBorder DockPanel.Dock="Left"
                                                                Width="22"
                                                                Height="22"
                                                                CornerRadius="11"
                                                                ClipToBounds="True"
                                                                Background="{DynamicResource StudioSurface0Brush}"
                                                                BorderBrush="{DynamicResource StudioBorderBrush}"
                                                                BorderThickness="1"
                                                                Margin="0,0,8,0"
                                                                DataContext="{Binding ProfileImageUrl}"
                                                                VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock x:Name="ProfileAvatarPlaceholder" Text="&#xE77B;" Visibility="Collapsed"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource StudioTextDimBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <controls:AnimatedEmoteImage x:Name="ProfileAvatarImage" ImageUrl="{Binding}"
                                                                         MaxImageBytes="8388608"
                                                                         Stretch="UniformToFill" />
                                        </Grid>
                                    </controls:RoundedClipBorder>
                                    <StackPanel Width="122">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock x:Name="TabNeverMuteIcon" DockPanel.Dock="Right"
                                                       Style="{StaticResource NeverMuteTabIndicator}" />
                                            <controls:EmojiTextBlock x:Name="TabTitleTextBox"
                                                       SourceText="{Binding Title}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DockPanel Margin="0,2,0,0" LastChildFill="True">
                                            <Border x:Name="TabViewerCountBox"
                                                    DockPanel.Dock="Right"
                                                    Width="60"
                                                    MinHeight="16"
                                                    Padding="3,1"
                                                    Margin="5,0,0,0"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                                                    Background="{DynamicResource StudioSurfaceCardBrush}"
                                                    ToolTip="{Binding ViewerCountToolTip}">
                                                <DockPanel HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           LastChildFill="False">
                                                    <TextBlock x:Name="TabViewerCountIcon"
                                                               DockPanel.Dock="Left"
                                                               Text="&#xE890;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="9"
                                                               Margin="0,0,3,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TabViewerCountTextBlock"
                                                               Text="{Binding ViewerCountText}"
                                                               DockPanel.Dock="Right"
                                                               VerticalAlignment="Center"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <TextBlock x:Name="TabStatusTextBlock"
                                                       Text="{Binding SubtitleText}"
                                                       Foreground="{DynamicResource StudioTextMutedBrush}"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Source, ElementName=ProfileAvatarImage}" Value="{x:Null}">
                                    <Setter TargetName="ProfileAvatarPlaceholder" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsGroup}" Value="False" />
                                        <Condition Binding="{Binding PrimaryTab.Target.IsExplicitVod}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="TabViewerCountIcon" Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource StudioSurface0Brush}" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                                    <Setter TargetName="TabViewerCountIcon" Property="Text" Value="&#xE8A9;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource StudioSurface2Brush}" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDetached}" Value="True">
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                                    <Setter TargetName="TabStatusTextBlock" Property="Text" Value="Picture-in-picture" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
                                    <Setter TargetName="TabTitleTextBox" Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                                    <Setter TargetName="TabCloseControl" Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                                    <Setter TargetName="TabNeverMuteIcon" Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                                    <Setter TargetName="TabStatusTextBlock" Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                                    <Setter TargetName="TabViewerCountBox" Property="Background" Value="{DynamicResource StudioSuccessSubtleBrush}" />
                                    <Setter TargetName="TabViewerCountBox" Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
                                    <Setter TargetName="TabViewerCountIcon" Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                                    <Setter TargetName="TabViewerCountTextBlock" Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ToolBar x:Name="PlaybackActionsToolBar" Grid.Column="3"
                         Style="{StaticResource ResponsiveToolBar}" Margin="4,0,6,0" LayoutUpdated="PlaybackActionsToolBar_LayoutUpdated">
                        <Button x:Name="TopPlayPauseButton"
                                Style="{StaticResource PlaybackPauseResumeIconButton}"
                                Command="{Binding PauseSelectedCommand}"
                                ToolTip="Pause or resume playback"
                                AutomationProperties.Name="Pause or resume playback" />
                        <Button Style="{StaticResource PlaybackTopControlIconButton}"
                                Content="&#xE72C;"
                                Command="{Binding ReloadSelectedCommand}"
                                ToolTip="Reload stream" />
                        <Button x:Name="TopClipButton"
                                Style="{StaticResource PlaybackTopControlIconButton}"
                                Command="{Binding CreateClipCommand}"
                                ToolTip="{Binding ClipButtonToolTip}"
                                ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="Create stream clip">
                            <Grid Width="20" Height="20" IsHitTestVisible="False">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <EllipseGeometry Center="5,5" RadiusX="2.5" RadiusY="2.5" />
                                            <EllipseGeometry Center="5,15" RadiusX="2.5" RadiusY="2.5" />
                                            <PathGeometry Figures="M7,6.5 L17.5,17 M7,13.5 L17.5,3" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PlaybackChatToggleIconButton}"
                                Content="&#xE8F2;"
                                Command="{Binding ToggleChatCommand}"
                                ToolTip="Show or hide chat" />
                        <Button x:Name="TopMultiStreamButton"
                                Style="{StaticResource PlaybackMultiStreamToggleIconButton}"
                                Command="{Binding ToggleMultiStreamCommand}"
                                ToolTip="{Binding MultiStreamToggleToolTip}"
                                AutomationProperties.Name="Toggle multi-stream grid">
                            <Grid Width="18" Height="18" IsHitTestVisible="False">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5">
                                    <Path.Data>
                                        <RectangleGeometry Rect="1,1,6,6" RadiusX="1.5" RadiusY="1.5" />
                                    </Path.Data>
                                </Path>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="11,1,6,6" RadiusX="1.5" RadiusY="1.5" />
                                            <RectangleGeometry Rect="1,11,6,6" RadiusX="1.5" RadiusY="1.5" />
                                            <RectangleGeometry Rect="11,11,6,6" RadiusX="1.5" RadiusY="1.5" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Grid>
                        </Button>
                        <Button x:Name="TopFullscreenButton"
                                Style="{StaticResource PlaybackTopControlIconButton}"
                                Content="&#xE740;"
                                Click="FullscreenButton_Click"
                                ToolTip="Fullscreen stream"
                                AutomationProperties.Name="Fullscreen stream" />
                        <Button x:Name="TopTheatreButton"
                                Style="{StaticResource PlaybackTopControlIconButton}"
                                Content="&#xE7F4;"
                                Click="TheatreButton_Click"
                                ToolTip="Theatre mode"
                                AutomationProperties.Name="Theatre mode" />
                    <Button x:Name="TopDownloadSettingsButton" Content="Download settings"
                            Command="{Binding ShowDownloadsSettingsCommand}"
                            Margin="3,0"
                            AutomationProperties.Name="Open VOD download settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsHomeVisible}" Value="True" />
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsTwitchVodsHomePageSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsHomeVisible}" Value="True" />
                                            <Condition Binding="{Binding IsSettingsOpen}" Value="False" />
                                            <Condition Binding="{Binding IsDownloadsHomePageSelected}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="TopSettingsButton" Style="{StaticResource SettingsToggleIconButton}"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip="Open settings" AutomationProperties.Name="Open settings">
                        <Path Style="{StaticResource StudioLineIcon}" Data="{StaticResource StudioIconSettings}" Width="17" Height="17"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="TopMuteButton"
                            Content="&#xE74F;"
                            Click="MuteButton_Click"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Mute or unmute">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MuteToggleIconButton}">
                                <Setter Property="IsEnabled" Value="{Binding HasSelectedTab}" />
                                <Setter Property="ToolTip" Value="Mute or unmute" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.NeverMute}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="ToolTip" Value="Turn off Never mute for this tab to allow muting." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHomeSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ToggleButton x:Name="TopNeverMuteButton"
                                  Style="{StaticResource NeverMuteToggleButton}"
                                  IsChecked="{Binding SelectedTab.NeverMute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding HasSelectedTab}"
                                  AutomationProperties.Name="Never mute tab"
                                  AutomationProperties.HelpText="When enabled, this tab stays unmuted. Turn it off to allow muting.">
                        <Grid Width="20" Height="20" IsHitTestVisible="False">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M2,8 L5,8 L9,4.5 L9,15.5 L5,12 L2,12 Z M11.5,7 A4.25,4.25 0 0 1 11.5,13" />
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Data>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="13.5,12,5,5" RadiusX="1" RadiusY="1" />
                                        <PathGeometry Figures="M14.5,12 L14.5,10 A1.5,1.5 0 0 1 17.5,10 L17.5,12" />
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Grid>
                    </ToggleButton>
                </ToolBar>
            </controls:ResponsiveGrid>
        </Border>

        <Border x:Name="SettingsPanel"
                Grid.ColumnSpan="2"
                Grid.Row="2"
                Background="{DynamicResource StudioBaseBrush}"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border.Resources>
                <DataTemplate x:Key="SettingsWrappedToggleContent">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Border.Resources>
            <!-- Compact settings scroll as one page so the header and footer cannot
                 consume the space needed to reach the fields in a short window. -->
            <controls:ResponsiveGrid x:Name="SettingsLayout" CompactWidth="760" CompactHeight="540">
            <ScrollViewer x:Name="SettingsViewport"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
            <Grid Width="{Binding ViewportWidth, ElementName=SettingsViewport}" MinWidth="300">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Height" Value="{Binding ViewportHeight, ElementName=SettingsViewport}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=SettingsLayout}" Value="True">
                                <Setter Property="Height" Value="Auto" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="224" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=SettingsLayout}" Value="True">
                                        <Setter Property="Width" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.RowSpan="2"
                        Background="{DynamicResource StudioSurface0Brush}"
                        BorderBrush="{DynamicResource StudioBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=SettingsLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer x:Name="SettingsSidebarScrollViewer"
                                  Padding="14,22,14,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=SettingsSidebarScrollViewer}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="CUSTOMIZE"
                                   Margin="12,0,0,10"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StudioTextMutedBrush}" />
                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource GeneralSettingsCategoryButton}"
                                    Content="General"
                                    Command="{Binding ShowGeneralSettingsCommand}"
                                    AutomationProperties.Name="General settings" />
                            <Button Style="{StaticResource PlaybackSettingsCategoryButton}"
                                    Content="Playback"
                                    Command="{Binding ShowPlaybackSettingsCommand}"
                                    AutomationProperties.Name="Playback settings" />
                            <Button Style="{StaticResource DownloadsSettingsCategoryButton}"
                                    Content="Downloads"
                                    Command="{Binding ShowDownloadsSettingsCommand}"
                                    AutomationProperties.Name="Downloads settings" />
                            <Button Style="{StaticResource AccountsSettingsCategoryButton}"
                                    Content="Accounts"
                                    Command="{Binding ShowAccountsSettingsCommand}"
                                    AutomationProperties.Name="Account settings" />
                            <Button Style="{StaticResource ChatSettingsCategoryButton}"
                                    Content="Chat"
                                    Command="{Binding ShowChatSettingsCommand}"
                                    AutomationProperties.Name="Chat settings" />
                            <Button Style="{StaticResource HotkeysSettingsCategoryButton}"
                                    Content="Hotkeys"
                                    Command="{Binding ShowHotkeysSettingsCommand}"
                                    AutomationProperties.Name="Hotkey settings" />
                            <Button Style="{StaticResource AdvancedSettingsCategoryButton}"
                                    Content="Advanced"
                                    Command="{Binding ShowAdvancedSettingsCommand}"
                                    AutomationProperties.Name="Advanced settings" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                        <DockPanel x:Name="SettingsAutoSaveIndicator" Margin="10,8,10,16" ToolTip="{Binding SettingsSaveStatus}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{DynamicResource StudioSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSavingSettings}" Value="True"><Setter Property="Text" Value="&#xE72C;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding HasSettingsSaveError}" Value="True">
                                                <Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="{DynamicResource StudioDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="11" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Changes save automatically" />
                                        <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSavingSettings}" Value="True"><Setter Property="Text" Value="Saving changes…" /></DataTrigger>
                                            <DataTrigger Binding="{Binding HasSettingsSaveError}" Value="True">
                                                <Setter Property="Text" Value="Save needs attention" />
                                                <Setter Property="Foreground" Value="{DynamicResource StudioDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <Button
                                Style="{StaticResource SettingsBackButtonStyle}"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip="Close settings"
                                AutomationProperties.Name="Back to studio">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;"
                                           Margin="0,0,10,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Back to studio"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1" Grid.Row="0" Margin="12,10">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=SettingsLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CompactSettingsCategorySelector"
                              SelectedItem="{Binding SelectedSettingsCategory, Mode=TwoWay}"
                              AutomationProperties.Name="Settings category">
                        <x:Static Member="vm:SettingsCategory.General" />
                        <x:Static Member="vm:SettingsCategory.Playback" />
                        <x:Static Member="vm:SettingsCategory.Downloads" />
                        <x:Static Member="vm:SettingsCategory.Accounts" />
                        <x:Static Member="vm:SettingsCategory.Chat" />
                        <x:Static Member="vm:SettingsCategory.Hotkeys" />
                        <x:Static Member="vm:SettingsCategory.Advanced" />
                    </ComboBox>
                    <Button Grid.Column="1"
                            Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Margin="8,0,0,0"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip="Back to studio"
                            AutomationProperties.Name="Back to studio" />
                </Grid>

                <Grid Grid.Column="1" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="SettingsSaveError"
                            Margin="16,10,16,0" Padding="12"
                            BorderBrush="{DynamicResource StudioDangerBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding HasSettingsSaveError, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Retry" Margin="12,0,0,0"
                                    Command="{Binding SaveSettingsCommand}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SettingsSaveStatus}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource StudioDangerBrush}"
                                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="SettingsContentScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Left">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=SettingsLayout}" Value="True">
                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Grid Width="{Binding ElementName=SettingsContentScrollViewer, Path=ViewportWidth}" MinWidth="300">
                            <Grid MaxWidth="1040"
                                  HorizontalAlignment="Stretch">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Margin" Value="28,24,28,32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompact, ElementName=SettingsLayout}" Value="True">
                                                <Setter Property="Margin" Value="12,16,12,20" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            <StackPanel x:Name="GeneralSettingsPage"
                                        Visibility="{Binding IsGeneralSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <controls:ResponsiveColumnsPanel>


                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <ContentControl Content="Appearance &amp; behavior" Tag="{StaticResource StudioIconPalette}" Style="{StaticResource StudioSectionHeading}" />
                                            <TextBlock Text="When closing the window" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding CloseBehaviorOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.CloseBehavior}"
                                                      Margin="0,0,0,16"
                                                      ToolTip="Choose whether closing exits the app or leaves it running in the tray." />
                                            <TextBlock Text="Theme" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.Theme}"
                                                      Margin="0,0,0,16"
                                                      ToolTip="Choose a color theme for the application." />
                                            <CheckBox
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.KeepHomeCardRightGap}"
                                                      ToolTip="Keep cards at their standard width. Turn off to stretch cards across each row."
                                                      Content="Keep cards at a fixed width"
                                                      ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                            <CheckBox x:Name="StreamHoverPreviewsCheckBox"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.EnableStreamHoverPreviews, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,16,0,0"
                                                      ToolTip="Play a muted live preview while hovering over a live stream in Followed, Browse, search results, or Recent. Move away to stop."
                                                      Content="Live stream previews on hover"
                                                      ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <ContentControl Content="Followed channels" Tag="{StaticResource StudioIconLive}" Style="{StaticResource StudioSectionHeading}" />
                                            <CheckBox x:Name="WindowsToastNotificationsCheckBox"

                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.FollowedChannels.NotifyWhenLive}"
                                                      Margin="0,0,0,16"
                                                      ToolTip="Show a Windows toast when a followed channel goes live. Checks every minute while the app is running, including when it is minimized to the tray."
                                                      Content="Windows toast notifications"
                                                      ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                            <TextBlock Text="Kick follows" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBlock Text="Sign in to Kick to detect your followed channels, including channels that are offline."
                                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button Content="Detect Kick follows" Command="{Binding ImportKickFollowsCommand}" Margin="0,0,8,6" />
                                                <Button Content="Clear imported follows" Command="{Binding ClearImportedKickFollowsCommand}" Margin="0,0,0,6" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding KickImportedFollowsSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding KickFollowImportStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <TextBlock Text="Additional Kick channels (optional)" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding KickFollowedChannelsText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     MinHeight="112"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     ToolTip="One Kick channel slug or URL per line. Twitch follows use Twitch authorization." />
                                        </StackPanel>
                                    </Border>
                                </controls:ResponsiveColumnsPanel>
                            </StackPanel>

                            <StackPanel x:Name="PlaybackSettingsPage"
                                        Visibility="{Binding IsPlaybackSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <controls:ResponsiveColumnsPanel>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <ContentControl Content="Stream defaults" Tag="{StaticResource StudioIconPlay}" Style="{StaticResource StudioSectionHeading}" />
                                            <TextBlock Text="Stream quality" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding QualityOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding Settings.DefaultQuality}"
                                                      Margin="0,0,0,16" />
                                            <TextBlock Text="Video renderer" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding VideoRendererOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.VideoRendererMode}"
                                                      Margin="0,0,0,16"
                                                      ToolTip="Automatic prefers Direct3D 11 for normal playback and uses GDI when native chat overlays need compatibility." />
                                            <CheckBox
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.LowLatency}"
                                                      Margin="0,0,0,8"
                                                      Content="Low latency options"
                                                      ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                            <CheckBox
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.KeepInactiveTabsRunning}"
                                                      Margin="0,0,0,8"
                                                      ToolTip="When disabled, hidden live tabs close their player connection and reconnect at the live edge when shown again, while keeping Streamlink and chat ready. Replay/VOD and behind-live tabs preserve their position."
                                                      Content="Keep inactive tabs running"
                                                      ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                            <CheckBox
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding IsMultiStreamEnabled}"
                                                      Content="Multi-stream grid"
                                                      ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <ContentControl Content="Replay" Tag="{StaticResource StudioIconRecent}" Style="{StaticResource StudioSectionHeading}" />
                                            <TextBlock Text="Use platform playback to revisit moments without leaving the studio."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}"
                                                       Margin="0,0,0,14" />
                                            <CheckBox
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.Replay.Enabled}"
                                                      Margin="0,0,0,8"
                                                      ToolTip="Use platform VOD/replay playback when a current replay is available."
                                                      Content="Enable platform replay seekbar"
                                                      ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                            <CheckBox
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      IsChecked="{Binding Settings.Replay.AttemptPrivateKickReplayResolution}"
                                                      ToolTip="Best-effort Kick website probing; private page data may change."
                                                      Content="Try private Kick replay lookup"
                                                      ContentTemplate="{StaticResource SettingsWrappedToggleContent}" />
                                        </StackPanel>
                                    </Border>
                                </controls:ResponsiveColumnsPanel>
                            </StackPanel>

                            <StackPanel x:Name="DownloadsSettingsPage"
                                        Visibility="{Binding IsDownloadsSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <controls:ResponsiveColumnsPanel>
                                    <Border Grid.Column="0" Style="{StaticResource SettingsSectionCard}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <ContentControl Content="VOD downloads" Tag="{StaticResource StudioIconDownload}" Style="{StaticResource StudioSectionHeading}" />
                                            <TextBlock Text="Choose the quality and connection usage for offline Twitch and Kick VODs."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,0,0,16" />
                                            <TextBlock Text="Download quality" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <ComboBox x:Name="VodDownloadQualityComboBox" ItemsSource="{Binding QualityOptions}"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedVodDownloadQuality, Mode=TwoWay}"
                                                      AutomationProperties.Name="VOD download quality" Margin="0,0,0,8" />
                                            <TextBlock Text="Applies to new downloads only; playback quality stays unchanged."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,0,0,20" />
                                            <TextBlock Text="Bandwidth limit (MB/s)" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox x:Name="VodDownloadBandwidthLimitTextBox" MinWidth="120" MaxWidth="180" HorizontalAlignment="Left"
                                                     AutomationProperties.Name="VOD download bandwidth limit in megabytes per second">
                                                <TextBox.Text>
                                                    <Binding Path="Settings.Downloads.BandwidthLimitMegabytesPerSecond"
                                                             Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True">
                                                        <Binding.ValidationRules>
                                                            <controls:DownloadBandwidthLimitValidationRule />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                            <TextBlock Text="Enter a non-negative number, or 0 for unlimited."
                                                       Foreground="{DynamicResource StudioDangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding ElementName=VodDownloadBandwidthLimitTextBox, Path=(Validation.HasError), Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="0 = unlimited. All VOD transfers share this limit; live playback is unaffected. Changes apply to downloads in progress."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SettingsSectionCard}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <ContentControl Content="Download folder" Tag="{StaticResource StudioIconFolder}" Style="{StaticResource StudioSectionHeading}" />
                                            <TextBlock Text="Save new VOD downloads to a local folder of your choice."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,0,0,16" />
                                            <TextBlock Text="Download directory" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox x:Name="VodDownloadDirectoryTextBox" Text="{Binding DownloadDirectory, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="VOD download directory" />
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Content="Browse..." Click="BrowseDownloadDirectoryButton_Click"
                                                        IsEnabled="{Binding CanChangeDownloadDirectory}" Margin="0,0,8,8"
                                                        AutomationProperties.Name="Change VOD download directory" />
                                                <Button Content="Open folder" Command="{Binding OpenDownloadFolderCommand}" Margin="0,0,0,8"
                                                        AutomationProperties.Name="Open VOD download directory" />
                                            </WrapPanel>
                                            <TextBlock Text="Existing and queued downloads stay in their original folders and remain available in your Downloads library. Files are not moved."
                                                       Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </controls:ResponsiveColumnsPanel>
                            </StackPanel>

                            <StackPanel x:Name="AccountsSettingsPage"
                                        Visibility="{Binding IsAccountsSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                <controls:ResponsiveColumnsPanel>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource SettingsSectionCard}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,18">
                                                <Border DockPanel.Dock="Left"
                                                        Background="{DynamicResource StudioTwitchSubtleBrush}"
                                                        BorderBrush="{DynamicResource StudioTwitchBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="8,4"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="TWITCH"
                                                               Foreground="{DynamicResource StudioTwitchTextBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="Twitch account"
                                                           Style="{StaticResource SettingsCardHeaderStyle}"
                                                           Margin="0"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="Username" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox Text="{Binding Settings.Chat.TwitchUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                            <TextBlock Text="Client ID" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <PasswordBox controls:PasswordBoxBinding.IsEnabled="True"
                                                         controls:PasswordBoxBinding.Password="{Binding Settings.Chat.TwitchClientId, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Twitch client ID"
                                                         Margin="0,0,0,12" ToolTip="Redirect URL: http://localhost:39178" />
                                            <TextBlock Text="OAuth token" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <PasswordBox controls:PasswordBoxBinding.IsEnabled="True"
                                                         controls:PasswordBoxBinding.Password="{Binding Settings.Chat.TwitchOAuthToken, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Twitch OAuth token"
                                                         Margin="0,0,0,16" ToolTip="The oauth: or Bearer prefix is optional." />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Content="Connect Twitch"
                                                        Style="{StaticResource StudioPrimaryButtonStyle}"
                                                        Command="{Binding AuthorizeTwitchCommand}"
                                                        MinWidth="124" />
                                                <Button Content="Clear token" Command="{Binding ClearTwitchTokenCommand}" MinWidth="92" Margin="8,0,0,0" />
                                            </WrapPanel>
                                            <StackPanel x:Name="TwitchBonusesPanel" Margin="0,22,0,0">
                                                <TextBlock Text="Channel-point bonuses" Style="{StaticResource StudioFieldLabelStyle}" />
                                                <CheckBox Content="Automatically claim Twitch bonuses"
                                                          IsChecked="{Binding Enabled}" Margin="0,4,0,10" />
                                                <Border Padding="10,8" CornerRadius="6" BorderThickness="1" Margin="0,0,0,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StudioTextDimBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSavedSession}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StudioSuccessBrush}" />
                                                                </DataTrigger>

            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="280" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisualStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                                <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource StudioSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VodCardDownloadProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource StudioAccentBrush}" />
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Value" Value="{Binding Download.ProgressPercentage, Mode=OneWay, FallbackValue=0}" />
            <Setter Property="IsIndeterminate" Value="{Binding Download.IsIndeterminate, FallbackValue=False}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5" />
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border x:Name="DownloadProgressFill" Background="{TemplateBinding Foreground}" CornerRadius="1.5" />
                                <Rectangle x:Name="PART_GlowRect" Width="36" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="DownloadProgressFill" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Download.CanCancel}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDownloadStarting}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="IsIndeterminate" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VodCardDownloadButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#ED18181D" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisualStyle}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Content" Value="{Binding Download.CardButtonText, FallbackValue=Download, TargetNullValue=Download}" />
            <Setter Property="ToolTip" Value="{Binding Download.CardToolTip, FallbackValue='Download this VOD for offline playback at the selected download quality.', TargetNullValue='Download this VOD for offline playback at the selected download quality.'}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Download.CardActionName, FallbackValue='Download VOD for offline playback', TargetNullValue='Download VOD for offline playback'}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DownloadChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}">
                                    <Path x:Name="DownloadIcon" Width="14" Height="14" Stretch="Uniform"
                                          Data="M 8,2 L 8,11 M 4,7 L 8,11 L 12,7 M 3,12 L 3,14 L 13,14 L 13,12"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                                <ProgressBar x:Name="DownloadProgress" Style="{StaticResource VodCardDownloadProgress}"
                                             Margin="12,0,12,3" VerticalAlignment="Bottom"
                                             AutomationProperties.Name="VOD download progress"
                                             AutomationProperties.HelpText="{Binding Download.CardToolTip}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Download.CanCancel}" Value="True">
                                <Setter TargetName="DownloadChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                                <Setter TargetName="DownloadIcon" Property="Stroke" Value="{DynamicResource StudioAccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Download.CanPlay}" Value="True">
                                <Setter TargetName="DownloadChrome" Property="Background" Value="#EF11251B" />
                                <Setter TargetName="DownloadChrome" Property="BorderBrush" Value="{DynamicResource StudioSuccessBorderBrush}" />
                                <Setter TargetName="DownloadIcon" Property="Stroke" Value="{DynamicResource StudioSuccessBrush}" />
                                <Setter TargetName="DownloadIcon" Property="Data" Value="M 3,8 L 6.5,11.5 L 13,5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Download.CanRetry}" Value="True">
                                <Setter TargetName="DownloadChrome" Property="BorderBrush" Value="{DynamicResource StudioWarningBrush}" />
                                <Setter TargetName="DownloadIcon" Property="Stroke" Value="{DynamicResource StudioWarningBrush}" />
                                <Setter TargetName="DownloadIcon" Property="Data" Value="M 12.5,5 A 5.5,5.5 0 1 0 13.5,9 M 12.5,1 L 12.5,5 L 8.5,5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDownloadStarting}" Value="True">
                                <Setter Property="Content" Value="Queuing…" />
                                <Setter TargetName="DownloadChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                                <Setter TargetName="DownloadIcon" Property="Stroke" Value="{DynamicResource StudioAccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DownloadChrome" Property="Background" Value="#FF292930" />
                                <Setter TargetName="DownloadChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DownloadChrome" Property="Background" Value="#FF101014" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DownloadChrome" Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StreamHoverPreviewStyle" TargetType="controls:StreamHoverPreview">
            <Setter Property="Controller" Value="{Binding DataContext.HoverPreviews, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="IsPreviewEnabled" Value="{Binding DataContext.Settings.EnableStreamHoverPreviews, RelativeSource={RelativeSource AncestorType=Window}}" />

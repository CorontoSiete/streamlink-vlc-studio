            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{DynamicResource StudioSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="SettingsCardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="SettingsPageDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HotkeyRecorderButtonStyle"
               TargetType="{x:Type controls:HotkeyRecorderButton}"
               BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Width" Value="178" />
            <Setter Property="MaxWidth" Value="178" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="{DynamicResource StudioSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Margin="0,0,14,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="ToggleTrack"
                                    Grid.Column="1"
                                    Width="42"
                                    Height="24"
                                    Background="{DynamicResource StudioSurface0Brush}"
                                    BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="ToggleThumb"
                                         Width="16"
                                         Height="16"
                                         Margin="3,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource StudioTextMutedBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource StudioAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource StudioAccentHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsBackButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Background" Value="{DynamicResource StudioSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <Style x:Key="ReplaySeekFillButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="{DynamicResource StudioAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="6"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReplaySeekRemainderButtonStyle" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource ReplaySeekFillButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource StudioBorderBrush}" />
        </Style>

        <Style x:Key="ReplaySeekThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="#E8FFFB" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReplaySeekSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   VerticalAlignment="Center"
                                   Height="18">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource ReplaySeekFillButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SeekThumb"
                                           Style="{StaticResource ReplaySeekThumbStyle}"
                                           DragStarted="ReplaySeekThumb_DragStarted"
                                           DragCompleted="ReplaySeekThumb_DragCompleted" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource ReplaySeekRemainderButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SeekThumb" Property="Width" Value="18" />
                                <Setter TargetName="SeekThumb" Property="Height" Value="18" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReplayLiveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#123834" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
        </Style>

        <Style x:Key="ReplayStepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource StudioSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource StudioDisabledBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#17202B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource StudioTextBoxStyle}" />

        <Style x:Key="HomeSearchTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="30,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource StudioSurface0Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="SearchChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchChrome" Property="Background" Value="{DynamicResource StudioSurfaceCardBrush}" />
                                <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchChrome" Property="Background" Value="{DynamicResource StudioSurface0Brush}" />
                                <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource StudioComboBoxStyle}" />

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="Auto" />
            <RowDefinition x:Name="TopControlsRow" Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Height="40"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Border Width="24"
                            Height="24"
                            Margin="0,0,10,0"
                            Background="#262DD4BF"
                            BorderBrush="{DynamicResource StudioAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock Text="&#xE714;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource StudioAccentHoverBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="STREAM STUDIO"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource StudioTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Width="1"
                            Height="16"
                            Background="{DynamicResource StudioBorderStrongBrush}"
                            Margin="12,0" />
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StreamInactiveBrush}" />
                                <Setter Property="ToolTip" Value="No stream playing" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnyStreamPlaying}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource StudioSuccessBrush}" />
                                        <Setter Property="ToolTip" Value="Stream playing" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               FontSize="11"
                               Foreground="{DynamicResource StudioTextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#xE922;"
                            Click="MaximizeRestoreButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Maximize" />
                    <Button Style="{StaticResource TitleBarButton}"
                            Content="&#xE8BB;"
                            Click="CloseWindowButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel x:Name="PlaybackHost"
                   Grid.Row="2"
                   Background="{StaticResource VideoBlackBrush}">
            <DockPanel.Style>
                <Style TargetType="{x:Type DockPanel}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <Border x:Name="DockedChatPanel"
                    DockPanel.Dock="Right"
                    Width="{Binding Settings.Chat.DockWidth}"
                    MinWidth="{x:Static settings:ChatSettings.MinimumDockWidth}"
                    MaxWidth="{x:Static settings:ChatSettings.MaximumDockWidth}"
                    Background="{DynamicResource StudioSurface0Brush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0"
                    Opacity="{Binding Settings.Chat.Opacity}"
                    PreviewMouseWheel="DockedChatPanel_PreviewMouseWheel"
                    Visibility="{Binding IsDockedChatVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <Thumb x:Name="DockedChatResizeThumb"
                           Grid.RowSpan="3"
                           Width="8"
                           HorizontalAlignment="Left"
                           Cursor="SizeWE"
                           DragDelta="DockedChatResizeThumb_DragDelta"
                           Panel.ZIndex="10"
                           AutomationProperties.Name="Resize docked chat">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Grid Background="Transparent">
                                    <Border x:Name="ResizeCue"
                                            Width="2"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource StudioTextMutedBrush}"
                                            Opacity="0" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ResizeCue" Property="Opacity" Value="0.55" />
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="ResizeCue" Property="Opacity" Value="0.9" />
                                        <Setter TargetName="ResizeCue" Property="Background" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Border Grid.Row="0"
                            Margin="8,7,8,5"
                            Padding="10,0"
                            Background="{DynamicResource StudioSurface1Brush}"
                            BorderBrush="{DynamicResource StudioBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left"
                                    VerticalAlignment="Center"
                                    Background="#2634D399"
                                    BorderBrush="{DynamicResource StudioSuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="0,0,8,0">
                                <TextBlock Text="LIVE CHAT"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource StudioSuccessBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedTab.DockedChatHeaderText}"
                                       ToolTip="{Binding SelectedTab.DockedChatHeaderText}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="DockedChatListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding SelectedTab.DockedChatFeedItems}"
                             Tag="{Binding IsMouseOver, ElementName=DockedChatPanel}"
                             PreviewMouseWheel="ChatListBox_PreviewMouseWheel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             HorizontalContentAlignment="Stretch"
                             Padding="8">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DockedChatScrollBarStyle}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <DockPanel Grid.Row="2" Margin="8,0,8,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="Send"
                                Command="{Binding SelectedTab.SendChatMessageCommand}"
                                MinWidth="62"
                                Margin="8,0,0,0" />
                        <TextBox x:Name="ChatInputTextBox"
                                 Text="{Binding SelectedTab.OutgoingChatText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="ChatInputTextBox_KeyDown"
                                 AutomationProperties.Name="Chat message"
                                 ToolTip="Chat message" />
                    </DockPanel>
                </Grid>
            </Border>

            <Grid x:Name="VideoAndReplayHost">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Transient volume OSD shown on scroll-wheel volume changes (reusable control). -->
            <controls:VolumeOverlay x:Name="VolumeOsd" />

            <Grid x:Name="VideoViewport"
                  Grid.Row="0"
                  Background="{StaticResource VideoBlackBrush}"
                  ClipToBounds="True"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  PreviewMouseLeftButtonDown="VideoViewport_PreviewMouseLeftButtonDown">
                <ItemsControl ItemsSource="{Binding VideoTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VideoSurfaceGridPanel Rows="{Binding DataContext.VideoGridRows, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            Columns="{Binding DataContext.VideoGridColumns, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                            <Setter Property="Grid.Row" Value="{Binding VideoGridRow}" />
                            <Setter Property="Grid.Column" Value="{Binding VideoGridColumn}" />
                            <Setter Property="Grid.RowSpan" Value="{Binding VideoGridRowSpan}" />
                            <Setter Property="Grid.ColumnSpan" Value="{Binding VideoGridColumnSpan}" />
                            <Setter Property="controls:VideoSurfaceGridPanel.AspectRatio" Value="{Binding VideoAspectRatio}" />
                            <Setter Property="Panel.ZIndex" Value="0" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVideoVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Panel.ZIndex" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:VideoSurface Loaded="VideoSurface_Loaded"
                                                   Unloaded="VideoSurface_Unloaded"
                                                   SurfaceMouseLeftButtonPressed="VideoSurface_MouseLeftButtonPressed"
                                                   MouseWheelScrolled="VideoSurface_MouseWheelScrolled"
                                                   MouseLeftButtonDoubleClicked="VideoSurface_MouseLeftButtonDoubleClicked"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   Tag="{Binding}">
                                <controls:VideoSurface.Style>
                                    <Style TargetType="{x:Type controls:VideoSurface}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVideoVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:VideoSurface.Style>
                            </controls:VideoSurface>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Background="{DynamicResource StudioBaseBrush}"
                      Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource StudioSurface0Brush}"
                            BorderBrush="{DynamicResource StudioSurface3Brush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="16,10,16,0"
                            Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="360" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="268"
                                  MinWidth="0"
                                  Margin="0,0,18,0"
                                  VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Twitch &amp; Kick player"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0" />
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource StudioCategoryBgBrush}"
                                            BorderBrush="{DynamicResource StudioCategoryBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StudioCategoryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding BrowserClickStatus}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </Grid>

                            <Grid x:Name="HomeSearchAnchor"
                                  Grid.Column="1"
                                  MaxWidth="560"
                                  MinWidth="360"
                                  Height="36"
                                  Margin="0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  PreviewMouseDown="HomeSearchAnchor_PreviewMouseDown">
                                <TextBox x:Name="HomeStreamSearchTextBox"
                                         Style="{StaticResource HomeSearchTextBoxStyle}"
                                         Text="{Binding NewStreamText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="StreamSearchTextBox_KeyDown"
                                         GotKeyboardFocus="HomeStreamSearchTextBox_GotKeyboardFocus"
                                         AutomationProperties.Name="Streamer search"
                                         ToolTip="Twitch or Kick channel name or URL" />
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           IsHitTestVisible="False"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="Search Twitch or Kick streamer"
                                           Foreground="{DynamicResource StudioTextPlaceholderBrush}"
                                           IsHitTestVisible="False"
                                           Margin="30,0,12,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsNewStreamSearchPlaceholderVisible, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource StudioSurface0Brush}"
                                    BorderBrush="{DynamicResource StudioDisabledBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,3"
                                    Margin="18,0,0,0"
                                    Visibility="{Binding IsFollowedHomePageSelected, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding FollowedChannelsLastUpdatedText}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10"
                                               MaxWidth="140"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <Button Style="{StaticResource HomeRefreshButton}"
                                            Content="&#xE72C;"
                                            Command="{Binding RefreshFollowedChannelsCommand}"
                                            ToolTip="Refresh followed channels" />
                                </DockPanel>
                            </Border>
                            <Popup x:Name="HomeStreamSearchPopup"
                                       Grid.ColumnSpan="3"
                                       PlacementTarget="{Binding ElementName=HomeSearchAnchor}"
                                       Placement="Bottom"
                                       VerticalOffset="8"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       StaysOpen="True"
                                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                       IsOpen="{Binding IsStreamSearchPanelVisible, Mode=OneWay}">
                                    <Border Width="{Binding ActualWidth, ElementName=HomeSearchAnchor}"
                                            MinWidth="360"
                                            MaxWidth="560"
                                            MaxHeight="360"
                                            Background="#F2101012"
                                            BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24"
                                                              ShadowDepth="8"
                                                              Opacity="0.42"
                                                              Color="#000000" />
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0"
                                                       LastChildFill="True"
                                                       Margin="4,2,4,8">
                                                <Border DockPanel.Dock="Right"
                                                        Background="#122018"
                                                        BorderBrush="#2D8D65"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsStreamSearchResultsVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <DockPanel LastChildFill="False">
                                                        <Ellipse Width="6"
                                                                 Height="6"
                                                                 Fill="{DynamicResource StudioSuccessBrush}"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="Results"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StudioSuccessTextBrush}" />
                                                    </DockPanel>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StreamSearchResultsTitle}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource StudioTextBrush}" />
                                                    <TextBlock Text="{Binding StreamSearchStatus}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>

                                            <ProgressBar Grid.Row="1"
                                                         Height="3"
                                                         IsIndeterminate="True"
                                                         Margin="4,0,4,8"
                                                         Visibility="{Binding IsStreamSearchRunning, Converter={StaticResource BoolToVisibility}}" />

                                            <Border Grid.Row="2"
                                                    Background="{DynamicResource StudioBaseBrush}"
                                                    BorderBrush="{DynamicResource StudioBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12"
                                                    Margin="0,0,0,2"
                                                    Visibility="{Binding IsStreamSearchEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel LastChildFill="True">
                                                    <Border Width="34"
                                                            Height="34"
                                                            Background="{DynamicResource StudioSurface1Brush}"
                                                            BorderBrush="{DynamicResource StudioBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE721;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="15"
                                                                   Foreground="{DynamicResource StudioTextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="No playable streams found"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StudioTextBrush}" />
                                                        <TextBlock Text="{Binding StreamSearchStatus}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <ScrollViewer Grid.Row="2"
                                                          MaxHeight="272"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding IsStreamSearchResultsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource HomeScrollBarStyle}" />
                                                </ScrollViewer.Resources>
                                                <ItemsControl ItemsSource="{Binding StreamSearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding OpenCommand}"
                                                                    PreviewMouseDown="HomeStreamItemButton_PreviewMouseDown"
                                                                    Margin="0,0,0,6"
                                                                    Padding="0"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Background="{DynamicResource StudioSurfaceCardBrush}"
                                                                    BorderBrush="{DynamicResource StudioBorderBrush}"
                                                                    BorderThickness="1">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="ResultChrome"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="7"
                                                                                SnapsToDevicePixels="True">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                                <Setter TargetName="ResultChrome" Property="Background" Value="#10271A" />
                                                                                <Setter TargetName="ResultChrome" Property="BorderBrush" Value="{DynamicResource StudioSuccessBorderBrush}" />
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="ResultChrome" Property="Background" Value="{DynamicResource StudioSurface3Brush}" />
                                                                                <Setter TargetName="ResultChrome" Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="ResultChrome" Property="Background" Value="#0E5F57" />
                                                                            </Trigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsLive}" Value="True" />
                                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter TargetName="ResultChrome" Property="Background" Value="#173D28" />
                                                                                <Setter TargetName="ResultChrome" Property="BorderBrush" Value="#57DD8C" />
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsLive}" Value="True" />
                                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsPressed}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter TargetName="ResultChrome" Property="Background" Value="#12552C" />
                                                                            </MultiDataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid Margin="12,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0"
                                                                            Width="96"
                                                                            Height="54"
                                                                            Background="{DynamicResource StudioBaseBrush}"
                                                                            BorderBrush="{DynamicResource StudioBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="7"
                                                                            ClipToBounds="True"
                                                                            VerticalAlignment="Center">
                                                                        <Grid>
                                                                            <TextBlock Text="&#xE7F4;"
                                                                                       FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="22"
                                                                                       Foreground="{DynamicResource StudioTextDimBrush}"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                            <controls:AnimatedEmoteImage ImageUrl="{Binding ThumbnailUrl}"
                                                                                                         MaxImageBytes="8388608"
                                                                                                         Stretch="UniformToFill" />
                                                                        </Grid>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="12,0"
                                                                                VerticalAlignment="Center">
                                                                        <DockPanel LastChildFill="True">
                                                                            <Border DockPanel.Dock="Left"
                                                                                    Style="{StaticResource HomePlatformBadgeStyle}"
                                                                                    Margin="0,0,8,0"
                                                                                    VerticalAlignment="Center">
                                                                                <Viewbox Width="16"
                                                                                         Height="16"
                                                                                         VerticalAlignment="Center"
                                                                                         HorizontalAlignment="Center">
                                                                                    <Path Style="{StaticResource HomePlatformIconStyle}" />
                                                                                </Viewbox>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                                       FontSize="14"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource StudioTextBrush}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center" />
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding CategoryName}"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource StudioAccentTextBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,2,0,0"
                                                                                   Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibility}}" />
                                                                        <TextBlock Text="{Binding Url}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,2,0,0" />
                                                                        <TextBlock Text="{Binding StatusText}"
                                                                                   FontSize="11"
                                                                                   Foreground="#C9D5DE"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,2,0,0" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center">
                                                                        <Border BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                Padding="8,4"
                                                                                Margin="0,0,10,0">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="{DynamicResource StudioSurface3Brush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                                            <Setter Property="Background" Value="#16482B" />
                                                                                            <Setter Property="BorderBrush" Value="#4FD981" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding StateText}"
                                                                                       FontSize="11"
                                                                                       FontWeight="SemiBold">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#D9FFE7" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Border>
                                                                        <Border Background="#102D1E"
                                                                                BorderBrush="#2F9D62"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                Padding="8,4"
                                                                                Margin="0,0,10,0"
                                                                                Visibility="{Binding HasViewerCount, Converter={StaticResource BoolToVisibility}}">
                                                                            <TextBlock Text="{Binding ViewerCountText}"
                                                                                       FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="#A9F5C6" />
                                                                        </Border>
                                                                        <TextBlock Text="&#xE768;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Popup>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="HomeContentScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="{Binding Settings.KeepHomeCardRightGap, Converter={StaticResource HomeContentPadding}}"
                                  PreviewMouseDown="HomeContentScrollViewer_PreviewMouseDown"
                                  PreviewMouseMove="HomeContentScrollViewer_PreviewMouseMove"
                                  PreviewMouseUp="HomeContentScrollViewer_PreviewMouseUp"
                                  LostMouseCapture="HomeContentScrollViewer_LostMouseCapture"
                                  ScrollChanged="HomeContentScrollViewer_ScrollChanged">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource HomeScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <Grid Visibility="{Binding IsFollowedHomePageVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                            <DockPanel LastChildFill="True"
                                       Margin="0,0,0,14">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource StudioSurface1Brush}"
                                        BorderBrush="{DynamicResource StudioBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="9,5"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Top">
                                    <DockPanel LastChildFill="False">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{DynamicResource StudioSuccessBrush}"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FollowedChannelsStatus}"
                                                   MaxWidth="520"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource StudioTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Live followed channels"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Twitch and Kick"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <ProgressBar Height="4"
                                         IsIndeterminate="True"
                                         Margin="0,0,0,18"
                                         Visibility="{Binding IsFollowedChannelsRefreshing, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel HorizontalAlignment="Center"
                                        MaxWidth="560"
                                        Margin="0,74,0,0"
                                        Visibility="{Binding IsFollowedChannelsEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                <Border Width="58"
                                        Height="58"
                                        Background="{DynamicResource StudioSurface1Brush}"
                                        BorderBrush="{DynamicResource StudioBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">
                                    <TextBlock Text="&#xE7F4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No live followed channels"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding FollowedChannelsStatus}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding LiveFollowedChannels}"
                                          ItemsPanel="{StaticResource HomeCardItemsPanel}"
                                          ItemTemplate="{StaticResource LiveStreamCardTemplate}"
                                          Visibility="{Binding HasLiveFollowedChannels, Converter={StaticResource BoolToVisibility}}">
                            </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsTwitchVodsHomePageVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="True"
                                               Margin="0,0,0,14">
                                        <Border DockPanel.Dock="Right"
                                                Background="{DynamicResource StudioSurface1Brush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="9,5"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TwitchVodStatus}"
                                                       MaxWidth="520"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource StudioTextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="VODs"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TwitchVodResultsTitle}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel LastChildFill="True"
                                               Margin="0,0,0,12">
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource TwitchVodPlatformButton}"
                                                    Content="Twitch"
                                                    Command="{Binding SelectTwitchVodPlatformCommand}" />
                                            <Button Style="{StaticResource KickVodPlatformButton}"
                                                    Content="Kick"
                                                    Command="{Binding SelectKickVodPlatformCommand}" />
                                        </StackPanel>
                                        <Grid MaxWidth="460"
                                              HorizontalAlignment="Left">
                                            <TextBox Text="{Binding TwitchVodSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource HomeSearchTextBoxStyle}"
                                                     AutomationProperties.Name="VOD streamer search"
                                                     ToolTip="Streamer login, slug, or channel URL" />
                                            <TextBlock Text="&#xE721;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       IsHitTestVisible="False"
                                                       Margin="13,0,0,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock Text="Search streamer"
                                                       Foreground="{DynamicResource StudioTextPlaceholderBrush}"
                                                       IsHitTestVisible="False"
                                                       Margin="30,0,12,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsTwitchVodSearchPlaceholderVisible, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,16"
                                                Visibility="{Binding IsTwitchVodFilterVisible, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource PastBroadcastsVodFilterButton}"
                                                Content="Past broadcasts"
                                                Command="{Binding ShowPastBroadcastsVodFilterCommand}" />
                                        <Button Style="{StaticResource HighlightsVodFilterButton}"
                                                Content="Highlights"
                                                Command="{Binding ShowHighlightsVodFilterCommand}" />
                                        <Button Style="{StaticResource UploadsVodFilterButton}"
                                                Content="Uploads"
                                                Command="{Binding ShowUploadsVodFilterCommand}" />
                                        <Button Style="{StaticResource AllVodFilterButton}"
                                                Content="All"
                                                Command="{Binding ShowAllVodFilterCommand}" />
                                    </StackPanel>

                                    <ProgressBar Height="4"
                                                 IsIndeterminate="True"
                                                 Margin="0,0,0,18"
                                                 Visibility="{Binding IsTwitchVodSearchRunning, Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel HorizontalAlignment="Center"
                                                MaxWidth="560"
                                                Margin="0,74,0,0"
                                                Visibility="{Binding IsTwitchVodEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                                        <Border Width="58"
                                                Height="58"
                                                Background="{DynamicResource StudioSurface1Brush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,16">
                                            <TextBlock Text="&#xE8B2;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="No VODs found"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding TwitchVodStatus}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding TwitchVods}"
                                                  ItemsPanel="{StaticResource HomeCardItemsPanel}"
                                                  Visibility="{Binding HasTwitchVods, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource HomeCardButton}"
                                                        Command="{Binding OpenCommand}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="174" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <controls:RoundedClipBorder Grid.Row="0"
                                                                                    Background="{DynamicResource StudioBaseBrush}"
                                                                                    CornerRadius="11.5,11.5,0,0">
                                                            <Grid>
                                                                <TextBlock Text="&#xE8B2;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="30"
                                                                           Foreground="{DynamicResource StudioTextDimBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <controls:AnimatedEmoteImage ImageUrl="{Binding ThumbnailUrl}"
                                                                                             MaxImageBytes="8388608"
                                                                                             Stretch="UniformToFill" />
                                                                <Border VerticalAlignment="Bottom"
                                                                        Height="72">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

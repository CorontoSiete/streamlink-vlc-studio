                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Title}"
                                   FontSize="12"
                                   Foreground="{DynamicResource StudioTextSecondaryBrush}"

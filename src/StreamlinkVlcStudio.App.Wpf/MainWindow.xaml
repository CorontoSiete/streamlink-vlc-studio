                                    Height="72">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00141416" Offset="0" />
                                        <GradientStop Color="#D00A0A0B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

<Window x:Class="StreamlinkVlcStudio.App.Wpf.DetachedVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StreamlinkVlcStudio.App.Wpf.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
         Icon="/StreamlinkVlcStudio.App.Wpf;component/Assets/Twitch.ico"
         Width="520"
         Height="326.5"
        MinWidth="320"
        MinHeight="220"
        Background="{DynamicResource StudioBaseBrush}"
        Foreground="{DynamicResource StudioTextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/StudioTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!--
            The palette lives in application resources and ThemeManager swaps that dictionary at
            runtime, so every palette reference has to be a DynamicResource. A StaticResource here
            would freeze this window on whichever theme happened to be active when it opened.
        -->
        <SolidColorBrush x:Key="DetachedPanelBrush" Color="{DynamicResource StudioSurface1Color}" />
        <SolidColorBrush x:Key="DetachedLineBrush" Color="{DynamicResource StudioBorderColor}" />
        <SolidColorBrush x:Key="DetachedAccentBrush" Color="{DynamicResource StudioAccentColor}" />
        <SolidColorBrush x:Key="DetachedMutedBrush" Color="{DynamicResource StudioTextMutedColor}" />

        <Style x:Key="DetachedIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource StudioSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisualStyle}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource StudioSurface3Brush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource DetachedAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetachedVideoContextMenu" TargetType="{x:Type ContextMenu}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource StudioSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border x:Name="MenuChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetachedVideoMenuItem" TargetType="{x:Type MenuItem}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6,12,6" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="14"
                                      Height="14"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                    <Border x:Name="CheckBackground"
                                            Background="{DynamicResource StudioAccentPressedBrush}"
                                            BorderBrush="{DynamicResource StudioAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="Collapsed" />
                                    <Path x:Name="CheckMark"
                                          Width="9"
                                          Height="7"
                                          Data="M0,3.25 L3.25,6.5 L9,0"
                                          Stroke="#FFFFFFFF"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Grid>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="5,0,0,0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource StudioSurface3Brush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBackground" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#000000"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="34" />
            <RowDefinition x:Name="VideoRow" Height="*" />
            <RowDefinition x:Name="BottomResizeGripRow" Height="10" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar"
                Grid.Row="0"
                Background="{StaticResource DetachedPanelBrush}"
                BorderBrush="{StaticResource DetachedLineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="10,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource DetachedAccentBrush}"
                             Margin="0,0,8,0" />
                    <TextBlock Text="{Binding HeaderTitle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderStatusText}"
                               Foreground="{StaticResource DetachedMutedBrush}"
                               FontSize="11"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="0,7,0,0">
                    <Button x:Name="TopmostButton"
                            Style="{StaticResource DetachedIconButton}"
                            Content="&#xE718;"
                            Click="TopmostButton_Click"
                            ToolTip="Always on top" />
                    <Button x:Name="FullscreenButton"
                            Style="{StaticResource DetachedIconButton}"
                            Content="&#xE740;"
                            Click="FullscreenButton_Click"
                            ToolTip="Fullscreen stream" />
                    <Button x:Name="HideTopBarButton"
                            Style="{StaticResource DetachedIconButton}"
                            Content="&#xE890;"
                            Click="HideTopBarButton_Click"
                            ToolTip="Hide top bar" />
                    <Button Style="{StaticResource DetachedIconButton}"
                            Content="&#xE72B;"
                            Click="DockButton_Click"
                            ToolTip="Return to main window" />
                    <Button Style="{StaticResource DetachedIconButton}"
                            Content="&#xE711;"
                            Click="CloseButton_Click"
                            ToolTip="Close picture-in-picture" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="VideoHost"
              Grid.Row="1"
              Grid.RowSpan="2"
              Background="#000000"
              ContextMenuOpening="VideoHost_ContextMenuOpening">
            <Grid.ContextMenu>
                <ContextMenu x:Name="VideoContextMenu"
                             Style="{StaticResource DetachedVideoContextMenu}">
                    <MenuItem x:Name="ShowTopBarMenuItem"
                              Header="Show top bar"
                              IsCheckable="True"
                              Style="{StaticResource DetachedVideoMenuItem}"
                              Click="ShowTopBarMenuItem_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
            <ItemsControl ItemsSource="{Binding MountedVideoItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VideoSurfaceGridPanel Rows="{Binding DataContext.VideoGridRows, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        Columns="{Binding DataContext.VideoGridColumns, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Grid.Row" Value="{Binding Row}" />
                        <Setter Property="Grid.Column" Value="{Binding Column}" />
                        <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
                        <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
                        <Setter Property="controls:VideoSurfaceGridPanel.AspectRatio" Value="{Binding Tab.VideoAspectRatio}" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <controls:VideoSurface x:Name="DetachedVideoSurface"
                                                   Loaded="VideoSurface_Loaded"
                                                   Unloaded="VideoSurface_Unloaded"
                                                   SurfaceMouseLeftButtonPressed="VideoSurface_MouseLeftButtonPressed"
                                                   MouseWheelScrolled="VideoSurface_MouseWheelScrolled"
                                                   MouseLeftButtonDoubleClicked="VideoSurface_MouseLeftButtonDoubleClicked"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   Tag="{Binding Tab}" />
                            <controls:ReplaySeekOverlay Width="0"
                                                        Height="0"
                                                        DataContext="{Binding Tab}"
                                                        PlacementTarget="{Binding ElementName=DetachedVideoSurface}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Transient volume OSD shown on scroll-wheel volume changes (reusable control). -->
        <controls:VolumeOverlay x:Name="VolumeOsd" />

        <Grid x:Name="BottomResizeGrip"
              Grid.Row="2"
              Background="Transparent"
              Panel.ZIndex="10"
              MouseLeftButtonDown="BottomResizeGrip_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="Transparent"
                    Cursor="SizeNESW" />
            <Border Grid.Column="1"
                    Background="Transparent"
                    Cursor="SizeNS" />
            <Border Grid.Column="2"
                    Background="Transparent"
                    Cursor="SizeNWSE" />
        </Grid>
    </Grid>
</Window>

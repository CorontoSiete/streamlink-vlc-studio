<UserControl x:Class="StreamlinkVlcStudio.App.Wpf.Controls.ReplaySeekOverlay"
             x:Name="OverlayRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StreamlinkVlcStudio.App.Wpf.Controls"
             Width="0"
             Height="0"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/StudioTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                This overlay needs a custom Track for exact replay scrubbing, but its colours should
                stay on the same palette slots as the shared Studio slider instead of carrying a
                private seekbar theme. These brush aliases are colour-dynamic so ThemeManager's
                application-level palette swap reaches the native child HWND as well.
            -->
            <SolidColorBrush x:Key="OverlaySeekBackgroundBrush"
                             Color="{DynamicResource StudioSurface1Color}"
                             Opacity="0.95" />
            <SolidColorBrush x:Key="OverlaySeekElapsedBrush"
                             Color="{DynamicResource StudioAccentColor}" />
            <SolidColorBrush x:Key="OverlaySeekRemainingBrush"
                             Color="{DynamicResource StudioBorderStrongColor}" />
            <SolidColorBrush x:Key="OverlaySeekThumbFillBrush"
                             Color="{DynamicResource StudioTextColor}" />
            <SolidColorBrush x:Key="OverlaySeekThumbStrokeBrush"
                             Color="{DynamicResource StudioAccentColor}" />

            <Style x:Key="OverlaySeekTrackButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Background" Value="{DynamicResource OverlaySeekElapsedBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Grid Background="Transparent">
                                <Border Height="4"
                                        VerticalAlignment="Center"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="2" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OverlaySeekThumb" TargetType="{x:Type Thumb}">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="ThumbHalo"
                                         Width="22" Height="22"
                                         Fill="{DynamicResource StudioAccentBrush}"
                                         Opacity="0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Ellipse x:Name="ThumbCore"
                                         Width="12" Height="12"
                                         Fill="{DynamicResource OverlaySeekThumbFillBrush}"
                                         Stroke="{DynamicResource OverlaySeekThumbStrokeBrush}"
                                         StrokeThickness="1"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbHalo" Property="Opacity" Value="0.25" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbHalo" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OverlaySeekSlider" TargetType="{x:Type Slider}">
                <Setter Property="Height" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <controls:ReplaySeekTrack x:Name="PART_Track"
                                       Height="28"
                                       Margin="2,0"
                                       VerticalAlignment="Center"
                                       Focusable="False">
                                    <controls:ReplaySeekTrack.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                                      Style="{StaticResource OverlaySeekTrackButton}" />
                                    </controls:ReplaySeekTrack.DecreaseRepeatButton>
                                    <controls:ReplaySeekTrack.Thumb>
                                        <Thumb Style="{StaticResource OverlaySeekThumb}" />
                                    </controls:ReplaySeekTrack.Thumb>
                                    <controls:ReplaySeekTrack.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                                      Background="{DynamicResource OverlaySeekRemainingBrush}"
                                                      Style="{StaticResource OverlaySeekTrackButton}" />
                                    </controls:ReplaySeekTrack.IncreaseRepeatButton>
                                </controls:ReplaySeekTrack>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OverlayControlButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource StudioTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource StudioSurface2Brush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ButtonChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource StudioSurface3Brush}" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource StudioAccentPressedBrush}" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource StudioAccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource StudioDisabledBrush}" />
                                    <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource StudioDisabledBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OverlayLiveButton" TargetType="{x:Type Button}" BasedOn="{StaticResource OverlayControlButton}">
                <Setter Property="Width" Value="64" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CanReturnToLive}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource StudioAccentBrush}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsBehindLive}" Value="False" />
                            <Condition Binding="{Binding IsReplayMode}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Opacity" Value="1" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding Target.IsExplicitVod}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- A transparent child of the video HWND moves and clips with the stream itself. -->
    <Grid>
    <controls:VideoOverlayHost x:Name="OverlayHost" Focusable="False">
        <Border x:Name="OverlayChrome"
                Width="640"
                Background="{DynamicResource OverlaySeekBackgroundBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,6,12,10"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider x:Name="ReplaySeekSlider"
                        Grid.Row="0"
                        Style="{StaticResource OverlaySeekSlider}"
                        Minimum="0"
                        Maximum="{Binding ReplaySeekMaximum}"
                        Value="{Binding ReplaySeekSliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding CanSeekReplay}"
                        IsMoveToPointEnabled="True"
                        SmallChange="5"
                        LargeChange="30"
                        AutomationProperties.Name="Playback position"
                        AutomationProperties.HelpText="Use arrow keys to seek five seconds, or Page Up and Page Down to seek thirty seconds."
                        ToolTipService.IsEnabled="False" />
                <Grid x:Name="ReplayTransportGrid" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center">
                        <Viewbox.Style>
                            <Style TargetType="{x:Type Viewbox}">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Margin" Value="2,0,8,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout, ElementName=OverlayRoot}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Margin" Value="2,0,0,4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <TextBlock FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource StudioTextBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   ToolTip="{Binding ReplaySeekToolTip}">
                            <Run Text="{Binding ReplayElapsedText, Mode=OneWay}" />
                            <Run Text=" / " Foreground="{DynamicResource StudioTextMutedBrush}" />
                            <Run Text="{Binding ReplayDurationText, Mode=OneWay}" Foreground="{DynamicResource StudioTextSecondaryBrush}" />
                        </TextBlock>
                    </Viewbox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Grid.Column" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout, ElementName=OverlayRoot}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Width="40"
                                Content="−30s"
                                Style="{StaticResource OverlayControlButton}"
                                Command="{Binding RewindReplay30SecondsCommand}"
                                AutomationProperties.Name="Rewind 30 seconds"
                                ToolTip="Rewind 30 seconds" />
                        <Button Width="40"
                                Content="+30s"
                                Margin="4,0,0,0"
                                Style="{StaticResource OverlayControlButton}"
                                Command="{Binding FastForwardReplay30SecondsCommand}"
                                AutomationProperties.Name="Fast forward 30 seconds"
                                ToolTip="Fast forward 30 seconds" />
                        <Button x:Name="ReplayLiveButton"
                                Style="{StaticResource OverlayLiveButton}"
                                Command="{Binding ReturnToLiveCommand}"
                                AutomationProperties.Name="Return to live playback"
                                ToolTip="{Binding ReplayLiveStateText}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource StudioAccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBehindLive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource StudioTextMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Text" Value="LIVE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBehindLive}" Value="True">
                                                    <Setter Property="Text" Value="Go live" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CanReturnToLive}" Value="True">
                                                    <Setter Property="Text" Value="Go live" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </controls:VideoOverlayHost>
    <controls:VideoOverlayHost x:Name="SeekPreviewHost" Focusable="False">
        <Border x:Name="SeekPreviewChrome"
                Background="{DynamicResource OverlaySeekBackgroundBrush}"
                BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                MinWidth="64"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <StackPanel>
                <Border x:Name="SeekPreviewImageFrame" Visibility="Collapsed"
                        Background="Black" Margin="0,0,0,4">
                    <Image x:Name="SeekPreviewImage" Width="192" Height="108"
                           Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="SeekPreviewTimestamp"
                           Margin="6,2" HorizontalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource StudioTextBrush}" />
            </StackPanel>
        </Border>
    </controls:VideoOverlayHost>
    </Grid>
</UserControl>

<UserControl x:Class="StreamlinkVlcStudio.App.Wpf.Controls.VodDownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StreamlinkVlcStudio.App.Wpf.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <Border Background="{DynamicResource StudioSurface1Brush}" BorderBrush="{DynamicResource StudioBorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,20">
            <StackPanel>
                <ContentControl Content="Save a broadcast" Tag="{StaticResource StudioIconDownload}" Style="{StaticResource StudioSectionHeading}" />
                <TextBlock Text="Paste a Twitch or Kick video link. Completed broadcasts only."
                           Foreground="{DynamicResource StudioTextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
                <controls:ResponsiveDockPanel LastChildFill="True" SizeChanged="DownloadInputSizeChanged">
                    <Button x:Name="VodDownloadButton" DockPanel.Dock="Right" Content="Download VOD"
                            Style="{StaticResource StudioPrimaryButtonStyle}"
                            Command="{Binding DownloadVodUrlCommand}" Margin="12,0,0,0"
                            AutomationProperties.Name="Download Twitch or Kick VOD URL" />
                    <Grid>
                        <TextBox x:Name="VodDownloadUrlTextBox" Text="{Binding VodDownloadUrl, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="36" VerticalContentAlignment="Center"
                                 KeyDown="DownloadUrl_KeyDown"
                                 ToolTip="Twitch: https://www.twitch.tv/videos/id · Kick: https://kick.com/channel/videos/id"
                                 AutomationProperties.Name="Twitch or Kick VOD URL" AutomationProperties.HelpText="{Binding DownloadUrlError}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource StudioTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDownloadUrlError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource StudioDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="Paste a Twitch or Kick VOD URL" Margin="14,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StudioTextDimBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=VodDownloadUrlTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </controls:ResponsiveDockPanel>
                <TextBlock x:Name="DownloadUrlErrorText" Text="{Binding DownloadUrlError}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource StudioDangerBrush}" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding HasDownloadUrlError, Converter={StaticResource BoolToVisibility}}" />
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Download settings" Command="{Binding ShowDownloadsSettingsCommand}"
                            Style="{StaticResource StudioSubtleButtonStyle}" Margin="-12,0,0,0"
                            AutomationProperties.Name="Open VOD download settings" />
                    <Button Content="Open download folder"
                            Command="{Binding OpenDownloadFolderCommand}"
                            Style="{StaticResource StudioSubtleButtonStyle}"
                            ToolTip="{Binding DownloadDirectory}" Margin="8,0,0,0"
                            VerticalAlignment="Center" AutomationProperties.Name="Open VOD download folder" />
                </WrapPanel>
                <TextBlock Text="Video and audio are saved on disk; replay chat is not included. Downloads continue while you watch."
                           Foreground="{DynamicResource StudioTextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding DownloadDirectory}" Foreground="{DynamicResource StudioTextDimBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="DownloadsEmptyState" HorizontalAlignment="Center" MaxWidth="440" Margin="12,38,12,24">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasVodDownloads}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource StudioAccentPressedBrush}"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
                <Path Style="{StaticResource StudioLineIcon}" Data="{StaticResource StudioIconDownload}" Width="26" Height="26"
                      Stroke="{DynamicResource StudioAccentTextBrush}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="Your offline library starts here" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Save a completed broadcast above, or choose Download on a video in Past broadcasts."
                       Foreground="{DynamicResource StudioTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,18" />
            <Button Content="Browse past broadcasts" Command="{Binding ShowTwitchVodsHomePageCommand}"
                    Style="{StaticResource StudioSubtleButtonStyle}" HorizontalAlignment="Center" />
        </StackPanel>
        <ItemsControl x:Name="DownloadsItemsControl" ItemsSource="{Binding VodDownloads}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource StudioSurface1Brush}" BorderBrush="{DynamicResource StudioBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="38" Height="42" CornerRadius="10" Background="{DynamicResource StudioSurface2Brush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE896;" />
                                                <Setter Property="Foreground" Value="{DynamicResource StudioTextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanPlay}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" /><Setter Property="Foreground" Value="{DynamicResource StudioSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                        <Setter Property="Text" Value="&#xE72C;" /><Setter Property="Foreground" Value="{DynamicResource StudioWarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <controls:EmojiTextBlock SourceText="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ChannelText}" Foreground="{DynamicResource StudioTextMutedBrush}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource StudioTextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanPlay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StudioSuccessBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding CanRetry}" Value="True"><Setter Property="Foreground" Value="{DynamicResource StudioWarningBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsIndeterminate}" Margin="0,8,0,0"
                                         AutomationProperties.Name="VOD download progress" />
                            <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource StudioTextSecondaryBrush}"
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource StudioWarningBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Watch offline" Command="{Binding PlayCommand}" Margin="0,0,10,8"
                                        Style="{StaticResource StudioPrimaryButtonStyle}"
                                        Visibility="{Binding CanPlay, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Watch downloaded VOD offline" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,8"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Cancel VOD download" />
                                <Button Content="Retry" Command="{Binding RetryCommand}" Margin="0,0,10,8"
                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Retry VOD download" />
                                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,0,8" Style="{StaticResource StudioSubtleButtonStyle}"
                                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Delete this VOD and its downloaded media files from disk"
                                        AutomationProperties.Name="Delete downloaded VOD" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

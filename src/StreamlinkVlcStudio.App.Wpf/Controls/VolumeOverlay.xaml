<UserControl x:Class="StreamlinkVlcStudio.App.Wpf.Controls.VolumeOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/StudioTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--
                The palette lives in application resources and ThemeManager swaps that dictionary at
                runtime, so every palette reference has to be a DynamicResource. The pill is drawn
                from the palette (rather than a fixed dark chip) so its text stays legible on the
                light themes; brush-level opacity keeps the fill translucent without fading the text.
            -->
            <SolidColorBrush x:Key="VolumeOverlayFillBrush"
                             Color="{DynamicResource StudioSurface2Color}"
                             Opacity="0.95" />
            <SolidColorBrush x:Key="VolumeOverlayTickBrush"
                             Color="{DynamicResource StudioTextMutedColor}"
                             Opacity="0.7" />
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Transient volume OSD. A Popup (own top-level HWND) so it renders above the native
         libVLC video surface (an HwndHost) instead of being occluded by it. -->
    <Popup x:Name="Popup"
           Placement="Center"
           AllowsTransparency="True"
           Focusable="False"
           StaysOpen="True"
           PopupAnimation="Fade">
        <Border Background="{DynamicResource VolumeOverlayFillBrush}"
                BorderBrush="{DynamicResource StudioBorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="13,7"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Icon"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="{DynamicResource StudioTextBrush}"
                           VerticalAlignment="Center" />
                <Grid Width="160" Height="6" Margin="11,0,11,0" VerticalAlignment="Center">
                    <Border Background="{DynamicResource StudioBorderStrongBrush}" CornerRadius="3" />
                    <Border x:Name="Fill"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource StudioAccentBrush}"
                            CornerRadius="3" />
                    <!-- 100% reference tick (160 * 100 / 125 = 128) so 100%+ boost is visible -->
                    <Border Width="1"
                            HorizontalAlignment="Left"
                            Margin="128,0,0,0"
                            Background="{DynamicResource VolumeOverlayTickBrush}" />
                </Grid>
                <TextBlock x:Name="Percent"
                           MinWidth="40"
                           TextAlignment="Right"
                           FontSize="14"
                           Foreground="{DynamicResource StudioTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Popup>
</UserControl>

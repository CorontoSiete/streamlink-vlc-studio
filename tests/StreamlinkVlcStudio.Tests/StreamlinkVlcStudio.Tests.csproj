<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\StreamlinkVlcStudio.Core\StreamlinkVlcStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\StreamlinkVlcStudio.Infrastructure\StreamlinkVlcStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\StreamlinkVlcStudio.App.Wpf\StreamlinkVlcStudio.App.Wpf.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.10240.0</SupportedOSPlatformVersion>
    <!-- This direct override is intentional: the WPF toast dependency otherwise restores vulnerable 4.7.0. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The test command's no-build option sets VSTestNoBuild; avoid rebuilding the WPF project so that
         an explicit no-build run cannot race another build and corrupt generated BAML output. -->
    <DependencyFreeTestBuildTarget Condition="'$(VSTestNoBuild)' != 'true'">Build</DependencyFreeTestBuildTarget>
  </PropertyGroup>

  <Target Name="RunDependencyFreeTests" BeforeTargets="VSTest" DependsOnTargets="$(DependencyFreeTestBuildTarget)">
    <PropertyGroup>
      <!-- Reuse the host that launched MSBuild. Merely finding a repo-local host does not
           mean that host contains the target framework's runtime. -->
      <DependencyFreeTestDotNet Condition="'$(DotNetHostPath)' != ''">&quot;$(DotNetHostPath)&quot;</DependencyFreeTestDotNet>
      <DependencyFreeTestDotNet Condition="'$(DependencyFreeTestDotNet)' == ''">dotnet</DependencyFreeTestDotNet>
    </PropertyGroup>
    <Exec Command="$(DependencyFreeTestDotNet) &quot;$(TargetPath)&quot;" />
  </Target>

</Project>

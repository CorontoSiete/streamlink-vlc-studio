<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\StreamlinkVlcStudio.Core\StreamlinkVlcStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\StreamlinkVlcStudio.Infrastructure\StreamlinkVlcStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\StreamlinkVlcStudio.App.Wpf\StreamlinkVlcStudio.App.Wpf.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="RunDependencyFreeTests" BeforeTargets="VSTest" DependsOnTargets="Build">
    <PropertyGroup>
      <DependencyFreeTestDotNet>dotnet</DependencyFreeTestDotNet>
      <DependencyFreeTestDotNet Condition="Exists('$(MSBuildProjectDirectory)\..\..\.dotnet-sdk\dotnet.exe')">&quot;$(MSBuildProjectDirectory)\..\..\.dotnet-sdk\dotnet.exe&quot;</DependencyFreeTestDotNet>
    </PropertyGroup>
    <Exec Command="$(DependencyFreeTestDotNet) &quot;$(TargetPath)&quot;" />
  </Target>

</Project>

{
  "manifest_version": 3,
  "name": "Twitch & Kick player Capture",
  "version": "0.2.2",
  "description": "Opens clicked streams in Twitch & Kick player and auto-claims Twitch channel point bonuses.",
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://m.twitch.tv/*",
    "https://kick.com/*",
    "https://m.kick.com/*",
    "https://www.kick.com/*",
    "http://127.0.0.1:39179/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://m.twitch.tv/*",
        "https://kick.com/*",
        "https://m.kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "content-core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}

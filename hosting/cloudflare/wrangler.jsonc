{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stream-studio-accounts",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ratelimits": [
    {
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "39177",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
